<Application x:Class="UiEditor.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] 主题令牌占位：OnStartup 由 ThemeManager.Apply 换成 Claude.Light / Nvidia.Dark -->
                <ResourceDictionary/>
                <!-- [1] 图标几何（真实包，不随主题切换） -->
                <ResourceDictionary Source="pack://application:,,,/SystemToolkit.UI.Common;component/Themes/Icons.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
