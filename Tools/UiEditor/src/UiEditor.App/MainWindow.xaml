<Window x:Class="UiEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UI 编辑器 · M1" Width="1200" Height="760"
        Background="{DynamicResource Brush_Background}">
    <DockPanel>
        <!-- 顶栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource Brush_Surface}"
                BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel LastChildFill="False">
                <TextBlock Text="目标 View：" VerticalAlignment="Center" Foreground="{DynamicResource Brush_TextSecondary}"/>
                <ComboBox x:Name="TargetCombo" Width="260" VerticalAlignment="Center" Margin="6,0,0,0"
                          SelectionChanged="OnTargetChanged"/>
                <RadioButton x:Name="ThemeClaude" Content="Claude" GroupName="theme" IsChecked="True"
                             Margin="16,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush_TextPrimary}" Checked="OnThemeChanged"/>
                <RadioButton x:Name="ThemeNvidia" Content="Nvidia" GroupName="theme"
                             Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush_TextPrimary}" Checked="OnThemeChanged"/>
                <Button Content="重载" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Click="OnReload"/>
                <Button Content="预览 diff" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" Click="OnPreviewDiff"/>
                <Button Content="确认落盘" DockPanel.Dock="Right" Margin="8,0,0,0" Padding="10,4" FontWeight="SemiBold" Click="OnSave"/>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource Brush_TextMuted}" Text="就绪"/>
            </DockPanel>
        </Border>

        <!-- 底部 diff -->
        <Border DockPanel.Dock="Bottom" Height="150" Background="{DynamicResource Brush_DarkSurface}"
                BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,1,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <TextBlock x:Name="DiffText" FontFamily="Consolas,monospace" FontSize="12"
                           Foreground="{DynamicResource Brush_TextPrimary}" Margin="10" Text="(尚未预览改动)"/>
            </ScrollViewer>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="290"/>
            </Grid.ColumnDefinitions>

            <!-- 左：元素树 -->
            <Border Grid.Column="0" Background="{DynamicResource Brush_Surface}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="元素树（源行映射）" Margin="10,10,10,4" Foreground="{DynamicResource Brush_TextSecondary}"/>
                    <TreeView x:Name="ElementTree" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="OnTreeSelected"/>
                </DockPanel>
            </Border>

            <!-- 中：示意式布局预览 -->
            <Border Grid.Column="1" Background="{DynamicResource Brush_Background}" ClipToBounds="True">
                <AdornerDecorator>
                    <ContentControl x:Name="PreviewHost"/>
                </AdornerDecorator>
            </Border>

            <!-- 右：令牌约束检视器 -->
            <Border Grid.Column="2" Background="{DynamicResource Brush_Surface}" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="检视器" Margin="10,10,10,4" Foreground="{DynamicResource Brush_TextSecondary}"/>
                    <TextBlock x:Name="SelectedInfo" DockPanel.Dock="Top" Margin="10,0,10,10" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush_TextMuted}" Text="未选中元素"/>
                    <StackPanel DockPanel.Dock="Top" Margin="10,0" x:Name="InspectorPanel" IsEnabled="False">
                        <TextBlock Text="Grid.Row" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="RowCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                        <TextBlock Text="Grid.Column" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="ColumnCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                        <TextBlock Text="Margin（间距令牌）" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="MarginCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                        <TextBlock Text="FontSize（令牌）" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="FontSizeCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                        <TextBlock Text="Foreground（令牌）" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="ForegroundCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                        <TextBlock Text="Style（组件键）" Foreground="{DynamicResource Brush_TextSecondary}" FontSize="{DynamicResource Font_SizeCaption}"/>
                        <ComboBox x:Name="StyleCombo" Margin="0,2,0,10" SelectionChanged="OnEditChanged"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
