<UserControl x:Class="SystemToolkit.Modules.DriverManager.DriverManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:SystemToolkit.Modules.DriverManager"
    Background="{StaticResource Brush_Bg}">
    <UserControl.Resources>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 抽屉详情的键值对行：统一 4px 下间距（布局细节，不提升到全局主题） -->
        <Style x:Key="DrawerRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="驱动管理" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeCaption}" Foreground="{StaticResource Brush_TextMuted}" Margin="0,3,0,0">
                    <Run Text="DRIVER MANAGER · Driver Store "/><Run Text="{Binding Packages.Count, Mode=OneWay}"/><Run Text=" 个驱动包 · 旧版本按同 INF 分组标记"/>
                </TextBlock>
            </StackPanel>
        </Grid>

        <!-- ============ 筛选行 ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip}" Tag="all" Content="全部"
                             Command="{Binding SetFilterCommand}" CommandParameter="0" IsChecked="True" GroupName="DrvFilter"/>
                <RadioButton Style="{StaticResource FilterChip}" Tag="third" Content="第三方"
                             Command="{Binding SetFilterCommand}" CommandParameter="1" GroupName="DrvFilter"/>
                <RadioButton Style="{StaticResource FilterChip}" Tag="ms" Content="Microsoft"
                             Command="{Binding SetFilterCommand}" CommandParameter="2" GroupName="DrvFilter"/>
                <RadioButton Style="{StaticResource FilterChip}" Tag="old" Content="旧版本"
                             Command="{Binding SetFilterCommand}" CommandParameter="3" GroupName="DrvFilter"/>
                <RadioButton Style="{StaticResource FilterChip}" Tag="orphan" Content="无关联"
                             Command="{Binding SetFilterCommand}" CommandParameter="4" GroupName="DrvFilter"/>
            </StackPanel>
            <Border HorizontalAlignment="Right" Width="240" Height="30"
                    Background="{StaticResource Brush_Surface}"
                    BorderBrush="{StaticResource Brush_Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius_Chip}">
                <Grid>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="8,0" FontSize="{DynamicResource Font_SizeBodySm}"
                             Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="筛选 INF / 提供商 / 类别…"
                               Foreground="{StaticResource Brush_TextMuted}" FontSize="{DynamicResource Font_SizeCaption}"
                               Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 列表 + 操作栏 ============ -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <!-- M-UI-3（2026-09-06）：172 → 200，抽屉式面板需容纳包详情键值对 -->
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <Grid>
                    <ListView ItemsSource="{Binding PackagesView}"
                              BorderThickness="0" Background="Transparent"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItem="{Binding SelectedPackage, Mode=TwoWay}"
                              SizeChanged="OnListSizeChanged">
                        <ListView.Style>
                            <Style TargetType="ListView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Packages.Count}" Value="0">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListView">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                        <TextBlock Text="暂无驱动包 · 点击「刷新(R)」开始扫描" 
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{StaticResource Brush_TextMuted}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.Style>
                    <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListItemRowStyle}" TargetType="ListViewItem"/>
                        </ListView.ItemContainerStyle>
                    <ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander IsExpanded="False" Style="{StaticResource ThemedExpander}" Background="Transparent">
                                                    <Expander.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold"
                                                                       Foreground="{StaticResource Brush_TextPrimary}"/>
                                                            <TextBlock FontSize="{DynamicResource Font_SizeCaption}" Foreground="{StaticResource Brush_TextMuted}" Margin="8,0,0,0">
                                                                <Run Text="{Binding ItemCount, Mode=OneWay}"/><Run Text=" 个驱动包"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <ItemsPresenter/>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListView.GroupStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource ListHeaderStyle}">
                            <GridViewColumn Width="36">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanSelect}"
                                                  ToolTip="{Binding SelectDisabledToolTip}"
                                                  ToolTipService.ShowOnDisabled="True"
                                                  Style="{StaticResource ThemedCheckBox}"
                                                  VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!-- M-UI-3（2026-09-05）：8 列 → 6 列
                                 ①「INF」+「驱动类别」+「签名」合并为「驱动包 / 类别」双行单元格（主行 INF，副行 类别·签名）
                                 ②「设备名称」列本身已含状态徽章，改名「设备 / 状态」使表头与内容对齐 -->
                            <GridViewColumn Header="驱动包 / 类别" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel ToolTip="{Binding InfName}">
                                            <TextBlock Text="{Binding InfName}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       FontWeight="Bold" FontFamily="{StaticResource Font_Mono}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <!-- 🔴 Run.Text 的 FrameworkPropertyMetadata 默认 BindsTwoWayByDefault=true，
                                                 而 ClassName / SignerText 是只读派生属性（仅 getter）→ 必须显式 Mode=OneWay，
                                                 否则 TwoWay 绑定在模板求值时抛 InvalidOperationException（M-UI-3 上线即闪退事故） -->
                                            <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,1,0,0">
                                                <Run Text="{Binding ClassName, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding SignerText, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="提供商" Width="95">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Provider}" FontSize="{DynamicResource Font_SizeCaption}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="版本" Width="90">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Version}" FontSize="{DynamicResource Font_SizeMono}"
                                                   FontFamily="{StaticResource Font_Mono}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="日期" Width="72">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DateText}" FontSize="{DynamicResource Font_SizeCaption}" Width="68"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="设备 / 状态" Width="200">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding DeviceNamesText}">
                                            <Border Margin="0,0,6,0" Visibility="{Binding IsStateBadgeVisible}" Style="{StaticResource StateBadgeBorder}">
                                                <TextBlock Text="{Binding StateText}" Style="{StaticResource StateBadgeText}"/>
                                            </Border>
                                            <TextBlock Text="{Binding DeviceNamesText}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                    
                <!-- 扫描中遮罩 -->
                <Border Background="{StaticResource Brush_SurfaceAlt}" Opacity="0.7"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="200" Height="4"/>
                        <TextBlock Text="正在扫描 Driver Store..." Margin="0,8,0,0" 
                                   Foreground="{StaticResource Brush_TextSecondary}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

            <!-- ============ M-UI-3（2026-09-05）：右侧操作栏 → 抽屉式（双态） ============
                 态 A（SelectedPackage == null）：全局操作——刷新 / 添加 / 安装 / 备份向导 / 恢复向导
                 态 B（SelectedPackage != null）：该包详情（键值对）+ 包级操作
                 🔴 两套状态正交：点行 = 选中看详情（SelectedPackage）；勾 CheckBox = 加入操作集（IsSelected） -->
            <Border Grid.Column="1" Margin="12,0,0,0" Background="{StaticResource Brush_Surface}"
                    BorderBrush="{StaticResource Brush_Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius_CardSm}"
                    Padding="10" VerticalAlignment="Stretch">
                <Grid>
                    <!-- ===== 态 A：未选中 → 全局操作 ===== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="操作" FontSize="{DynamicResource Font_SizeCaption}" Foreground="{StaticResource Brush_TextMuted}"/>
                        <Button Style="{StaticResource CompactActionButton}" Content="刷新(R)"
                                Command="{Binding ScanCommand}" ToolTip="重新枚举 Driver Store"/>
                        <Button Style="{StaticResource CompactActionButton}" Content="添加驱动(A)…"
                                Command="{Binding AddDriversCommand}" CommandParameter="add"
                                ToolTip="pnputil /add-driver：选目录递归找 *.inf 加入 Driver Store（经提权通道）"/>
                        <Button Style="{StaticResource CompactActionButton}" Content="安装驱动(I)"
                                Command="{Binding AddDriversCommand}" CommandParameter="install"
                                ToolTip="pnputil /add-driver /install：加入 Driver Store 并安装到匹配设备（经提权通道）"/>
                        <Button Style="{StaticResource CompactActionButton}" Content="备份向导…"
                                Command="{Binding RunBackupCommand}" ToolTip="pnputil /export-driver + manifest/devices/checksum"/>
                        <Button Style="{StaticResource CompactActionButton}" Content="恢复向导…" IsEnabled="False"
                                ToolTip="V0.3-C：HardwareId + 机器指纹匹配恢复"/>
                        <TextBlock Text="提示：点击任意行可查看该驱动包详情"
                                   FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <!-- ===== 态 B：已选中 → 包详情 + 包级操作 ===== -->
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{Binding SelectedPackage.InfName}" FontSize="{DynamicResource Font_SizeBody}"
                                   FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"
                                   FontFamily="{StaticResource Font_Mono}" TextTrimming="CharacterEllipsis"
                                   ToolTip="{Binding SelectedPackage.InfName}"/>
                        <TextBlock Text="{Binding SelectedPackage.ClassName}" FontSize="{DynamicResource Font_SizeMicro}"
                                   Foreground="{StaticResource Brush_TextMuted}"/>

                        <!-- 详情键值对 -->
                        <Grid Style="{StaticResource DrawerRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="提供商" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPackage.Provider}" FontSize="{DynamicResource Font_SizeMicro}"
                                       Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedPackage.Provider}"/>
                        </Grid>
                        <Grid Style="{StaticResource DrawerRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="版本" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPackage.Version}" FontSize="{DynamicResource Font_SizeMicro}"
                                       FontFamily="{StaticResource Font_Mono}" Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedPackage.Version}"/>
                        </Grid>
                        <Grid Style="{StaticResource DrawerRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="日期" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPackage.DateText}" FontSize="{DynamicResource Font_SizeMicro}"
                                       FontFamily="{StaticResource Font_Mono}" Foreground="{StaticResource Brush_TextPrimary}"/>
                        </Grid>
                        <Grid Style="{StaticResource DrawerRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="签名" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"/>
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPackage.SignerText}" FontSize="{DynamicResource Font_SizeMicro}"
                                       Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding SelectedPackage.SignerText}"/>
                        </Grid>
                        <Grid Style="{StaticResource DrawerRow}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="52"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="状态" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"/>
                            <!-- 🔴 不复用 DriverStateText 样式：该样式的 DataTrigger 绑的是裸 StateKey，
                                 在抽屉里 DataContext 是页级 VM（无此属性）→ 状态色永远不生效。
                                 此处显式绑 SelectedPackage.StateKey。 -->
                            <TextBlock Grid.Column="1" Text="{Binding SelectedPackage.StateText}" FontSize="{DynamicResource Font_SizeMicro}"
                                       Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <!-- StateKey：1=旧版本(琥珀) 2=系统关键 3=无关联（后两者沿用中性色） -->
                                            <DataTrigger Binding="{Binding SelectedPackage.StateKey}" Value="1">
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Warning}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <TextBlock Text="{Binding SelectedPackage.DeviceNamesText}" FontSize="{DynamicResource Font_SizeMicro}"
                                   Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis"
                                   TextWrapping="Wrap" MaxHeight="34"
                                   ToolTip="{Binding SelectedPackage.DeviceNamesText}"/>

                        <!-- 包级操作：仅保留单包备份（批量删除已移至底部状态栏） -->
                        <Button Style="{StaticResource CompactActionButton}" Content="备份向导…"
                                Command="{Binding RunBackupCommand}" ToolTip="pnputil /export-driver + manifest/devices/checksum"/>
                        <TextBlock Text="点其他行切换详情；勾选 CheckBox 后可在底部状态栏批量删除"
                                   FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 底部状态栏（M-UI-3：SelectedCount==0 时整条折叠，与 AppManager M-UI-2 同款） ============ -->
        <Border Grid.Row="4" Margin="0,12,0,10" Background="{StaticResource Brush_DarkSurface}"
                CornerRadius="{DynamicResource Radius_CardSm}" Padding="14,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- 未勾选任何包时底栏无信息可呈，折叠让位给列表 -->
                        <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="{DynamicResource Font_SizeBody}" Foreground="{StaticResource Brush_OnDark}" VerticalAlignment="Center">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 项"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="{DynamicResource Font_SizeCaption}"
                           Foreground="{StaticResource Brush_OnDarkMuted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource CompactActionButton}" Content="清空选择" Height="24" Command="{Binding ClearSelectionCommand}"/>
                    <Separator Width="1" Background="{StaticResource Brush_Border}" Margin="8,0" Opacity="0.3"/>
                    <Button Content="删除驱动" Command="{Binding DeleteSelectedCommand}"
                            Style="{StaticResource RowDangerButton}" Height="24" MinWidth="64" Padding="10,0" Margin="0,0,6,0"/>
                    <Button Content="强制删除" Command="{Binding ForceDeleteSelectedCommand}"
                            Style="{StaticResource RowDangerButton}" Height="24" MinWidth="64" Padding="10,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
