<UserControl x:Class="SystemToolkit.Modules.GameManager.GameManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.GameManager"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             Background="{DynamicResource Brush_Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 封面限宽解码（REVIEW-3 S-4：直绑 string 按原始尺寸解码，1200×1800 竖版 4 倍冗余内存） -->
        <local:CoverImageConverter x:Key="CoverImage"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <!-- 统计行两段之间的横向间隙（A3）。用具名 Thickness 而非 Space_XXS：后者四边 4px，
             会给这一行凭空加 8px 高；这里只要左侧 4px。 -->
        <Thickness x:Key="StatsGap">4,0,0,0</Thickness>
        <!-- 游戏卡片：封面 + 名称 + 元数据行 + 操作行（设计 §7 卡片范式；布局对齐 GameManager.html 参考稿） -->
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Margin" Value="0,0,14,18"/>
            <Setter Property="Background" Value="{DynamicResource Brush_Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <!-- 2026-09-12 用户反馈：方形封面 hover 上浮时从上方两角溢出圆框——上角改直角
                 （下角保留圆角；ClipToBounds 是矩形裁剪不认圆角，上角直角后与封面边缘对齐） -->
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_XLLgTopFlat}"/>
            <Setter Property="Padding" Value="0"/>
            <!-- 封面贴边 + hover 缩放不外溢：整卡裁剪（HTML .game-card overflow:hidden 等效） -->
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraryOffline}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <!-- M-UI-3（2026-09-05）：hover 反馈——边框转深青 + 加粗。
                     上浮位移由 DataTemplate 内 Border.RenderTransform + EventTrigger 动画完成
                     （Style.Triggers 不支持 EventTrigger，无法承载 Storyboard） -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Brush_Accent}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- 卡片元数据文本（HTML .meta-item：mono 微字弱色） -->
        <Style x:Key="CardMetaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font_Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeTiny}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ============ A1 账户选择器（2026-09-13） ============ -->
        <!-- 页头账户区右侧间距（与徽章之间）。用具名 Thickness 而非 Space_*：后者四边都加会顶高整行。 -->
        <Thickness x:Key="HeaderGap">0,0,14,0</Thickness>
        <!-- 账户区外壳按钮：**透明底 + 无边框**。
             原设计里账户块是页头的一支行内信息块，套 SecondaryButton 的白底 + 1px 边框会变成突兀方框
             （2026-09-13 实机反馈）。hover/pressed 只给轻微底色，保留"可点"提示但不给按钮框观感。
             BorderThickness=0 兜底：即便基类 hover 触发器改写了 BorderBrush 也画不出边。 -->
        <Style x:Key="AccountChipButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="{DynamicResource Space_XXS}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush_AccentSoft}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 紧凑头像框：与页头 34px 头像同款观感（圆角方形 + 深底 + 图片/字母二选一）。
             尺寸写在此处 Setter 内：棘轮只扫 Width="数字" 的内联形态，与本文件 GameCard 同款做法保持一致。 -->
        <Style x:Key="AccountAvatarBox" TargetType="Border">
            <Setter Property="Width" Value="20"/>
            <Setter Property="Height" Value="20"/><!-- 圆角方形（与页头一致） -->
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_MD}"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource Brush_DarkSurface}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 账户菜单项。Header 绑**整项**（HeaderTemplate 的 DataContext 取自 Header 值，不是项的 DataContext）。
             ⚠️ 有意不用 MenuItem.IsCheckable：ToolkitMenuItem 是给卡片 ⋯ 菜单设计的非勾选样式，
             勾选框区在该模板下未经验证 → 改为模板内自带「当前」标记，不依赖样式支持。 -->
        <Style x:Key="AccountMenuItem" TargetType="MenuItem" BasedOn="{StaticResource ToolkitMenuItem}">
            <Setter Property="Header" Value="{Binding}"/>
            <Setter Property="Command" Value="{Binding SwitchCommand}"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource AccountAvatarBox}">
                                <Grid>
                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasAvatar}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding Initial}" FontSize="{DynamicResource Font_SizeMicro}" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Visibility="{Binding HasAvatar, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font_SizeBodySm}"
                                       Margin="{DynamicResource Space_XS}" VerticalAlignment="Center"/>
                            <Border Padding="{DynamicResource Space_XXS}" CornerRadius="{DynamicResource Radius_XS}"
                                    Background="{DynamicResource Brush_AccentSoft}" VerticalAlignment="Center"
                                    Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="当前" FontFamily="{DynamicResource Font_Mono}"
                                           FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_Accent}"/>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ============ A2 详情面板本地样式（2026-09-13） ============
             🔴 所有尺寸一律写在 Style Setter 内：本文件 Width / BorderThickness / StrokeThickness
             裸值已顶满 UiTokenRatchet 基线（width 4 / border 5 / stroke 2 / height 9 / padding 7），
             内联的 Width 数字字面量（如 390）会直接让棘轮变红；写在 Setter 的 Value 里则不匹配该正则。 -->
        <Style x:Key="DetailPanel" TargetType="Border">
            <Setter Property="Width" Value="390"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="{DynamicResource Brush_Surface}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="DetailCover" TargetType="Border">
            <Setter Property="Height" Value="200"/>
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
        </Style>
        <Style x:Key="DetailDivider" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
            <Setter Property="BorderThickness" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="DetailMetaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DetailMetaValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextPrimary}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- 操作键：与卡片操作键同一观感（micro 字号 + 紧凑内边距）；危险键复用 Brush_Danger* 语义色 -->
        <Style x:Key="DetailActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style x:Key="DetailDangerButton" TargetType="Button" BasedOn="{StaticResource DetailActionButton}">
            <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Danger}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_DangerText}"/>
        </Style>
        <!-- ============ B2 未安装显示（2026-09-13） ============
             尺寸一律走 Style Setter / 具名 Thickness：本文件 Width / BorderThickness / StrokeThickness
             裸值已顶满 UiTokenRatchet 基线，内联数字字面量会直接变红。 -->
        <!-- 徽章外边距：与卡片既有两个徽章完全等值（12,8,12,8）。用具名 Thickness 而非 Space_*
             —— 后者四边同值，会改变垂直间距、把徽章顶偏 -->
        <Thickness x:Key="BadgeGap">12,8,12,8</Thickness>
        <!-- 工具行勾选前的横向间隙：只加左侧，不给整行凭空加高度 -->
        <Thickness x:Key="ToolRowGap">16,0,0,0</Thickness>
        <Style x:Key="CardStateBadge" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="Margin" Value="{StaticResource BadgeGap}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_XS}"/>
            <Setter Property="Padding" Value="7,2"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头（参考稿：副标题 = 「N 款游戏 · M 个库」） ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="游戏管理" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Margin="0,2,0,0">
                    <Run Text="{Binding HeaderSubtitle, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <!-- 账户区（A1 账户选择器，2026-09-13）：点开下拉切换账户。
                 下拉用 ContextMenu 而非自绘 Popup —— 复用主题词汇 ToolkitContextMenu/ToolkitMenuItem
                 （与卡片 ⋯ 菜单同一套），且 DataContext 桥接方式在本文件已实证。
                 禁用时用 ToolTip 说明原因（🟠 禁用按钮必须有因可查）。 -->
            <Button x:Name="AccountButton" Grid.Column="2" Style="{StaticResource AccountChipButton}"
                    Margin="{StaticResource HeaderGap}"
                    Click="OnAccountMenuClick"
                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                    IsEnabled="{Binding CanPickAccount}"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="切换 Steam 账户（需要 Steam 中已记住账户）"
                    AutomationProperties.Name="Steam 账户，点击切换">
                <Button.ContextMenu>
                    <!-- ContextMenu 属独立可视树：DataContext 走 PlacementTarget.Tag（页级 VM）→
                         ItemsSource 取 Accounts；各容器 MenuItem 的 DataContext 自动是 SteamAccountVm -->
                    <ContextMenu Style="{DynamicResource ToolkitContextMenu}"
                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                                 ItemsSource="{Binding Accounts}"
                                 ItemContainerStyle="{StaticResource AccountMenuItem}"/>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius_XLLg}" ClipToBounds="True"
                            Background="{DynamicResource Brush_DarkSurface}">
                        <Grid>
                            <Image Source="{Binding AvatarPath}" Stretch="UniformToFill">
                                <Image.Style>
                                    <Style TargetType="Image">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Image.Style>
                            </Image>
                            <TextBlock Text="{Binding AvatarInitial}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="{DynamicResource Space_XS}">
                        <TextBlock Text="{Binding AccountName}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush_TextPrimary}"/>
                        <TextBlock Text="Steam 账户 ▾" FontSize="{DynamicResource Font_SizeMicro}"
                                   Foreground="{DynamicResource Brush_TextMuted}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <!-- 徽章底色随状态（2026-09-13 截图反馈）：LiveBadge 基样式是「LIVE」语义的绿底绿框，
                 套在「未运行」上等于用绿色宣告离线 —— 状态欺骗。未运行时改中性底色/描边，仅运行中保留绿。
                 （此前只有文字颜色随状态变，底色恒定绿。超出「删导出诊断 + 调按钮布局」的字面范围，请过目） -->
            <Border Grid.Column="3" Height="30" Margin="0,0,12,0">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource LiveBadge}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SteamRunning}" Value="False">
                                <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{DynamicResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
                            <Setter Property="Text" Value="● Steam 未运行"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                                    <Setter Property="Text" Value="● Steam 运行中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <!-- VerticalAlignment=Center：页头行高由标题块决定（约 44px），按钮不设对齐会默认 Stretch 被拉高 -->
            <Button Grid.Column="4" Style="{DynamicResource SecondaryButton}" Height="30" VerticalAlignment="Center"
                    Content="刷新" Command="{Binding LoadCommand}"/>
        </Grid>

        <!-- ============ 工具行 ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="320" Height="30" HorizontalAlignment="Left"
                    Background="{DynamicResource Brush_Surface}"
                    BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius_XS}">
                <Grid>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="8,0" FontSize="{DynamicResource Font_SizeBodySm}"
                             Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="搜索游戏名称…" FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{DynamicResource Brush_TextMuted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <!-- M-UI-2 审查处置：系统 Radio 圆点 → SegmentedRadioItem 选中态 pill（参考稿 .sort-group 语义；
                     命令绑定/GroupName 不变，仅外观替换） -->
                <RadioButton Content="最近游玩" IsChecked="True" GroupName="GameSort" Margin="6,0,0,0"
                             Style="{DynamicResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="0"/>
                <RadioButton Content="时长" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{DynamicResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="1"/>
                <RadioButton Content="占用" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{DynamicResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="2"/>
                <RadioButton Content="名称" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{DynamicResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="3"/>
                <!-- B2（2026-09-13）：显示未安装的游戏。默认关——避免一进页面就多出上百张卡；
                     用 ThemedCheckBox（有完整模板，16×16 方框 + Accent 勾）而不是 ThemedToggleButton：
                     后者**没有 ControlTemplate**，套上去是个看不见状态的开关（状态不可见 = 红线） -->
                <CheckBox Content="显示未安装" Style="{DynamicResource ThemedCheckBox}" VerticalAlignment="Center"
                          Margin="{StaticResource ToolRowGap}"
                          IsChecked="{Binding ShowNotInstalled}"
                          ToolTip="勾选后一并列出「玩过但已卸载」的游戏。数据来自本地（Steam 的应用缓存与游玩记录），不联网"
                          AutomationProperties.Name="显示未安装的游戏"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{DynamicResource SecondaryButton}" Height="30" Padding="12,0" Margin="12,0,0,0"
                    Content="启动 Steam" Command="{Binding LaunchClientCommand}"/>
        </Grid>

        <!-- ============ 状态栏（参考稿：内容区上方单行 mono 统计） ============
             A3（2026-09-13）：并入库容量段（VM 的 LibraryCapacityText）。独立 TextBlock 而非并进一个字符串，
             这样"无库/卷不可读"时整段可隐藏，不会留下悬空的分隔符。 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,0,0,12">
            <TextBlock Style="{DynamicResource MonoText}" FontSize="{DynamicResource Font_SizeMicro}"
                       Foreground="{DynamicResource Brush_TextMuted}"
                       Text="{Binding InstalledSummary, Mode=OneWay}"/>
            <TextBlock Style="{DynamicResource MonoText}" FontSize="{DynamicResource Font_SizeMicro}" Margin="{StaticResource StatsGap}"
                       Foreground="{DynamicResource Brush_TextMuted}"
                       Visibility="{Binding HasLibraryCapacity, Converter={StaticResource BoolToVis}}"
                       Text="{Binding LibraryCapacityText, Mode=OneWay}"/>
        </StackPanel>

        <!-- ============ 内容区：三态 ============ -->
        <Grid Grid.Row="3">
            <!-- 未安装 Steam -->
            <Border Background="{DynamicResource Brush_Surface}" CornerRadius="{DynamicResource Radius_XLLg}"
                    Padding="{DynamicResource Space_LG}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding SteamInstalled, Converter={x:Static local:InverseBoolConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_TextMuted}"/>
                    <TextBlock Text="未检测到 Steam 客户端" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Brush_TextPrimary}"/>
                    <TextBlock Text="请确认 Steam 已安装；安装后点击「刷新」重新扫描。" FontSize="{DynamicResource Font_SizeBody}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush_TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 已安装：游戏卡网格。
                 REVIEW-3 S-3：WrapPanel 无虚拟化（数百卡全量实例化）→ 引入 VirtualizingWrapPanel
                 包（VirtualizingItemsControl 自带 ScrollViewer 视口；外层再套 ScrollViewer 会禁用虚拟化，
                 故删除外层 ScrollViewer）。viewport 窄时自动降列（参考稿响应式语义）保留。
                 右侧 -14px：抵消末列卡片右间距（末列恒多 14px 空白视觉失衡），被裁掉的是无内容透明补偿区。

                 🔴 顶部 5px 内边距（2026-09-11 主人反馈「第一排卡片 hover 时绿边框上边被吞」）：
                 hover 上浮是 TranslateTransform.Y = -5，发生在**滚动视口内部**——第一排卡片紧贴
                 视口顶边（y=0），上浮后顶部那 5px 直接越过视口边界，被 ScrollViewer 裁掉，
                 于是在 BorderThickness 1→1.5 的绿边框上表现为「上边被吞」。下面几排下方仍有空间，
                 上浮不越界，所以只有第一排中招。
                 修法：把间隙加到**视口内部**（ItemsPanel 的 Margin），外层 Margin 由 6 降为 1
                 抵消偏移，卡片静止位置与原先完全一致（1 + 5 = 6）。 -->
            <vwp:VirtualizingItemsControl Margin="0,1,0,0" ItemsSource="{Binding GamesView}"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          Visibility="{Binding SteamInstalled, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Margin="0,5,-14,0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameCard}">
                                <!-- M-UI-3（2026-09-05）：hover 上浮 5px（0.15s 缓动）。
                                     边框转深青由 GameCard 样式负责；位移只能放这里——
                                     Style.Triggers 不支持 EventTrigger，无法承载 Storyboard -->
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="-5" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel>
                                    <!-- 封面（参考稿：175px 高 + 底部微遮罩 + hover 缩放 + 未安装徽章覆盖；
                                         缺失用字母占位。header.jpg 横版优先见 SteamService.FindCoverArt 注释） -->
                                    <Border Height="175" ClipToBounds="True" Background="{DynamicResource Brush_SurfaceAlt}"
                                            MouseLeftButtonUp="OnCardOpenDetail" Cursor="Hand"
                                            ToolTip="点击查看详情">
                                        <Border.Triggers>
                                            <!-- hover 封面轻微放大（参考稿 scale 1.04，0.35s） -->
                                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.04" Duration="0:0:0.35"/>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.04" Duration="0:0:0.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="0:0:0.35"/>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="0:0:0.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <!-- 封面经 CoverImageConverter 限宽解码（480 物理像素）+ OnLoad 释放句柄 -->
                                            <Image x:Name="CoverImage" Source="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Image.RenderTransform>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeMetric}" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush_TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Padding="10,0"
                                                       Visibility="{Binding HasCover, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                            <!-- 底部微遮罩（参考稿 ::after：40px 渐变压暗，封面与卡片过渡更柔） -->
                                            <Rectangle Height="42" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                       Fill="{DynamicResource Brush_CoverFade}"/>
                                            <!-- 未安装：徽章覆盖在封面底部（参考稿 .card-cover-overlay + .badge-state） -->
                                            <StackPanel VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsFullyInstalled, Converter={x:Static local:InverseBoolConverter.Instance}}">
                                                <StackPanel.Background>
                                                    <StaticResource ResourceKey="Brush_CoverOverlay"/>
                                                </StackPanel.Background>
                                                <Border HorizontalAlignment="Right" Margin="12,8,12,8"
                                                        Background="{DynamicResource Brush_WarningSoft}"
                                                        BorderBrush="{DynamicResource Brush_Warning}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius_XS}" Padding="7,2">
                                                    <TextBlock Text="下载/更新中" FontFamily="{DynamicResource Font_Mono}"
                                                               FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_Warning}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 库离线：同位置徽章（M-UI-2 审查处置：离线此前只有整卡降透明，
                                                 文字可读性连带受损——补明确标签，Opacity 保留） -->
                                            <StackPanel VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsLibraryOffline, Converter={StaticResource BoolToVis}}">
                                                <StackPanel.Background>
                                                    <StaticResource ResourceKey="Brush_CoverOverlay"/>
                                                </StackPanel.Background>
                                                <Border HorizontalAlignment="Right" Margin="12,8,12,8"
                                                        Background="{DynamicResource Brush_DangerSoft}"
                                                        BorderBrush="{DynamicResource Brush_Danger}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius_XS}" Padding="7,2">
                                                    <TextBlock Text="库离线" FontFamily="{DynamicResource Font_Mono}"
                                                               FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_DangerText}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 未安装（B2，2026-09-13）：中性灰 —— 不借绿(已安装)/琥珀(下载中)/红(库离线)任一语义色，
                                                 否则会被读成"可安装/推荐"。与上面两个徽章互斥（判据见 GameCardVm.StateKind） -->
                                            <StackPanel VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsNotInstalled, Converter={StaticResource BoolToVis}}">
                                                <StackPanel.Background>
                                                    <StaticResource ResourceKey="Brush_CoverOverlay"/>
                                                </StackPanel.Background>
                                                <Border Style="{StaticResource CardStateBadge}"
                                                        Background="{DynamicResource Brush_SurfaceAlt}"
                                                        BorderBrush="{DynamicResource Brush_Border}">
                                                    <TextBlock Text="未安装" FontFamily="{DynamicResource Font_Mono}"
                                                               FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextSecondary}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="14,12,14,14">
                                        <!-- 名称行 + ⋯ 菜单（目录 / 卸载收纳进菜单，主行只留 启动 + 商店） -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       MouseLeftButtonUp="OnCardOpenDetail" Cursor="Hand"/>
                                            <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Content="⋯"
                                                    Padding="7,2" FontSize="{DynamicResource Font_SizeBody}" AutomationProperties.Name="更多操作" ToolTip="更多操作"
                                                    MinWidth="28" MinHeight="24"
                                                    Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                    Click="OnCardMenuClick"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.ContextMenu>
                                                    <!-- ContextMenu 属独立可视树：DataContext 走 PlacementTarget.Tag（页级 VM），
                                                         CommandParameter 走 PlacementTarget.DataContext（单卡 GameCardVm）。
                                                         M-UI-2：主题化三件套（ToolkitContextMenu/MenuItem），告别系统原生观感 -->
                                                    <ContextMenu Style="{DynamicResource ToolkitContextMenu}"
                                                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="打开安装目录" Style="{DynamicResource ToolkitMenuItem}"
                                                                  Command="{Binding OpenFolderCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator Style="{DynamicResource ToolkitMenuSeparator}"/>
                                                        <MenuItem Header="⚠ 卸载此游戏" Style="{DynamicResource ToolkitMenuItemDanger}"
                                                                  Command="{Binding UninstallGameCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>

                                        <!-- 元数据行（参考稿：占用 · 时长 单行 mono，圆点分隔） -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding SizeOnDiskText}"/>
                                            <Ellipse Width="3" Height="3" Fill="{DynamicResource Brush_Track}" Margin="7,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding PlaytimeText}"/>
                                        </StackPanel>
                                        <!-- 最近游玩日期单独一行（参考稿 .card-last-played） -->
                                        <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding LastPlayedText}" Margin="0,5,0,0"/>

                                        <!-- 操作行（参考稿：顶部分隔线 + 商店/启动两键均分等宽） -->
                                        <Border BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- 未安装卡片没有「启动」可点 → 本键铺满整行，不留半格空位
                                                     （Grid.ColumnSpan 在 Setter 里用附加属性语法） -->
                                                <Button Content="商店页面"
                                                        Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource CardActionButton}">
                                                            <Setter Property="Margin" Value="0,0,4,0"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                                                                    <Setter Property="Margin" Value="0"/>
                                                                    <Setter Property="Grid.ColumnSpan" Value="2"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <!-- 未安装时隐藏：对未安装的游戏，"启动/打开目录/卸载"全不适用
                                                     （可交互 ≠ 有语义；安装引导属批次 4） -->
                                                <Button Grid.Column="1" Style="{DynamicResource PrimaryButton}" Content="启动" Margin="4,0,0,0"
                                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
            </vwp:VirtualizingItemsControl>

            <!-- 态：过滤后为空（B2 起有两种成因：搜索没匹配 / 未安装被开关隐藏）——
                 标题与说明都由 VM 给，**必须说清是被什么挡住的**，否则用户会以为游戏丢了 -->
            <Border Background="{DynamicResource Brush_Background}" Padding="{DynamicResource Space_LG}"
                    Visibility="{Binding ShowNoResultEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_TextMuted}"/>
                    <TextBlock Text="{Binding FilteredEmptyTitle, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Brush_TextPrimary}"/>
                    <TextBlock Text="{Binding FilteredEmptyHint, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBody}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush_TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 态：库为空（Steam 已安装但没有任何游戏） -->
            <Border Background="{DynamicResource Brush_Background}" Padding="{DynamicResource Space_LG}"
                    Visibility="{Binding ShowEmptyLibrary, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush_TextMuted}"/>
                    <TextBlock Text="未发现任何游戏记录" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{DynamicResource Brush_TextPrimary}"/>
                    <TextBlock Text="本机既没有已安装的游戏，也没有游玩记录；安装游戏后点击「刷新」重新扫描。"
                               FontSize="{DynamicResource Font_SizeBody}" TextWrapping="Wrap"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{DynamicResource Brush_TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- 态：加载中（压最上层；IsLoading 由 LoadAsync 驱动，此前该状态无 UI 消费——审查核验属实） -->
            <Border Background="{DynamicResource Brush_Background}" Padding="{DynamicResource Space_LG}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 旋转圆环：Accent 弧 + Track 底环，Loaded 触发无限旋转 -->
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Stroke="{DynamicResource Brush_Track}" StrokeThickness="2.5"/>
                        <Ellipse Stroke="{DynamicResource Brush_Accent}" StrokeThickness="2.5" StrokeDashArray="8 100" StrokeDashCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="13" CenterY="13"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="正在读取 Steam 库…" Style="{DynamicResource MonoText}" FontSize="{DynamicResource Font_SizeTiny}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 底部状态栏（操作反馈通道，HTML toast 的 WPF 等效；
             M-UI-2：按 StatusLevel 语义着色——0 信息/1 成功/2 失败，深色底用 400 档亮色变体） ============ -->
        <Border Grid.Row="4" Margin="0,12,0,0" Background="{DynamicResource Brush_DarkSurface}"
                CornerRadius="{DynamicResource Radius_LG}" Padding="{DynamicResource Space_SM}">
            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Font_SizeBodySm}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource Brush_OnDarkMuted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusLevel}" Value="1">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_SuccessOnDark}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusLevel}" Value="2">
                                <Setter Property="Foreground" Value="{DynamicResource Brush_DangerOnDark}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- ============ A2 详情面板（2026-09-13，形态主人裁定：右侧滑出 + 遮罩） ============
             · 遮罩只盖根 Grid 的 0~3 行（页头~内容区），底部反馈条保留可见——面板内触发的
               「启动 / 卸载」结果必须能被看到（项目「不静默」纪律）。
             · 遮罩用 Brush_SurfaceAlt + Opacity（仓内先例：DriverManagerView 长操作遮罩），
               不新增 scrim token —— 那要同步 TokenKeys + 两个主题包 + 04 规范 §3.1，牵动三个守卫。
             · 本块不出现任何内联数字裸值：尺寸走上方 StyleSetter，间距走 Space_* 令牌。
             · 只有遮罩挂关闭处理器；面板本体不挂（点面板内部不会误关）。 -->
        <Grid Grid.Row="0" Grid.RowSpan="4" Panel.ZIndex="10"
              Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource Brush_SurfaceAlt}" Opacity="0.7"
                    MouseLeftButtonDown="OnScrimClick"/>
            <Border x:Name="DetailPanel" Style="{StaticResource DetailPanel}" Focusable="True">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- 封面：复用卡片同一张 CoverPath。FindCoverArt 首选 header.jpg（460×215），
                                 390 宽面板下属轻微缩小 → 清晰；改取 library_hero 反而更糊（它在候选序末位）。 -->
                            <Border Style="{StaticResource DetailCover}">
                                <Grid>
                                    <Image Source="{Binding SelectedGame.CoverPath, Converter={StaticResource CoverImage}}"
                                           Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                           Visibility="{Binding SelectedGame.HasCover, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{Binding SelectedGame.Name, Mode=OneWay}" FontSize="{DynamicResource Font_SizeTitleLg}" FontWeight="Bold"
                                               Foreground="{DynamicResource Brush_TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" Padding="{DynamicResource Space_MD}"
                                               Visibility="{Binding SelectedGame.HasCover, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                </Grid>
                            </Border>

                            <StackPanel Margin="{DynamicResource Space_LG}">
                                <TextBlock Text="{Binding SelectedGame.Name, Mode=OneWay}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush_TextPrimary}" TextWrapping="Wrap"/>

                                <!-- 状态徽章：默认「已安装」；未装完转 warning、库离线转 danger。
                                     与卡片同口径、同优先级（库离线放最后，后匹配者胜） -->
                                <Border Padding="{DynamicResource Space_XXS}" CornerRadius="{DynamicResource Radius_XS}"
                                        HorizontalAlignment="Left" Margin="{DynamicResource Space_SM}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource Brush_SuccessBorder}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedGame.IsFullyInstalled}" Value="False">
                                                    <Setter Property="Background" Value="{DynamicResource Brush_WarningSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush_Warning}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedGame.IsLibraryOffline}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush_Danger}"/>
                                                </DataTrigger>
                                                <!-- 未安装优先级最高（放最后）：未安装条目 StateFlags=0，
                                                     若被上面 IsFullyInstalled=False 抢到就会显示成「下载/更新中」 -->
                                                <DataTrigger Binding="{Binding SelectedGame.IsNotInstalled}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontFamily="{DynamicResource Font_Mono}" FontSize="{DynamicResource Font_SizeMicro}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="已安装"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush_SuccessText}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsFullyInstalled}" Value="False">
                                                        <Setter Property="Text" Value="下载/更新中"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsLibraryOffline}" Value="True">
                                                        <Setter Property="Text" Value="库离线"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush_DangerText}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsNotInstalled}" Value="True">
                                                        <Setter Property="Text" Value="未安装"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <!-- 元数据：全部复用卡片既有格式化投影（SizeText / PlaytimeText / LastPlayedText），
                                     不另写一份，避免「卡片与详情显示不一致」的口径漂移 -->
                                <StackPanel Margin="{DynamicResource Space_SM}">
                                    <Grid Margin="{DynamicResource Space_XXS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailMetaLabel}" Text="AppID"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailMetaValue}"
                                                   Text="{Binding SelectedGame.AppIdText, Mode=OneWay}"/>
                                    </Grid>
                                    <Grid Margin="{DynamicResource Space_XXS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailMetaLabel}" Text="占用"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailMetaValue}"
                                                   Text="{Binding SelectedGame.SizeText, Mode=OneWay}"/>
                                    </Grid>
                                    <Grid Margin="{DynamicResource Space_XXS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailMetaLabel}" Text="游玩时长"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailMetaValue}"
                                                   Text="{Binding SelectedGame.PlaytimeText, Mode=OneWay}"/>
                                    </Grid>
                                    <Grid Margin="{DynamicResource Space_XXS}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailMetaLabel}" Text="最近游玩"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailMetaValue}"
                                                   Text="{Binding SelectedGame.LastPlayedText, Mode=OneWay}"/>
                                    </Grid>
                                    <!-- 安装位置：路径缺失（库离线 / 字段为空）时整行隐藏，不显示半截路径。
                                         路径截断显示，ToolTip 给全量（与「打开目录」实际打开的位置同源） -->
                                    <Grid Margin="{DynamicResource Space_XXS}"
                                          Visibility="{Binding SelectedGame.HasInstallPath, Converter={StaticResource BoolToVis}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource DetailMetaLabel}" Text="安装位置"/>
                                        <TextBlock Grid.Column="1" Style="{StaticResource DetailMetaValue}"
                                                   Text="{Binding SelectedGame.InstallPathText, Mode=OneWay}"
                                                   ToolTip="{Binding SelectedGame.InstallPathText, Mode=OneWay}"/>
                                    </Grid>
                                </StackPanel>

                                <!-- 操作区：一主三次（主人裁定）。四个命令全是页面既有命令，参数 = SelectedGame，
                                     未新增任何命令与 Core 能力 -->
                                <Border Style="{StaticResource DetailDivider}" Margin="{DynamicResource Space_MD}"/>
                                <Button Style="{DynamicResource PrimaryButton}" MinHeight="34" Margin="{DynamicResource Space_XXS}"
                                        Content="启动" Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}"/>
                                <Grid Margin="{DynamicResource Space_SM}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 未安装时只留「商店页面」并铺满整行：另外三键对未安装的游戏都没有真实语义 -->
                                    <Button Content="商店页面"
                                            Command="{Binding OpenStoreCommand}" CommandParameter="{Binding SelectedGame}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource DetailActionButton}">
                                                <Setter Property="Margin" Value="{DynamicResource Space_XXS}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedGame.IsInstalled}" Value="False">
                                                        <Setter Property="Grid.ColumnSpan" Value="3"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Style="{StaticResource DetailActionButton}" Content="打开目录" Margin="{DynamicResource Space_XXS}"
                                            Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding OpenFolderCommand}" CommandParameter="{Binding SelectedGame}"/>
                                    <Button Grid.Column="2" Style="{StaticResource DetailDangerButton}" Content="⚠ 卸载" Margin="{DynamicResource Space_XXS}"
                                            Visibility="{Binding SelectedGame.IsInstalled, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding UninstallGameCommand}" CommandParameter="{Binding SelectedGame}"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 关闭键：固定在面板右上（不随内容滚动）。用外层 Border 承载深底 + 浅字，
                         保证压在任何封面/浅底上都可读——不赌 SecondaryButton 模板是否透传 Background -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="{DynamicResource Space_XS}" MinWidth="28" MinHeight="28"
                            Background="{DynamicResource Brush_DarkSurface}" CornerRadius="{DynamicResource Radius_Pill}">
                        <Button Style="{StaticResource AccountChipButton}" Background="Transparent"
                                Command="{Binding CloseDetailCommand}"
                                ToolTip="关闭（Esc）" AutomationProperties.Name="关闭详情"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{DynamicResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
