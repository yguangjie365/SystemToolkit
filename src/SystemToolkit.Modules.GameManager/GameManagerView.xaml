<UserControl x:Class="SystemToolkit.Modules.GameManager.GameManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.GameManager"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             Background="{StaticResource Brush_Bg}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 封面限宽解码（REVIEW-3 S-4：直绑 string 按原始尺寸解码，1200×1800 竖版 4 倍冗余内存） -->
        <local:CoverImageConverter x:Key="CoverImage"/>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <!-- 游戏卡片：封面 + 名称 + 元数据行 + 操作行（设计 §7 卡片范式；布局对齐 GameManager.html 参考稿） -->
        <Style x:Key="GameCard" TargetType="Border">
            <Setter Property="Width" Value="320"/>
            <Setter Property="Margin" Value="0,0,14,18"/>
            <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_CardLg}"/>
            <Setter Property="Padding" Value="0"/>
            <!-- 封面贴边 + hover 缩放不外溢：整卡裁剪（HTML .game-card overflow:hidden 等效） -->
            <Setter Property="ClipToBounds" Value="True"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLibraryOffline}" Value="True">
                    <Setter Property="Opacity" Value="0.55"/>
                </DataTrigger>
                <!-- M-UI-3（2026-09-05）：hover 反馈——边框转深青 + 加粗。
                     上浮位移由 DataTemplate 内 Border.RenderTransform + EventTrigger 动画完成
                     （Style.Triggers 不支持 EventTrigger，无法承载 Storyboard） -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardActionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>
        <!-- 卡片元数据文本（HTML .meta-item：mono 微字弱色） -->
        <Style x:Key="CardMetaText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font_Mono}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeTiny}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头（参考稿：副标题 = 「N 款游戏 · M 个库」） ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="游戏管理" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeBodySm}" Style="{StaticResource MonoText}" Margin="0,2,0,0">
                    <Run Text="{Binding HeaderSubtitle, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <!-- 账户区：头像 + 账户名（本地 avatarcache PNG；缺失字母占位） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                <Border Width="34" Height="34" CornerRadius="{DynamicResource Radius_CardLg}" ClipToBounds="True"
                        Background="{StaticResource Brush_DarkSurface}">
                    <Grid>
                        <Image Source="{Binding AvatarPath}" Stretch="UniformToFill">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>
                        <TextBlock Text="{Binding AvatarInitial}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                                   Foreground="{StaticResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AvatarPath}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>
                <StackPanel VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding AccountName}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold"
                               Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="Steam 账户" FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}"/>
                </StackPanel>
            </StackPanel>
            <Border Grid.Column="3" Style="{StaticResource LiveBadge}" Height="30" Margin="0,0,12,0">
                <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{StaticResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                            <Setter Property="Text" Value="● Steam 未运行"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SteamRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Success}"/>
                                    <Setter Property="Text" Value="● Steam 运行中"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
            <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="30" Content="刷新"
                    Command="{Binding LoadCommand}"/>
        </Grid>

        <!-- ============ 工具行 ============ -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="320" Height="30" HorizontalAlignment="Left"
                    Background="{StaticResource Brush_Surface}"
                    BorderBrush="{StaticResource Brush_Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius_Chip}">
                <Grid>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="8,0" FontSize="{DynamicResource Font_SizeBodySm}"
                             Background="Transparent" BorderThickness="0"/>
                    <TextBlock Text="搜索游戏名称…" FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                <!-- M-UI-2 审查处置：系统 Radio 圆点 → SegmentedRadioItem 选中态 pill（参考稿 .sort-group 语义；
                     命令绑定/GroupName 不变，仅外观替换） -->
                <RadioButton Content="最近游玩" IsChecked="True" GroupName="GameSort" Margin="6,0,0,0"
                             Style="{StaticResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="0"/>
                <RadioButton Content="时长" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{StaticResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="1"/>
                <RadioButton Content="占用" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{StaticResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="2"/>
                <RadioButton Content="名称" GroupName="GameSort" Margin="4,0,0,0"
                             Style="{StaticResource SegmentedRadioItem}"
                             Command="{Binding SetSortCommand}" CommandParameter="3"/>
            </StackPanel>
            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30" Padding="12,0" Margin="12,0,0,0"
                    Content="启动 Steam" Command="{Binding LaunchClientCommand}"/>
        </Grid>

        <!-- ============ 状态栏（参考稿：内容区上方单行 mono 统计） ============ -->
        <TextBlock Grid.Row="2" Style="{StaticResource MonoText}" FontSize="{DynamicResource Font_SizeMicro}"
                   Foreground="{StaticResource Brush_TextMuted}" Margin="2,0,0,12"
                   Text="{Binding InstalledSummary, Mode=OneWay}"/>

        <!-- ============ 内容区：三态 ============ -->
        <Grid Grid.Row="3">
            <!-- 未安装 Steam -->
            <Border Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_CardLg}"
                    Padding="{DynamicResource Space_Lg}" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding SteamInstalled, Converter={x:Static local:InverseBoolConverter.Instance}}">
                <StackPanel>
                    <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush_TextMuted}"/>
                    <TextBlock Text="未检测到 Steam 客户端" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="请确认 Steam 已安装；安装后点击「刷新」重新扫描。" FontSize="{DynamicResource Font_SizeBody}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush_TextMuted}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- 已安装：游戏卡网格。
                 REVIEW-3 S-3：WrapPanel 无虚拟化（数百卡全量实例化）→ 引入 VirtualizingWrapPanel
                 包（VirtualizingItemsControl 自带 ScrollViewer 视口；外层再套 ScrollViewer 会禁用虚拟化，
                 故删除外层 ScrollViewer）。viewport 窄时自动降列（参考稿响应式语义）保留。
                 右侧 -14px：抵消末列卡片右间距（末列恒多 14px 空白视觉失衡），被裁掉的是无内容透明补偿区 -->
            <vwp:VirtualizingItemsControl Margin="0,6,0,0" ItemsSource="{Binding GamesView}"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          Visibility="{Binding SteamInstalled, Converter={StaticResource BoolToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Margin="0,0,-14,0"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GameCard}">
                                <!-- M-UI-3（2026-09-05）：hover 上浮 5px（0.15s 缓动）。
                                     边框转深青由 GameCard 样式负责；位移只能放这里——
                                     Style.Triggers 不支持 EventTrigger，无法承载 Storyboard -->
                                <Border.RenderTransform>
                                    <TranslateTransform Y="0"/>
                                </Border.RenderTransform>
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Border.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="-5" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Border.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                                <StackPanel>
                                    <!-- 封面（参考稿：175px 高 + 底部微遮罩 + hover 缩放 + 未安装徽章覆盖；
                                         缺失用字母占位。header.jpg 横版优先见 SteamService.FindCoverArt 注释） -->
                                    <Border Height="175" ClipToBounds="True" Background="{StaticResource Brush_SurfaceAlt}">
                                        <Border.Triggers>
                                            <!-- hover 封面轻微放大（参考稿 scale 1.04，0.35s） -->
                                            <EventTrigger RoutedEvent="Border.MouseEnter">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1.04" Duration="0:0:0.35"/>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1.04" Duration="0:0:0.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="Border.MouseLeave">
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                         To="1" Duration="0:0:0.35"/>
                                                        <DoubleAnimation Storyboard.TargetName="CoverImage"
                                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                         To="1" Duration="0:0:0.35"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Border.Triggers>
                                        <Grid>
                                            <!-- 封面经 CoverImageConverter 限宽解码（480 物理像素）+ OnLoad 释放句柄 -->
                                            <Image x:Name="CoverImage" Source="{Binding CoverPath, Converter={StaticResource CoverImage}}" Stretch="UniformToFill" HorizontalAlignment="Center"
                                                   RenderTransformOrigin="0.5,0.5"
                                                   RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Image.RenderTransform>
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasCover}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeMetric}" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush_TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" Padding="10,0"
                                                       Visibility="{Binding HasCover, Converter={x:Static local:InverseBoolConverter.Instance}}"/>
                                            <!-- 底部微遮罩（参考稿 ::after：40px 渐变压暗，封面与卡片过渡更柔） -->
                                            <Rectangle Height="42" VerticalAlignment="Bottom" IsHitTestVisible="False"
                                                       Fill="{StaticResource Brush_CoverFade}"/>
                                            <!-- 未安装：徽章覆盖在封面底部（参考稿 .card-cover-overlay + .badge-state） -->
                                            <StackPanel VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsFullyInstalled, Converter={x:Static local:InverseBoolConverter.Instance}}">
                                                <StackPanel.Background>
                                                    <StaticResource ResourceKey="Brush_CoverOverlay"/>
                                                </StackPanel.Background>
                                                <Border HorizontalAlignment="Right" Margin="12,8,12,8"
                                                        Background="{StaticResource Brush_WarningSoft}"
                                                        BorderBrush="{StaticResource Brush_Warning}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius_Chip}" Padding="7,2">
                                                    <TextBlock Text="下载/更新中" FontFamily="{StaticResource Font_Mono}"
                                                               FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_Warning}"/>
                                                </Border>
                                            </StackPanel>
                                            <!-- 库离线：同位置徽章（M-UI-2 审查处置：离线此前只有整卡降透明，
                                                 文字可读性连带受损——补明确标签，Opacity 保留） -->
                                            <StackPanel VerticalAlignment="Bottom"
                                                        Visibility="{Binding IsLibraryOffline, Converter={StaticResource BoolToVis}}">
                                                <StackPanel.Background>
                                                    <StaticResource ResourceKey="Brush_CoverOverlay"/>
                                                </StackPanel.Background>
                                                <Border HorizontalAlignment="Right" Margin="12,8,12,8"
                                                        Background="{StaticResource Brush_DangerSoft}"
                                                        BorderBrush="{StaticResource Brush_Danger}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource Radius_Chip}" Padding="7,2">
                                                    <TextBlock Text="库离线" FontFamily="{StaticResource Font_Mono}"
                                                               FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_Danger}"/>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <StackPanel Margin="14,12,14,14">
                                        <!-- 名称行 + ⋯ 菜单（目录 / 卸载收纳进菜单，主行只留 启动 + 商店） -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                                                       Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                            <Button Grid.Column="1" Style="{StaticResource CardActionButton}" Content="⋯"
                                                    Padding="7,2" FontSize="{DynamicResource Font_SizeBody}" ToolTip="更多操作"
                                                    MinWidth="28" MinHeight="24"
                                                    Click="OnCardMenuClick"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <Button.ContextMenu>
                                                    <!-- ContextMenu 属独立可视树：DataContext 走 PlacementTarget.Tag（页级 VM），
                                                         CommandParameter 走 PlacementTarget.DataContext（单卡 GameCardVm）。
                                                         M-UI-2：主题化三件套（ToolkitContextMenu/MenuItem），告别系统原生观感 -->
                                                    <ContextMenu Style="{StaticResource ToolkitContextMenu}"
                                                                 DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                                        <MenuItem Header="打开安装目录" Style="{StaticResource ToolkitMenuItem}"
                                                                  Command="{Binding OpenFolderCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                        <Separator Style="{StaticResource ToolkitMenuSeparator}"/>
                                                        <MenuItem Header="⚠ 卸载此游戏" Style="{StaticResource ToolkitMenuItemDanger}"
                                                                  Command="{Binding UninstallGameCommand}"
                                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                                    </ContextMenu>
                                                </Button.ContextMenu>
                                            </Button>
                                        </Grid>

                                        <!-- 元数据行（参考稿：占用 · 时长 单行 mono，圆点分隔） -->
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding SizeOnDiskText}"/>
                                            <Ellipse Width="3" Height="3" Fill="{StaticResource Brush_Track}" Margin="7,0" VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding PlaytimeText}"/>
                                        </StackPanel>
                                        <!-- 最近游玩日期单独一行（参考稿 .card-last-played） -->
                                        <TextBlock Style="{StaticResource CardMetaText}" Text="{Binding LastPlayedText}" Margin="0,5,0,0"/>

                                        <!-- 操作行（参考稿：顶部分隔线 + 商店/启动两键均分等宽） -->
                                        <Border BorderBrush="{StaticResource Brush_Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Style="{StaticResource CardActionButton}" Content="商店页面" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.OpenStoreCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                                <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="启动" Margin="4,0,0,0"
                                                        Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
            </vwp:VirtualizingItemsControl>

            <!-- 态：搜索无结果（过滤后空 + 有游戏数据；参考稿「未找到匹配的游戏」） -->
            <Border Background="{StaticResource Brush_Bg}" Padding="{DynamicResource Space_Lg}"
                    Visibility="{Binding ShowNoResultEmpty, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush_TextMuted}"/>
                    <TextBlock Text="未找到匹配的游戏" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="换个关键词试试，或清空搜索查看全部。" FontSize="{DynamicResource Font_SizeBody}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush_TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- 态：库为空（Steam 已安装但没有任何游戏） -->
            <Border Background="{StaticResource Brush_Bg}" Padding="{DynamicResource Space_Lg}"
                    Visibility="{Binding ShowEmptyLibrary, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeTitleLg}" HorizontalAlignment="Center"
                               Foreground="{StaticResource Brush_TextMuted}"/>
                    <TextBlock Text="未发现已安装的游戏" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,10,0,0" Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="Steam 已就绪；安装游戏后点击「刷新」重新扫描。" FontSize="{DynamicResource Font_SizeBody}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" Foreground="{StaticResource Brush_TextMuted}"/>
                </StackPanel>
            </Border>

            <!-- 态：加载中（压最上层；IsLoading 由 LoadAsync 驱动，此前该状态无 UI 消费——审查核验属实） -->
            <Border Background="{StaticResource Brush_Bg}" Padding="{DynamicResource Space_Lg}"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <!-- 旋转圆环：Accent 弧 + Track 底环，Loaded 触发无限旋转 -->
                    <Grid Width="26" Height="26" HorizontalAlignment="Center">
                        <Ellipse Stroke="{StaticResource Brush_Track}" StrokeThickness="2.5"/>
                        <Ellipse Stroke="{StaticResource Brush_Accent}" StrokeThickness="2.5" StrokeDashArray="8 100" StrokeDashCap="Round">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="SpinnerRotate" CenterX="13" CenterY="13"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Ellipse.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1" RepeatBehavior="Forever"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                    </Grid>
                    <TextBlock Text="正在读取 Steam 库…" Style="{StaticResource MonoText}" FontSize="{DynamicResource Font_SizeTiny}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ 底部状态栏（操作反馈通道，HTML toast 的 WPF 等效；
             M-UI-2：按 StatusLevel 语义着色——0 信息/1 成功/2 失败，深色底用 400 档亮色变体） ============ -->
        <Border Grid.Row="4" Margin="0,12,0,0" Background="{StaticResource Brush_DarkSurface}"
                CornerRadius="{DynamicResource Radius_CardSm}" Padding="{DynamicResource Space_Sm}">
            <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource Font_SizeBodySm}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Brush_OnDarkMuted}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusLevel}" Value="1">
                                <Setter Property="Foreground" Value="{StaticResource Brush_SuccessOnDark}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusLevel}" Value="2">
                                <Setter Property="Foreground" Value="{StaticResource Brush_DangerOnDark}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>
    </Grid>
</UserControl>
