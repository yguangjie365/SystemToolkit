<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <!-- REVIEW-3 S-3：游戏卡网格虚拟化（WPF 原生 VirtualizingStackPanel 不支持 WrapPanel 布局） -->
    <PackageReference Include="VirtualizingWrapPanel" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SystemToolkit.Core\SystemToolkit.Core.csproj" />
    <ProjectReference Include="..\SystemToolkit.Abstractions\SystemToolkit.Abstractions.csproj" />
    <!-- 2026-09-15 深色主题加固：SteamApiKeyWindow 接入共享接线器 TitleBarThemeWiring
         （标题栏跟随主题明暗）。「模块 → UI.Common」是 DependencyGuard 白名单内的合法方向
         （共享控件与令牌），其余 8 个模块早已如此。 -->
    <ProjectReference Include="..\SystemToolkit.UI.Common\SystemToolkit.UI.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- A1/A3（2026-09-13）：BuildAccounts / UpdateLibraryCapacity 开放直测
         （账户当前项标记、同卷多库的剩余空间去重——这两处靠 UI 手点验不出来）。
         与 Core / Infrastructure / FileBackup / MusicManager 同款做法。 -->
    <InternalsVisibleTo Include="SystemToolkit.Tests" />
  </ItemGroup>

</Project>
