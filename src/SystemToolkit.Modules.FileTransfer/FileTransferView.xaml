<UserControl x:Class="SystemToolkit.Modules.FileTransfer.FileTransferView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.FileTransfer"
             Background="{DynamicResource Brush_Background}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- ============ 批次 P1（2026-09-13）：暂停/继续 + 同名策略设置 ============
             间距一律走 Style Setter（与下方会话卡片同理）：棘轮是纯文本正则，只命中元素上的内联写法，
             Setter.Value 不匹配 → 新增控件不占额度、基线无需调整。 -->
        <Style x:Key="TaskRowActionButton" TargetType="Button" BasedOn="{StaticResource CardButton}">
            <Setter Property="MinWidth" Value="52"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="ReceiveSettingRow" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>

        <!-- ============ 会话卡片 + 证书指纹行（2026-09-13 P0）的间距 ============
             🔴 本文件的令牌棘轮额度**已顶满**（margin 44/44 · width 25/25 · padding 3/3 ·
             height 6/6 · border 2/2），因此这张卡片的所有间距一律写进 Style Setter：
             棘轮是**纯文本正则**扫描（只命中元素上的内联 `Margin="数字`），Setter 的 Value 不匹配，
             于是新增卡片不占任何额度、基线无需调整。 -->
        <Style x:Key="SessionNameCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="SessionCell" TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SessionRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="SessionList" TargetType="ItemsControl">
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>
        <Style x:Key="SessionKickButton" TargetType="Button" BasedOn="{StaticResource CompactDangerButton}">
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <Style x:Key="CertRow" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,6,0,0"/>
        </Style>
        <Style x:Key="CertValue" TargetType="TextBlock">
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="CertCopyButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="文件互传" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Margin="0,2,0,0">
                    <Run Text="LAN · 设备 "/><Run Text="{Binding Desktop.DiscoveredDevices.Count, Mode=OneWay}"/><Run Text=" 台 · 任务 "/><Run Text="{Binding Desktop.ActiveTasks.Count, Mode=OneWay}"/><Run Text=" 个"/>
                </TextBlock>
            </StackPanel>
            <Border CornerRadius="{DynamicResource Radius_XS}" Padding="8,4" VerticalAlignment="Center" HorizontalAlignment="Right">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Desktop.IsTransferRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
                            </DataTrigger>
                            <!-- 2026-09-11 主人反馈：Web 服务已开启，右上角仍显示「服务未启动」 -->
                            <DataTrigger Binding="{Binding Mobile.IsWebRunning}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_Danger}"/>
                            <Setter Property="Text" Value="服务未启动"/>
                            <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
                            <Setter Property="FontWeight" Value="{DynamicResource Font_WeightMedium}"/>
                            <Style.Triggers>
                                <!-- 🔴 2026-09-11 主人反馈：原标签只反映 Desktop.IsTransferRunning（电脑互传
                                     TCP+UDP），与「手机通道」的 Web 服务（Kestrel）毫无关系——只启动 Web 服务
                                     时这里恒显「服务未启动」，与同一张卡片上的「停止 Web 服务」按钮自相矛盾。
                                     两个通道各自独立启停，故状态逐通道标注；同时运行给合并文案。
                                     ⚠️ WPF 同 Style 内多个 Trigger 同时命中时**后声明者优先**，
                                     故 MultiDataTrigger 必须放最后。 -->
                                <DataTrigger Binding="{Binding Desktop.IsTransferRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                                    <Setter Property="Text" Value="电脑互传运行中"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mobile.IsWebRunning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                                    <Setter Property="Text" Value="手机通道运行中"/>
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Desktop.IsTransferRunning}" Value="True"/>
                                        <Condition Binding="{Binding Mobile.IsWebRunning}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                                    <Setter Property="Text" Value="服务运行中（双通道）"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>

        <!-- ============ Tab 行 ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <!-- 2026-09-13 主人要求：「手机通道」（手机 → 电脑）提到前面并作为默认页。
                 注意 Tag 语义不变（0 = 电脑互传面板 / 1 = 手机通道面板），
                 OnTabChecked 与两个面板的默认 Visibility 必须与之保持一致。 -->
            <RadioButton Style="{DynamicResource SectionTab}" GroupName="FtTabs" IsChecked="True"
                         Content="手机通道" Tag="1" Checked="OnTabChecked"/>
            <RadioButton Style="{DynamicResource SectionTab}" GroupName="FtTabs"
                         Content="电脑互传" Tag="0" Checked="OnTabChecked"/>
        </StackPanel>

        <Grid Grid.Row="2" x:Name="TabContent">
            <!-- ============ 电脑互传面板（默认折叠：Tab 默认停在手机通道） ============ -->
            <ScrollViewer x:Name="DesktopPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- 本机状态与服务 -->
                    <Border Style="{DynamicResource ToolCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="本机与服务" Style="{DynamicResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="设备 ID：" Style="{DynamicResource KvLabel}"/>
                                    <TextBlock Text="{Binding Desktop.DeviceId}" Style="{DynamicResource MonoText}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Desktop.TransferPortText, StringFormat=· TCP 端口 {0}}" Style="{DynamicResource KvLabel}" Margin="10,0,0,0"/>
                                </StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="接收目录" Style="{DynamicResource KvLabel}" Margin="0,0,8,0"/>
                                    <TextBox Grid.Column="1" Style="{DynamicResource FieldInput}"
                                             Text="{Binding Desktop.ReceiveDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="3" Style="{DynamicResource CardButton}" Content="选择…" Click="OnPickReceiveDirectory"/>
                                    <Button Grid.Column="5" Style="{DynamicResource CardButton}" Content="打开" Click="OnOpenReceiveDirectory"/>
                                </Grid>
                                <StackPanel Style="{StaticResource ReceiveSettingRow}">
                                    <TextBlock Text="同名文件" Style="{DynamicResource KvLabel}" VerticalAlignment="Center"/>
                                    <ComboBox Style="{DynamicResource ThemedComboBox}"
                                              ItemsSource="{Binding Desktop.ConflictPolicyOptions}"
                                              DisplayMemberPath="Text"
                                              SelectedValuePath="Value"
                                              SelectedValue="{Binding Desktop.ConflictPolicy}"
                                              MinWidth="150"
                                              VerticalAlignment="Center"
                                              ToolTip="目标目录已有同名文件时怎么处理；电脑互传与手机上传共用这一条策略"/>
                                    <TextBlock Text="（两条接收通道共用）" Style="{DynamicResource KvLabel}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Style="{StaticResource ReceiveSettingRow}">
                                    <CheckBox Content="仅接受已发现设备（来源白名单）" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource ThemedCheckBox}"
                                              IsChecked="{Binding Desktop.RequireKnownPeer}"/>
                                    <CheckBox Content="接收前需本机确认" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource ThemedCheckBox}"
                                              IsChecked="{Binding Desktop.RequireReceiveConfirmation}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Button Command="{Binding Desktop.StartTransferCommand}" Content="启动服务">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.IsTransferRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Command="{Binding Desktop.StopTransferCommand}" Margin="0,8,0,0" Content="停止服务">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowDangerButton}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.IsTransferRunning}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 双列：已知设备 | 发现设备 -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource ToolCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="已知设备（常用对端）" Style="{DynamicResource CardTitle}"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{DynamicResource CardButton}" Content="添加" Command="{Binding Desktop.AddKnownPeerCommand}"/>
                                        <Button Style="{DynamicResource CardButton}" Content="移除" Margin="6,0,0,0" Command="{Binding Desktop.RemoveKnownPeerCommand}"/>
                                        <Button Style="{DynamicResource CardButton}" Content="保存" Margin="6,0,0,0" Command="{Binding Desktop.SaveConfigCommand}"/>
                                    </StackPanel>
                                </Grid>
                                <ListBox Height="150"
                                         ItemsSource="{Binding Desktop.KnownPeers}"
                                         SelectedItem="{Binding Desktop.SelectedKnownPeer}"
                                         AllowDrop="True" Drop="OnKnownPeerDrop" DragOver="OnPeerDragOver">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ListLog}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.KnownPeers.Count}" Value="0">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="暂无已知设备" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                                        <TextBlock Text="点击'添加'按钮添加常用对端" 
                                                                                   FontSize="{DynamicResource Font_SizeMicro}" 
                                                                                   Foreground="{DynamicResource Brush_TextMuted}" 
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextPrimary}" Width="110"/>
                                                <TextBlock FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextMuted}">
                                                    <Run Text="{Binding Ip, Mode=OneWay}"/><Run Text=":"/><Run Text="{Binding Port, Mode=OneWay}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="90"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Style="{DynamicResource FieldInput}" ToolTip="设备名称"
                                             Text="{Binding Desktop.SelectedKnownPeer.Name, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="2" Style="{DynamicResource FieldInput}" ToolTip="IP"
                                             Text="{Binding Desktop.SelectedKnownPeer.Ip, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBox Grid.Column="4" Style="{DynamicResource FieldInput}" ToolTip="端口"
                                             Text="{Binding Desktop.SelectedKnownPeer.Port, UpdateSourceTrigger=PropertyChanged}"/>
                                    <Button Grid.Column="6" Style="{DynamicResource RowPrimaryButton}" Content="发送文件"
                                            Command="{Binding Desktop.SendToKnownPeerCommand}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource ToolCard}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <TextBlock Text="局域网设备（自动发现）" Style="{DynamicResource CardTitle}"/>
                                    <Button HorizontalAlignment="Right" Style="{DynamicResource CardButton}"
                                            Content="刷新" Command="{Binding Desktop.RefreshDevicesCommand}"/>
                                </Grid>
                                <ListBox Height="150"
                                         ItemsSource="{Binding Desktop.DiscoveredDevices}"
                                         SelectedItem="{Binding Desktop.SelectedDevice}"
                                         AllowDrop="True" Drop="OnDiscoveredDeviceDrop" DragOver="OnPeerDragOver">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ListLog}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.DiscoveredDevices.Count}" Value="0">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="未发现设备" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                                        <TextBlock Text="请启动服务后点击刷新按钮" 
                                                                                   FontSize="{DynamicResource Font_SizeMicro}" 
                                                                                   Foreground="{DynamicResource Brush_TextMuted}" 
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextPrimary}" Width="110"/>
                                                <TextBlock Text="{Binding EndpointText}" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                <TextBlock Text="{Binding OnlineText}" FontSize="{DynamicResource Font_SizeMicro}" Margin="10,0,0,0"
                                                           Foreground="{DynamicResource Brush_SuccessText}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Style="{DynamicResource RowPrimaryButton}" Content="发送文件到所选设备"
                                            Command="{Binding Desktop.SendToSelectedDeviceCommand}"/>
                                    <Button Style="{DynamicResource CompactActionButton}" Content="加入已知" 
                                            Command="{Binding Desktop.AddDiscoveredToKnownCommand}" Margin="8,0,0,0"/>
                                    <TextBlock Text="提示：也可把文件拖到目标设备行上" FontSize="{DynamicResource Font_SizeMicro}"
                                               Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- 传输任务 -->
                    <Border Style="{DynamicResource ToolCard}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="传输任务" Style="{DynamicResource CardTitle}"/>
                                <Button HorizontalAlignment="Right" Style="{DynamicResource RowDangerButton}" Content="取消所选任务"
                                        Command="{Binding Desktop.CancelTaskCommand}"/>
                            </Grid>
                            <ListBox Grid.Row="1" MinHeight="60" MaxHeight="220"
                                     ItemsSource="{Binding Desktop.ActiveTasks}"
                                     SelectedItem="{Binding Desktop.SelectedTask}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ListLog}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.ActiveTasks.Count}" Value="0">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" MinHeight="60">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="暂无传输任务" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                                        <TextBlock Text="选择设备后发送文件即可创建任务" 
                                                                                   FontSize="{DynamicResource Font_SizeMicro}" 
                                                                                   Foreground="{DynamicResource Brush_TextMuted}" 
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60"/>
                                                <ColumnDefinition Width="200"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding DirectionText}" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextSecondary}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileName}" FontSize="{DynamicResource Font_SizeBodySm}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                            <ProgressBar Grid.Column="2" Value="{Binding Progress, Mode=OneWay}" Maximum="100" Height="10"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            <TextBlock Grid.Column="3" Text="{Binding SpeedText}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <Button Style="{StaticResource TaskRowActionButton}"
                                                        Content="{Binding PauseResumeText}"
                                                        Command="{Binding DataContext.Desktop.TogglePauseCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                                        AutomationProperties.Name="暂停或继续此任务"/>
                                                <Button Style="{DynamicResource CardButton}" Content="取消"
                                                        Command="{Binding DataContext.Desktop.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- 传输历史 -->
                    <Border Style="{DynamicResource ToolCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <TextBlock Text="传输历史" Style="{DynamicResource CardTitle}"/>
                                <Button HorizontalAlignment="Right" Style="{DynamicResource CardButton}" Content="清空"
                                        Command="{Binding Desktop.ClearHistoryCommand}"/>
                            </Grid>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Desktop.HistoryEntries}"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.Style>
                                        <Style TargetType="ListBox" BasedOn="{StaticResource ListLog}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Desktop.HistoryEntries.Count}" Value="0">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="ListBox">
                                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <TextBlock Text="暂无传输历史" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                                        <TextBlock Text="完成传输后会自动记录到此处" 
                                                                                   FontSize="{DynamicResource Font_SizeMicro}" 
                                                                                   Foreground="{DynamicResource Brush_TextMuted}" 
                                                                                   Margin="0,4,0,0"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ListBox.Style>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2" ToolTip="{Binding ReasonText}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="140"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding FinishedAt, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding DirectionText}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextSecondary}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FileName}" FontSize="{DynamicResource Font_SizeBodySm}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PeerEndpoint}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding SizeText}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                            <TextBlock Grid.Column="5" FontSize="{DynamicResource Font_SizeMicro}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                                                        <Setter Property="Text" Value="{Binding StatusText}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Completed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush_Danger}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ============ 手机通道面板（批次二；默认展开） ============ -->
            <ScrollViewer x:Name="MobilePanel" Visibility="Visible" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 二维码卡 -->
                    <Border Grid.Column="0" Style="{DynamicResource ToolCard}">
                        <StackPanel>
                            <TextBlock Text="手机扫码访问" Style="{DynamicResource CardTitle}"/>
                            <Border Background="{DynamicResource Brush_SurfaceAlt}" CornerRadius="{DynamicResource Radius_LG}"
                                    Padding="10" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Image Source="{Binding Mobile.QrImage}" Width="200" Height="200"/>
                            </Border>
                            <TextBlock Text="{Binding Mobile.UrlText}" Style="{DynamicResource MonoText}" TextWrapping="Wrap" HorizontalAlignment="Center"/>
                            <Button Style="{DynamicResource CardButton}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Content="打开网页" Click="OnOpenWebPage"
                                    ToolTip="需先启动手机通道 Web 服务" ToolTipService.ShowOnDisabled="True"
                                    IsEnabled="{Binding Mobile.IsWebRunning}"/>
                        </StackPanel>
                    </Border>

                    <!-- 服务与配对卡 -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{DynamicResource ToolCard}" Margin="0,0,0,14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Web 服务（Kestrel）" Style="{DynamicResource CardTitle}"/>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="共享目录" Style="{DynamicResource KvLabel}" Margin="0,0,8,0"/>
                                        <TextBox Grid.Column="1" Style="{DynamicResource FieldInput}"
                                                 Text="{Binding Mobile.ShareDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                                        <Button Grid.Column="3" Style="{DynamicResource CardButton}" Content="选择…" Click="OnPickShareDirectory"/>
                                        <Button Grid.Column="5" Style="{DynamicResource CardButton}" Content="打开" Command="{Binding Mobile.OpenShareDirectoryCommand}"/>
                                    </Grid>
                                    <TextBlock FontSize="{DynamicResource Font_SizeMicro}" TextWrapping="Wrap" Foreground="{DynamicResource Brush_TextMuted}"
                                               Text="手机与电脑需在同一局域网；首次连接触发防火墙提示属预期。共享目录下的文件可被手机浏览与下载。"/>
                                    <!-- 证书指纹（协议 §6.3）：手机端弹「证书已变更」时，用户可在这里核对——
                                         指纹对得上说明只是轮换/重签，不是中间人攻击。仅 HTTPS 运行时有值。 -->
                                    <StackPanel Orientation="Horizontal" Style="{StaticResource CertRow}">
                                        <TextBlock Text="证书指纹" Style="{DynamicResource KvLabel}"/>
                                        <TextBlock Text="{Binding Mobile.CertFingerprintText}" Style="{StaticResource CertValue}"
                                                   FontFamily="{DynamicResource Font_Mono}" FontSize="{DynamicResource Font_SizeMicro}"
                                                   Foreground="{DynamicResource Brush_TextMuted}"
                                                   ToolTip="{Binding Mobile.CertFingerprintFull}"/>
                                        <Button Style="{StaticResource CertCopyButton}" Content="复制"
                                                Command="{Binding Mobile.CopyCertFingerprintCommand}"
                                                AutomationProperties.Name="复制证书指纹"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                    <Button Command="{Binding Mobile.StartWebCommand}" Content="启动 Web 服务">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mobile.IsWebRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Command="{Binding Mobile.StopWebCommand}" Margin="0,8,0,0" Content="停止 Web 服务">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowDangerButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Mobile.IsWebRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{DynamicResource ToolCard}">
                            <StackPanel>
                                <TextBlock Text="一次性配对码（10 分钟轮换，用后即失效）" Style="{DynamicResource CardTitle}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Mobile.PairCodeText}" FontSize="{DynamicResource Font_SizeTitleLg}" FontWeight="Bold"
                                               FontFamily="{DynamicResource Font_Mono}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center"/>
                                    <Button Style="{DynamicResource CompactActionButton}" Content="复制" Margin="8,0,0,0"
                                            Command="{Binding Mobile.CopyPairCodeCommand}" Height="26" MinWidth="48"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Mobile.PairExpiresText}" FontSize="{DynamicResource Font_SizeMicro}"
                                           Foreground="{DynamicResource Brush_TextMuted}" HorizontalAlignment="Center"/>
                                <TextBlock FontSize="{DynamicResource Font_SizeMicro}" TextWrapping="Wrap" Foreground="{DynamicResource Brush_TextMuted}" Margin="0,10,0,0"
                                           Text="手机打开页面后输入此配对码换取访问令牌；配对码绝不进入长期访问 URL。"/>
                            </StackPanel>
                        </Border>
                        <!-- ============ 已授权设备（会话，2026-09-13 P0 · 协议 §5.3） ============
                             配对成功一台就多一行；「踢出」只作废那一台（它需重新扫码），
                             不影响其它设备、也不影响本机预览（桌面「打开网页」）。
                             数据源 = IFileWebServer.Sessions，由 SessionsChanged 事件驱动刷新。 -->
                        <Border Style="{DynamicResource ToolCard}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="已授权设备（会话）" Style="{DynamicResource CardTitle}"/>
                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Style="{StaticResource SessionKickButton}"
                                            Content="全部踢出" Command="{Binding Mobile.KickAllSessionsCommand}"
                                            Visibility="{Binding Mobile.HasSessions, Converter={StaticResource BoolToVis}}"
                                            ToolTip="作废所有已配对设备的访问令牌（它们需重新扫码）；不影响本机预览"
                                            AutomationProperties.Name="踢出全部已授权设备"/>
                                </Grid>
                                <TextBlock Text="{Binding Mobile.SessionsSummary}" FontSize="{DynamicResource Font_SizeMicro}"
                                           Foreground="{DynamicResource Brush_TextMuted}"/>
                                <ItemsControl ItemsSource="{Binding Mobile.Sessions}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl" BasedOn="{StaticResource SessionList}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mobile.HasSessions}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Style="{StaticResource SessionRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource SessionNameCell}"
                                                           Foreground="{DynamicResource Brush_TextPrimary}" ToolTip="{Binding DetailTip}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding IpText}" Style="{StaticResource SessionCell}"
                                                           FontFamily="{DynamicResource Font_Mono}" FontSize="{DynamicResource Font_SizeMicro}"
                                                           Foreground="{DynamicResource Brush_TextMuted}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" Style="{StaticResource SessionCell}"
                                                           FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                <!-- 踢出：命令在页 VM（Mobile.*）上，项 VM 自身没有 → 经 AncestorType=UserControl
                                                     回到页面 DataContext。这里是普通 DataTemplate（非 ContextMenu/Popup），祖先查找有效。 -->
                                                <Button Grid.Column="3" Content="踢出" Style="{StaticResource SessionKickButton}"
                                                        Command="{Binding DataContext.Mobile.KickSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        AutomationProperties.Name="踢出此设备"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"
                                           Text="暂无已授权设备 —— 手机扫码配对后会出现在这里">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Mobile.HasSessions}" Value="False">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ============ 底部操作日志 ============ -->
        <Border Grid.Row="3" Margin="0,14,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,8,0,6">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LogToggle" IsChecked="True" Content="▾ 操作日志" FontSize="{DynamicResource Font_SizeBodySm}"
                                      Foreground="{DynamicResource Brush_TextSecondary}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                                      Style="{DynamicResource ThemedToggleButton}"/>
                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{Binding LogLines.Count, Mode=OneWay}"/><Run Text=" 行"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{DynamicResource CardButton}" Content="清空" Command="{Binding ClearLogCommand}"/>
                </Grid>
                <Border Grid.Row="1" x:Name="LogHost" Background="{DynamicResource Brush_DarkSurface}"
                        CornerRadius="{DynamicResource Radius_LG}" Padding="10,6" MaxHeight="160">
                    <ListBox Style="{DynamicResource ListLog}" ItemsSource="{Binding LogLines}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font_Mono}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="NoWrap" FontSize="{DynamicResource Font_SizeMicro}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
