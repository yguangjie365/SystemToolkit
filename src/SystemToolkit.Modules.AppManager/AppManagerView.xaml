<UserControl x:Class="SystemToolkit.Modules.AppManager.AppManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.AppManager"
             Background="{StaticResource Brush_Bg}">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <local:ZeroToVisibilityConverter x:Key="ZeroToVis"/>
        
        <!-- 状态徽章：按 StatusKey 着色（0=已安装绿 1=有更新橙 2=未安装灰 3=未知蓝） -->
        <Style x:Key="StatusTagBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_Badge}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="0">
                    <Setter Property="Background" Value="{StaticResource Brush_SuccessSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="1">
                    <Setter Property="Background" Value="{StaticResource Brush_WarningSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="2">
                    <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="3">
                    <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusKey}" Value="0">
                    <Setter Property="Foreground" Value="{StaticResource Brush_Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="1">
                    <Setter Property="Foreground" Value="{StaticResource Brush_Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="2">
                    <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding StatusKey}" Value="3">
                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 软件清单表格复用模板（用户 2026-09-07：标题列左右居中） -->
        <Style x:Key="AppListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Padding" Value="10,10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 顶栏 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius_CardSm}" Background="{StaticResource Brush_AccentSoft}">
                <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeBody}"
                           Foreground="{StaticResource Brush_Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="软件管理" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Style="{StaticResource MonoText}" Margin="0,2,0,0">
                    <Run Text="APP MANAGER · "/><Run Text="{Binding RefreshStatus, Mode=OneWay}"/>
                </TextBlock>
            </StackPanel>
            <!-- 软件源下拉 -->
            <Button Grid.Column="2" Height="30" Padding="12,0" FontSize="{DynamicResource Font_SizeBodySm}"
                    Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" Foreground="{StaticResource Brush_TextSecondary}" Cursor="Hand"
                    x:Name="SourceMenuButton" Click="OnSourceMenuClick">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="软件源: "/>
                    <TextBlock Text="{Binding SourceLabel}" FontWeight="Bold"/>
                    <TextBlock Text=" ▾" FontSize="{DynamicResource Font_SizeNano}"/>
                </StackPanel>
            </Button>
            <Button Grid.Column="3" Height="30" Padding="12,0" Margin="8,0,0,0" FontSize="{DynamicResource Font_SizeBodySm}"
                    Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" Foreground="{StaticResource Brush_TextSecondary}" Cursor="Hand"
                    Command="{Binding RefreshStatesCommand}" Content="⟳ 检测状态"/>
            <Button Grid.Column="4" Height="30" Padding="12,0" Margin="8,0,0,0" FontSize="{DynamicResource Font_SizeBodySm}"
                    Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" Foreground="{StaticResource Brush_TextSecondary}" Cursor="Hand"
                    Command="{Binding ImportListCommand}" Content="导入"/>
            <Button Grid.Column="5" Height="30" Padding="12,0" Margin="8,0,0,0" FontSize="{DynamicResource Font_SizeBodySm}"
                    Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" Foreground="{StaticResource Brush_TextSecondary}" Cursor="Hand"
                    Command="{Binding ExportListCommand}" Content="导出"/>
            <Button Grid.Column="6" Height="30" Padding="12,0" Margin="8,0,0,0" FontSize="{DynamicResource Font_SizeBodySm}"
                    Background="{StaticResource Brush_Accent}" BorderThickness="0"
                    Foreground="{StaticResource Brush_OnDark}" Cursor="Hand"
                    Command="{Binding AddManualSoftwareCommand}" Content="+ 添加软件"/>
        </Grid>

        <!-- ============ Tab 行 ============ -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <RadioButton Style="{StaticResource SectionTab}" GroupName="Tabs" IsChecked="True"
                         Content="微软商店应用" Tag="store" Checked="OnTabChecked"/>
            <RadioButton Style="{StaticResource SectionTab}" GroupName="Tabs"
                         Content="第三方应用" Tag="thirdparty" Checked="OnTabChecked"/>
            <RadioButton Style="{StaticResource SectionTab}" GroupName="Tabs"
                         Content="环境档案" Tag="archives" Checked="OnTabChecked"/>
        </StackPanel>

        <!-- ============ 筛选行（仅软件 Tab 显示；chips 左，源搜索框独立最右且仅商店 Tab） ============ -->
        <Grid Grid.Row="2" Margin="0,0,0,12" x:Name="FilterRow">
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter" IsChecked="True"
                             Content="全部" Command="{Binding SetFilterCommand}" CommandParameter="0"/>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                             Content="已安装" Command="{Binding SetFilterCommand}" CommandParameter="1"/>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                             Content="有更新" Command="{Binding SetFilterCommand}" CommandParameter="2"/>
                <RadioButton Style="{StaticResource FilterChip}" GroupName="StatusFilter"
                             Content="未安装" Command="{Binding SetFilterCommand}" CommandParameter="3"/>
                <Button Style="{StaticResource RowActionButton}" Height="26" Content="全选"
                        Command="{Binding SelectAllCommand}" Margin="6,0,0,0"/>
                <Button Style="{StaticResource RowActionButton}" Height="26" Content="反选"
                        Command="{Binding InvertSelectionCommand}"/>
            </StackPanel>
            <!-- 源搜索框：用户 2026-09-04 移到最右，且仅微软商店应用 Tab 显示 -->
            <Border x:Name="SearchHost" Width="320" Height="32" Background="{StaticResource Brush_Surface}"
                    BorderBrush="{StaticResource Brush_Border}" BorderThickness="1" CornerRadius="{DynamicResource Radius_Chip}"
                    HorizontalAlignment="Right">
                <Grid>
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                             VerticalContentAlignment="Center" Padding="8,0" FontSize="{DynamicResource Font_SizeBody}"
                             Background="Transparent" BorderThickness="0">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding RunSearchCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <TextBlock Text="搜索 winget 源，回车执行（可安装并加入清单）" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchQuery}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 内容区 ============ -->
        <Grid Grid.Row="3">
            <!-- 视图 A：软件清单（微软商店 / 第三方共用结构，绑定不同集合） -->
            <Grid x:Name="SoftwareListPanel">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Style="{StaticResource CardBorder}" Padding="0">
                    <Grid>
                        <!-- 微软商店应用 -->
                        <ListView ItemsSource="{Binding StoreView}"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  x:Name="StoreList" SizeChanged="OnListSizeChanged">
<ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListItemRowTallStyle}" TargetType="ListViewItem"/>
                        </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource AppListHeader}">
                                    <GridViewColumn Width="36">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox Style="{StaticResource ThemedCheckBox}" 
                                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="名称">
                                                                           <GridViewColumn.HeaderTemplate>
                                                                               <DataTemplate>
                                                                                   <TextBlock Text="名称" TextAlignment="Center"
                                                                                              MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GridViewColumnHeader}}"/>
                                                                               </DataTemplate>
                                                                           </GridViewColumn.HeaderTemplate>
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="20" Height="20" CornerRadius="{DynamicResource Radius_Control}"
                                                            Background="{StaticResource Brush_AccentSoft}">
                                                        <TextBlock Text="{Binding Initial}" FontSize="{DynamicResource Font_SizeNano}" FontWeight="Bold"
                                                                   Foreground="{StaticResource Brush_Accent}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold" Margin="8,0,0,0"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Description}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="已装版本" Width="130">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource Font_SizeMono}"
                                                           FontFamily="{StaticResource Font_Mono}" TextAlignment="Center"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" Width="120"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="来源" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="Store" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{StaticResource Brush_TextMuted}" HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="状态" Width="150">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource StatusTagBorder}" HorizontalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusTagText}"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="操作" Width="330">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <!-- 2026-09-07 用户拍板：恢复固定四按钮（按状态显隐），不再用动态 2+1 -->
                                                    <Button Style="{StaticResource RowActionButton}" Content="安装" Margin="0,0,8,0"
                                                            Visibility="{Binding IsInstallVisible}"
                                                            Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource RowActionButton}" Content="升级" Margin="0,0,8,0"
                                                            Visibility="{Binding IsUpgradeVisible}"
                                                            Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource RowDangerButton}" Content="卸载" Margin="0,0,8,0"
                                                            Visibility="{Binding IsUninstallVisible}"
                                                            Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Style="{StaticResource RowActionButton}" Content="编辑"
                                                            Command="{Binding DataContext.EditSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <!-- 第三方应用（含 winget 第三方 + 手动软件区） -->
                        <Grid x:Name="ThirdPartyListPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ListView ItemsSource="{Binding ThirdPartyView}"
                                      BorderThickness="0" Background="Transparent"
                                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                      SizeChanged="OnListSizeChanged">
<ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource ListItemRowTallStyle}" TargetType="ListViewItem"/>
                        </ListView.ItemContainerStyle>
                                <ListView.View>
                                    <GridView ColumnHeaderContainerStyle="{StaticResource AppListHeader}">
                                        <GridViewColumn Width="36">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox Style="{StaticResource ThemedCheckBox}" 
                                                              IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                              VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="名称">
                                                                               <GridViewColumn.HeaderTemplate>
                                                                                   <DataTemplate>
                                                                                       <TextBlock Text="名称" TextAlignment="Center"
                                                                                                  MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=GridViewColumnHeader}}"/>
                                                                                   </DataTemplate>
                                                                               </GridViewColumn.HeaderTemplate>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Border Width="20" Height="20" CornerRadius="{DynamicResource Radius_Control}"
                                                                Background="{StaticResource Brush_AccentSoft}">
                                                            <TextBlock Text="{Binding Initial}" FontSize="{DynamicResource Font_SizeNano}" FontWeight="Bold"
                                                                       Foreground="{StaticResource Brush_Accent}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold" Margin="8,0,0,0"
                                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="已装版本" Width="130">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding VersionText}" FontSize="{DynamicResource Font_SizeBody}"
                                                               FontFamily="{StaticResource Font_Mono}" TextAlignment="Center"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" Width="120"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="来源" Width="80">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Model.Source}" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{StaticResource Brush_TextMuted}" HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="状态" Width="150">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource StatusTagBorder}" HorizontalAlignment="Center">
                                                        <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource StatusTagText}"/>
                                                    </Border>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="操作" Width="330">
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <!-- 2026-09-07 用户拍板：恢复固定四按钮（按状态显隐），与商店 Tab 同序 -->
                                                        <Button Style="{StaticResource RowActionButton}" Content="安装" Margin="0,0,8,0"
                                                                Visibility="{Binding IsInstallVisible}"
                                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource RowActionButton}" Content="升级" Margin="0,0,8,0"
                                                                Visibility="{Binding IsUpgradeVisible}"
                                                                Command="{Binding DataContext.UpgradeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource RowDangerButton}" Content="卸载" Margin="0,0,8,0"
                                                                Visibility="{Binding IsUninstallVisible}"
                                                                Command="{Binding DataContext.UninstallCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                        <Button Style="{StaticResource RowActionButton}" Content="编辑"
                                                                Command="{Binding DataContext.EditSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                    </GridView>
                                </ListView.View>
                            </ListView>
                            
                            <!-- 空态提示 -->
                            <TextBlock Grid.Row="0" Text="暂无软件 · 点击'+添加软件'或从商店导入" 
                                       Visibility="{Binding ThirdPartyView.Count, Converter={StaticResource ZeroToVis}}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush_TextMuted}" FontSize="{DynamicResource Font_SizeBodySm}"/>
                            
                            <!-- 手动软件区 -->
                            <StackPanel Grid.Row="1" Margin="12,8,12,10">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ManualSoftwares.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="手动维护的软件（下载链接 / 本地安装包）" FontSize="{DynamicResource Font_SizeCaption}"
                                           Style="{StaticResource MonoText}" Margin="0,0,0,4"/>
                                <ItemsControl ItemsSource="{Binding ManualSoftwares}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush_Track}" BorderThickness="0,0,0,1"
                                                    Padding="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                               ToolTip="{Binding Description}"/>
                                                    <Button Grid.Column="1" Style="{StaticResource RowActionButton}" Content="下载"
                                                            Margin="0,0,8,0" Command="{Binding DataContext.DownloadCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="2" Style="{StaticResource RowActionButton}" Content="编辑"
                                                            Margin="0,0,8,0"
                                                            Command="{Binding DataContext.EditManualSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="3" Style="{StaticResource RowDangerButton}" Content="删除" Margin="0,0,8,0"
                                                            Command="{Binding DataContext.DeleteManualSoftwareCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Grid.Column="4" Style="{StaticResource RowActionButton}" Content="打开安装包"
                                                            Command="{Binding DataContext.OpenInstallerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 环境档案 Tab 内容（与软件列表互斥） -->
                <ScrollViewer x:Name="ArchivesPanel" Visibility="Collapsed"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Archives}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBorder}" Width="230" Margin="0,0,12,12">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold"
                                                   Foreground="{StaticResource Brush_TextPrimary}"/>
                                        <TextBlock FontSize="{DynamicResource Font_SizeCaption}" Style="{StaticResource MonoText}" Margin="0,3,0,8">
                                            <Run Text="{Binding Count, Mode=OneWay}"/><Run Text=" 个软件"/>
                                        </TextBlock>
                                        <Button Content="恢复此环境" Height="32" FontSize="{DynamicResource Font_SizeBodySm}"
                                                Background="{StaticResource Brush_Accent}" Foreground="{StaticResource Brush_OnDark}"
                                                BorderThickness="0" Cursor="Hand" HorizontalAlignment="Left" Padding="10,0"
                                                Command="{Binding DataContext.RestoreEnvironmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ============ 批量操作栏（M-UI-2 落地 2026-09-05：
             · SelectedCount==0 时整条淡出（DataTrigger Collapsed）
             · 新增「批量升级」/「批量卸载」入口（VM 命令已加，串行 winget 流水线留 V0.x 后续补）
             · 视觉：深底白字、强对比、与"导出报告"等主色操作形成层次） ============ -->
        <Border Grid.Row="4" Background="{StaticResource Brush_DarkSurface}" CornerRadius="{DynamicResource Radius_Card}"
                Padding="14,10" Margin="0,10,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <!-- SelectedCount==0 时整条折叠（VM IsBatchBarVisible 同步触发，但本控件用
                             DataTrigger 兜底：未触发 IsBatchBarVisible 通知前也能正确折叠） -->
                        <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="{DynamicResource Font_SizeBody}" FontWeight="Bold" Foreground="{StaticResource Brush_OnDark}" VerticalAlignment="Center">
                    <Run Text="已选 "/><Run Text="{Binding SelectedCount, Mode=OneWay}"/><Run Text=" 项"/>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="批量安装逐项执行 · 可取消 · 失败项标注原因（关闭窗口即停止后续项）"
                           FontSize="{DynamicResource Font_SizeCaption}" Foreground="{StaticResource Brush_OnDarkMuted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                <!-- M-UI-2：新增批量升级/卸载入口（VM 命令占位，逻辑后续 V0.x 补） -->
                <Button Grid.Column="2" Content="批量升级" MinWidth="72" Height="32" Padding="12,0" Margin="8,0,0,0"
                        Background="Transparent" BorderBrush="{StaticResource Brush_Success}" BorderThickness="1"
                        Foreground="{StaticResource Brush_Success}" FontWeight="Bold" FontSize="{DynamicResource Font_SizeCaption}" Cursor="Hand"
                        Command="{Binding BatchUpgradeSelectedCommand}"/>
                <Button Grid.Column="3" Content="批量卸载" MinWidth="72" Height="32" Padding="12,0" Margin="8,0,0,0"
                        Background="Transparent" BorderBrush="{StaticResource Brush_Danger}" BorderThickness="1"
                        Foreground="{StaticResource Brush_Danger}" FontWeight="Bold" FontSize="{DynamicResource Font_SizeCaption}" Cursor="Hand"
                        Command="{Binding BatchUninstallSelectedCommand}"/>
                <Button Grid.Column="4" Style="{StaticResource RowActionButton}" Content="清空选择" Margin="8,0,0,0"
                        Command="{Binding ClearSelectionCommand}" Background="{StaticResource Brush_OnDark}"
                        BorderThickness="0" Foreground="{StaticResource Brush_DarkSurface}"/>
                <Button Grid.Column="5" Height="32" MinWidth="72" Padding="10,0" FontSize="{DynamicResource Font_SizeCaption}" Content="批量安装"
                        Background="{StaticResource Brush_Accent}" Foreground="{StaticResource Brush_OnDark}"
                        BorderThickness="0" Cursor="Hand" Margin="8,0,0,0"
                        Command="{Binding BatchInstallCommand}"/>
            </Grid>
        </Border>

        <!-- ============ 操作日志 ============ -->
        <Expander Grid.Row="5" Header="操作日志" FontSize="{DynamicResource Font_SizeCaption}" Foreground="{StaticResource Brush_TextMuted}"
                  Margin="0,0,0,10" IsExpanded="False">
            <Border Style="{StaticResource CardBorder}" Padding="8" MaxHeight="140">
                <ListBox ItemsSource="{Binding LogLines}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontFamily="{StaticResource Font_Mono}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="2,1"/>
                            <Setter Property="IsTabStop" Value="False"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Text}" FontSize="{DynamicResource Font_SizeCaption}" Foreground="{Binding Color}"
                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Expander>

        <!-- winget 源内搜索浮层：锚定搜索框（右对齐），弹在其正下方 -->
        <Popup x:Name="SearchPopup" IsOpen="{Binding IsSearchPopupOpen, Mode=TwoWay}"
               PlacementTarget="{Binding ElementName=SearchHost}" Placement="Bottom"
               HorizontalOffset="-100" StaysOpen="False" Width="420" MaxHeight="320" AllowsTransparency="True">
            <Border Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius_CardSm}" Padding="8">
                <StackPanel>
                    <TextBlock Text="winget 源搜索结果（点击安装并加入清单）" FontSize="{DynamicResource Font_SizeNano}"
                               Style="{StaticResource MonoText}" Margin="4,0,0,6"/>
                    <ListBox ItemsSource="{Binding SearchResults}" MaxHeight="240" BorderThickness="0"
                             Background="Transparent" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Brush_Track}" BorderThickness="0,0,0,1" Padding="4,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource Font_SizeTiny}" FontWeight="SemiBold"/>
                                            <TextBlock FontSize="{DynamicResource Font_SizeNano}" Style="{StaticResource MonoText}">
                                                <Run Text="{Binding Id, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Version, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource RowPrimaryButton}" Content="安装"
                                                Command="{Binding DataContext.InstallSearchResultCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Content="关闭" Style="{StaticResource RowActionButton}" Width="60" Margin="0,6,0,0"
                            HorizontalAlignment="Right" Command="{Binding CloseSearchCommand}"/>
                </StackPanel>
            </Border>
        </Popup>

        <!-- 软件源下拉浮层 -->
        <Popup x:Name="SourcePopup" PlacementTarget="{Binding ElementName=SourceMenuButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_Border}"
                    BorderThickness="1" CornerRadius="{DynamicResource Radius_CardSm}" Padding="6" Width="200" Margin="0,4,0,0">
                <StackPanel>
                    <Button Content="⟳ 更新软件源" Style="{StaticResource RowActionButton}" Height="24"
                            HorizontalContentAlignment="Left" Padding="10,0"
                            Command="{Binding UpdateSourceCommand}" Click="OnSourceMenuItemClick"/>
                    <Button Content="切换中科大镜像源" Style="{StaticResource RowPrimaryButton}" Height="24"
                            HorizontalContentAlignment="Left" Padding="10,0" Margin="0,4,0,0"
                            Command="{Binding SwitchToMirrorCommand}" Click="OnSourceMenuItemClick"/>
                    <Button Content="恢复官方源" Style="{StaticResource RowActionButton}" Height="24"
                            HorizontalContentAlignment="Left" Padding="10,0" Margin="0,4,0,0"
                            Command="{Binding RestoreOfficialSourceCommand}" Click="OnSourceMenuItemClick"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
