<Window x:Class="SystemToolkit.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SystemToolkit.Shell"
        Title="SystemToolkit"
        Width="1280" Height="800"
        MinWidth="1240" MinHeight="640"
        MaxWidth="1920" MaxHeight="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        FontFamily="{DynamicResource Font_Body}">
    <Grid Background="{DynamicResource Brush_Background}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航（用户 2026-09-04：按仪表盘风格重做） ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush_SurfaceAlt}">
            <DockPanel>
                <!-- 品牌区 -->
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource Radius_LG}"
                                Background="{DynamicResource Brush_DarkSurface}">
                            <TextBlock Text="St" FontSize="{DynamicResource Font_SizeTiny}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush_OnDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SystemToolkit" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush_TextPrimary}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ToolkitVersionText" Text="DESKTOP TOOLKIT" FontSize="{DynamicResource Font_SizeMicro}"
                               Style="{DynamicResource MonoText}" Margin="0,6,0,0"/>
                </StackPanel>

                <Line DockPanel.Dock="Top" X1="0" X2="1" Y1="0" Y2="0"
                      Stroke="{DynamicResource Brush_Border}" Margin="14,0"/>

                <!-- 版本脚注 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,12">
                    <Line X1="0" X2="1" Y1="0" Y2="0"
                          Stroke="{DynamicResource Brush_Border}" Margin="0,0,0,10"/>
                    <TextBlock Text="非商业开源 · GPL-3.0" FontSize="{DynamicResource Font_SizeMicro}" Style="{DynamicResource MonoText}"/>
                </StackPanel>

                <!-- 导航项（UI 审计采纳：分组层级 + 图标文字收紧） -->
                <ListBox x:Name="NavList"
                         BorderThickness="0" Background="Transparent"
                         Padding="8,6" Margin="0,6,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <!-- 模块项：图标 + 文字（间距 7px，审计建议收紧） -->
                        <DataTemplate DataType="{x:Type local:NavItem}">
                            <StackPanel Orientation="Horizontal" Height="34"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                <!-- 矢量图标优先（Icons.xaml）：不依赖系统字体；缺失时回退字形。
                                     ⚠️ 默认可见性必须写在 Style 的 Setter 里——
                                     直接写属性（本地值）优先级高于触发器，触发器会失效 -->
                                <Path Data="{Binding IconData, Mode=OneWay}"
                                      Width="{DynamicResource Icon_SizeNav}" Height="{DynamicResource Icon_SizeNav}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush_TextPrimary}"
                                      StrokeThickness="{DynamicResource Icon_Stroke}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="{DynamicResource Font_SizeTitleLg}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font_SizeTitle}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                        <!-- 组头：小号 mono 大写标签，不可选中 -->
                        <DataTemplate DataType="{x:Type local:NavGroupHeader}">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font_SizeNano}"
                                       Style="{DynamicResource MonoText}"
                                       Margin="14,8,0,2"/>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Radius_MD}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="Indicator" Width="3" RadiusX="1.5" RadiusY="1.5"
                                                           Fill="{DynamicResource Brush_Accent}"
                                                           Margin="-15,0,6,0" Visibility="Collapsed"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush_Track}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush_Accent}"/>
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- 属性元素必须位于内容（Setters）之后（MC3088） -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 页面宿主 -->
        <!-- 内容列（09-11 微调）：胶囊占独立行（Auto，无曲目时收为 0），不再悬浮遮页头 -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ════════ MUSIC-7 迷你播放器（2026-09-11 用户改版：顶部居中胶囊 + 封面）════════
                 DataContext=IPlaybackBarSource（代码注入）；音乐模块禁用时解析为 null、
                 无当前曲目时 HasTrack=false——两种情况整体 Collapsed，本行自动收起。
                 定位 seek 与音量留在播放器页：胶囊只承载 封面/标题/播控/时间 -->
            <Border x:Name="PlaybackBar" Grid.Row="0"
                    HorizontalAlignment="Center" Margin="{DynamicResource Space_XS}"
                    Height="40" Background="{DynamicResource Brush_Surface}"
                    BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1"
                    CornerRadius="{DynamicResource Radius_LG}" Padding="{DynamicResource Space_SM}"
                    Visibility="Collapsed">
                <Border.Resources>
                    <Style x:Key="BarButton" TargetType="Button">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                        <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="MinWidth" Value="24"/>
                        <Setter Property="MinHeight" Value="24"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius_MD}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource Brush_Track}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- 主播放键：圆形主色 -->
                    <Style x:Key="BarPlayButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
                        <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                        <Setter Property="MinWidth" Value="26"/>
                        <Setter Property="MinHeight" Value="26"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{DynamicResource Brush_Accent}" CornerRadius="{DynamicResource Radius_Pill}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.9"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <!-- 播放/暂停 glyph 互斥显隐（无转换器） -->
                    <Style x:Key="GlyphWhilePlaying" TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                    <Style x:Key="GlyphWhileIdle" TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 封面 + 标题：点击跳音乐页（09-11 用户改版要求封面图） -->
                    <StackPanel Orientation="Horizontal" Background="Transparent" Cursor="Hand"
                                ToolTip="跳到音乐管理" MouseLeftButtonUp="PlaybackMeta_Click">
                        <Grid Width="28" Height="28" Margin="{DynamicResource Space_XXS}">
                            <Border Background="{DynamicResource Brush_SurfaceAlt}" CornerRadius="{DynamicResource Radius_Pill}">
                                <TextBlock Text="♪" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{DynamicResource Brush_TextSecondary}"/>
                            </Border>
                            <!-- 圆形封面（与占位同形态）；RadiusX/Y 非棘轮扫描维度 -->
                            <Image Source="{Binding Cover, Mode=OneWay}" Stretch="UniformToFill"
                                   Width="28" Height="28">
                                <Image.Clip>
                                    <EllipseGeometry Center="14,14" RadiusX="14" RadiusY="14"/>
                                </Image.Clip>
                            </Image>
                        </Grid>
                        <StackPanel VerticalAlignment="Center" MaxWidth="220" Margin="{DynamicResource Space_XXS}">
                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBodySm}"
                                       FontWeight="SemiBold" Foreground="{DynamicResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Title, Mode=OneWay}"/>
                            <TextBlock Text="{Binding Subtitle, Mode=OneWay}" FontSize="{DynamicResource Font_SizeNano}"
                                       Foreground="{DynamicResource Brush_TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- 播控三键 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Space_XXS}">
                        <Button Style="{StaticResource BarButton}" Command="{Binding PreviousTrackCommand}"
                                Content="&#xE892;" ToolTip="上一首"/>
                        <Button Style="{StaticResource BarPlayButton}" Command="{Binding TogglePlayCommand}"
                                ToolTip="播放 / 暂停" Margin="{DynamicResource Space_XXS}">
                            <Grid>
                                <TextBlock Text="&#xE769;" Style="{StaticResource GlyphWhilePlaying}"/>
                                <TextBlock Text="&#xE768;" Style="{StaticResource GlyphWhileIdle}"/>
                            </Grid>
                        </Button>
                        <Button Style="{StaticResource BarButton}" Command="{Binding NextTrackCommand}"
                                Content="&#xE893;" ToolTip="下一首"/>
                    </StackPanel>

                    <!-- 时间（等宽走 Font_Mono 令牌——09-11 一炸教训：MonoText 样式不能挂面板） -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Space_XXS}">
                        <TextBlock Text="{Binding PositionText, Mode=OneWay}" FontFamily="{DynamicResource Font_Mono}"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " FontFamily="{DynamicResource Font_Mono}"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationText, Mode=OneWay}" FontFamily="{DynamicResource Font_Mono}"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl x:Name="PageHost" Grid.Row="1"/>
        </Grid>
    </Grid>
</Window>
