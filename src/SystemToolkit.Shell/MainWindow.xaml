<Window x:Class="SystemToolkit.Shell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SystemToolkit.Shell"
        Title="SystemToolkit"
        Width="1280" Height="800"
        MinWidth="1240" MinHeight="640"
        MaxWidth="1920" MaxHeight="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        FontFamily="{DynamicResource Font_Body}">
    <Grid Background="{DynamicResource Brush_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航（用户 2026-09-04：按仪表盘风格重做） ============ -->
        <Border Grid.Column="0" Background="{DynamicResource Brush_SurfaceAlt}">
            <DockPanel>
                <!-- 品牌区 -->
                <StackPanel DockPanel.Dock="Top" Margin="14,14,14,10">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="28" Height="28" CornerRadius="{DynamicResource Radius_LG}"
                                Background="{DynamicResource Brush_DarkSurface}">
                            <TextBlock Text="St" FontSize="{DynamicResource Font_SizeTiny}" FontWeight="Bold"
                                       Foreground="{DynamicResource Brush_OnDark}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="SystemToolkit" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold"
                                   Foreground="{DynamicResource Brush_TextPrimary}"
                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="ToolkitVersionText" Text="DESKTOP TOOLKIT" FontSize="{DynamicResource Font_SizeMicro}"
                               Style="{DynamicResource MonoText}" Margin="0,6,0,0"/>
                </StackPanel>

                <Line DockPanel.Dock="Top" X1="0" X2="1" Y1="0" Y2="0"
                      Stroke="{DynamicResource Brush_Border}" Margin="14,0"/>

                <!-- 版本脚注 -->
                <StackPanel DockPanel.Dock="Bottom" Margin="14,0,14,12">
                    <Line X1="0" X2="1" Y1="0" Y2="0"
                          Stroke="{DynamicResource Brush_Border}" Margin="0,0,0,10"/>
                    <TextBlock Text="非商业开源 · GPL-3.0" FontSize="{DynamicResource Font_SizeMicro}" Style="{DynamicResource MonoText}"/>
                </StackPanel>

                <!-- 导航项（UI 审计采纳：分组层级 + 图标文字收紧） -->
                <ListBox x:Name="NavList"
                         BorderThickness="0" Background="Transparent"
                         Padding="8,6" Margin="0,6,0,0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="NavList_SelectionChanged">
                    <ListBox.Resources>
                        <!-- 模块项：图标 + 文字（间距 7px，审计建议收紧） -->
                        <DataTemplate DataType="{x:Type local:NavItem}">
                            <StackPanel Orientation="Horizontal" Height="34"
                                        HorizontalAlignment="Center"
                                        AutomationProperties.Name="{Binding DisplayName}">
                                <!-- 矢量图标优先（Icons.xaml）：不依赖系统字体；缺失时回退字形。
                                     ⚠️ 默认可见性必须写在 Style 的 Setter 里——
                                     直接写属性（本地值）优先级高于触发器，触发器会失效 -->
                                <Path Data="{Binding IconData, Mode=OneWay}"
                                      Width="{DynamicResource Icon_SizeNav}" Height="{DynamicResource Icon_SizeNav}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush_TextPrimary}"
                                      StrokeThickness="{DynamicResource Icon_Stroke}"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="{DynamicResource Font_SizeTitleLg}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconData}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Text="{Binding DisplayName}" FontSize="{DynamicResource Font_SizeTitle}"
                                           VerticalAlignment="Center" Margin="7,0,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                        <!-- 组头：小号 mono 大写标签，不可选中 -->
                        <DataTemplate DataType="{x:Type local:NavGroupHeader}">
                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font_SizeNano}"
                                       Style="{DynamicResource MonoText}"
                                       Margin="14,8,0,2"/>
                        </DataTemplate>
                    </ListBox.Resources>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bg" Background="Transparent" CornerRadius="{DynamicResource Radius_MD}"
                                                Padding="{TemplateBinding Padding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="Indicator" Width="3" RadiusX="1.5" RadiusY="1.5"
                                                           Fill="{DynamicResource Brush_Accent}"
                                                           Margin="-15,0,6,0" Visibility="Collapsed"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush_Track}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Brush_Accent}"/>
                                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible"/>
                                                <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <!-- 属性元素必须位于内容（Setters）之后（MC3088） -->
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="IsHitTestVisible" Value="False"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 页面宿主 -->
        <ContentControl x:Name="PageHost" Grid.Column="1"/>

        <!-- ════════ MUSIC-7 底部迷你播放条（示意图 2026-09-11 批准）════════
             DataContext=IPlaybackBarSource（代码注入）；音乐模块禁用时解析为 null、
             无当前曲目时 HasTrack=false——两种情况整条 Collapsed 不占位 -->
        <Border x:Name="PlaybackBar" Grid.Row="1" Grid.ColumnSpan="2" Height="44"
                Background="{DynamicResource Brush_Surface}" BorderBrush="{DynamicResource Brush_Border}"
                BorderThickness="0,1,0,0" Visibility="Collapsed">
            <Border.Resources>
                <Style x:Key="BarButton" TargetType="Button">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Foreground" Value="{DynamicResource Brush_TextSecondary}"/>
                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
                    <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="MinWidth" Value="28"/>
                    <Setter Property="MinHeight" Value="28"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius_MD}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Brush_Track}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- 主播放键：30px 圆形主色 -->
                <Style x:Key="BarPlayButton" TargetType="Button" BasedOn="{StaticResource BarButton}">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_OnDark}"/>
                    <Setter Property="MinWidth" Value="30"/>
                    <Setter Property="MinHeight" Value="30"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource Brush_Accent}" CornerRadius="{DynamicResource Radius_Pill}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
                <!-- 曲名/时间行：随播放态显隐的 glyph（无转换器）-->
                <Style x:Key="GlyphWhilePlaying" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
                <Style x:Key="GlyphWhileIdle" TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Resources>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="320"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 顶缘 2px 定位线：点击 seek（拖动随 V1.1 打磨） -->
                <Grid Grid.ColumnSpan="3" Height="2" VerticalAlignment="Top" Cursor="Hand"
                      Background="{DynamicResource Brush_SliderTrack}" MouseLeftButtonUp="PlaybackSeek_Click">
                    <ProgressBar Height="2" BorderThickness="0" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}" Background="Transparent"
                                 Foreground="{DynamicResource Brush_Accent}" IsHitTestVisible="False"/>
                </Grid>

                <!-- 左：封面 + 曲名/艺术家，点击跳音乐页 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="{DynamicResource Space_XS}" Background="Transparent" Cursor="Hand"
                            ToolTip="跳到音乐管理" MouseLeftButtonUp="PlaybackMeta_Click">
                    <Grid Width="32" Height="32">
                        <Border Background="{DynamicResource Brush_SurfaceAlt}" CornerRadius="{DynamicResource Radius_SM}">
                            <TextBlock Text="♪" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush_TextSecondary}"/>
                        </Border>
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Grid>
                    <StackPanel VerticalAlignment="Center" Margin="{DynamicResource Space_XXS}">
                        <TextBlock Text="{Binding Title}" FontSize="{DynamicResource Font_SizeBodySm}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                        <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource Font_SizeNano}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                    </StackPanel>
                </StackPanel>

                <!-- 中：上一首 / 播放·暂停 / 下一首 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource BarButton}" Command="{Binding PreviousTrackCommand}"
                            Content="&#xE892;" ToolTip="上一首"/>
                    <Button Style="{StaticResource BarPlayButton}" Command="{Binding TogglePlayCommand}" ToolTip="播放 / 暂停" Margin="{DynamicResource Space_XXS}">
                        <Grid>
                            <TextBlock Text="&#xE769;" Style="{StaticResource GlyphWhilePlaying}"/>
                            <TextBlock Text="&#xE768;" Style="{StaticResource GlyphWhileIdle}"/>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource BarButton}" Command="{Binding NextTrackCommand}"
                            Content="&#xE893;" ToolTip="下一首"/>
                </StackPanel>

                <!-- 右：时间 + 音量 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Space_XS}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Style="{DynamicResource MonoText}">
                        <TextBlock Text="{Binding PositionText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text=" / " FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DurationText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Slider Width="72" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="{DynamicResource Space_XXS}"
                            Value="{Binding Volume, Mode=TwoWay}" IsMoveToPointEnabled="True" ToolTip="音量"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
