<UserControl x:Class="SystemToolkit.Modules.FileBackup.FileBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.FileBackup"
             xmlns:controls="clr-namespace:SystemToolkit.UI.Common.Controls;assembly=SystemToolkit.UI.Common"
             Background="{DynamicResource Brush_Background}">
    <!-- 2026-09-07 单屏改造（用户拍板，参考旧版单功能版截图）：
         原「备份规则 / 快照与恢复」两 Tab 合并为一屏——左规则列表、右所选规则快照表，
         选规则即见快照，不再来回切换；编辑表单迁至 RuleEditWindow 弹窗；
         新增「备份全部」（串行备份所有启用规则）。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:EnabledToBrushConverter x:Key="EnabledBrush"/>
        <local:InverseBoolConverter x:Key="Inverse"/>
        <!-- 快照表头（对齐 AppManagerView.AppListHeader 口径；页面级局部资源） -->
        <Style x:Key="SnapHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <!-- 快照状态徽章：成功绿 / 失败红 -->
        <Style x:Key="SnapStatusBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_MD}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
            <!-- 2026-09-11 用户反馈：内容行左右居中（原 Left） -->
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="失败">
                    <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapStatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding StatusText}" Value="失败">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 校验徽章：通过绿 / 失败红 / 未校验灰 -->
        <Style x:Key="SnapChecksumBadge" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_MD}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
            <!-- 2026-09-11 用户反馈：内容行左右居中（原 Left） -->
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChecksumText}" Value="通过">
                    <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChecksumText}" Value="失败">
                    <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="SnapChecksumText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ChecksumText}" Value="通过">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ChecksumText}" Value="失败">
                    <Setter Property="Foreground" Value="{DynamicResource Brush_Danger}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ 页头 + 顶部动作 ============ -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="文件备份" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                <TextBlock FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Margin="0,2,0,0">
                    <Run Text="BACKUP · 规则 "/><Run Text="{Binding Rules.Count, Mode=OneWay}"/><Run Text=" 条 · 快照 "/><Run Text="{Binding Snapshots.Count, Mode=OneWay}"/><Run Text=" 份"/>
                </TextBlock>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Style="{DynamicResource RowActionButton}" Height="32" Content="导入规则" Margin="0,0,6,0"
                        Command="{Binding ImportRulesCommand}"/>
                <Button Style="{DynamicResource RowActionButton}" Height="32" Content="导出规则" Margin="0,0,6,0"
                        Command="{Binding ExportRulesCommand}"/>
                <Button Style="{DynamicResource RowActionButton}" Height="32" Content="备份全部" Margin="0,0,6,0"
                        ToolTipService.ShowOnDisabled="True" ToolTip="按顺序备份所有已启用规则，逐项执行、可随时取消"
                        Command="{Binding BackupAllCommand}"/>
                <Button Style="{DynamicResource RowDangerButton}" Height="32" Content="恢复全部" Margin="0,0,8,0"
                        ToolTipService.ShowOnDisabled="True" ToolTip="按启用规则各自恢复最新快照，逐项执行；恢复前可选择冲突策略"
                        Command="{Binding RestoreAllCommand}"/>
                <Button Style="{DynamicResource RowPrimaryButton}" Height="32" Content="+ 新建规则"
                        Command="{Binding NewRuleCommand}"/>
            </StackPanel>
        </Grid>

        <!-- ============ 主区：左规则列表 + 右快照表 ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 规则列表 -->
            <Border Grid.Column="0" Style="{DynamicResource ToolCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="备份规则" Style="{DynamicResource CardTitle}"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource CardButton}" Content="刷新" Command="{Binding ReloadRulesCommand}"/>
                        </StackPanel>
                    </Grid>
                    <!-- 拖拽排序（2026-09-07 用户裁定替代上移/下移按钮）：事件逻辑见 code-behind -->
                    <Grid Grid.Row="1">
                    <!-- 2026-09-11 用户反馈：规则卡片宽度随内容长短不一 → HorizontalContentAlignment
                         让 ListBoxItem 拉伸，卡片统一铺满列表宽度（原为默认 Left，宽度随内容伸缩） -->
                    <ListBox x:Name="RuleList" Style="{DynamicResource ListLog}"
                             AllowDrop="True"
                             HorizontalContentAlignment="Stretch"
                             ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             PreviewMouseLeftButtonDown="RuleList_PreviewMouseLeftButtonDown"
                             MouseMove="RuleList_MouseMove"
                             DragOver="RuleList_DragOver"
                             DragLeave="RuleList_DragLeave"
                             Drop="RuleList_Drop">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- 2026-09-08 用户反馈：每条规则加边框 + 条目间距，增强区分（参考旧版卡片样式） -->
                                <Border Background="{DynamicResource Brush_Surface}"
                                        BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius_SM}" Padding="10,7"
                                        Margin="0,0,0,6"
                                        ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="300">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding RuleName}" FontSize="{DynamicResource Font_SizeBodySm}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                            <TextBlock Text="{Binding EnabledText}" FontSize="{DynamicResource Font_SizeMicro}" Margin="8,0,0,0"
                                                       Foreground="{Binding Enabled, Converter={StaticResource EnabledBrush}}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" FontSize="{DynamicResource Font_SizeMicro}"
                                                   Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Brush_TextMuted}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 拖拽插入指示线（旧版有此引导，P2 补齐）：DragOver 计算落点 Y，Drop/DragLeave 隐藏 -->
                    <Rectangle x:Name="DropIndicator" Height="2" IsHitTestVisible="False"
                               Fill="{DynamicResource Brush_Accent}" RadiusX="1" RadiusY="1"
                               VerticalAlignment="Top" HorizontalAlignment="Stretch"
                               Margin="2,0,8,0" Visibility="Collapsed" Panel.ZIndex="10"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Style="{DynamicResource RowActionButton}" Height="28" Content="编辑"
                                Command="{Binding EditRuleCommand}"/>
                        <Button Style="{DynamicResource RowActionButton}" Height="28" Content="停用/启用" Margin="6,0,0,0"
                                Command="{Binding ToggleEnableCommand}"/>
                        <Button Style="{DynamicResource RowDangerButton}" Height="28" Content="删除" Margin="6,0,0,0"
                                Command="{Binding DeleteRuleCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 快照（选中规则后展示） -->
            <Border Grid.Column="2" Style="{DynamicResource ToolCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{DynamicResource CardTitle}">
                                <Run Text="快照 · "/><Run Text="{Binding SelectedRule.RuleName, Mode=OneWay, FallbackValue='未选择规则'}"/>
                            </TextBlock>
                            <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"
                                       VerticalAlignment="Center" Margin="10,0,0,0">
                                <Run Text="共 "/><Run Text="{Binding Snapshots.Count, Mode=OneWay}"/><Run Text=" 个"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{DynamicResource RowPrimaryButton}" Height="28" Content="开始备份"
                                    Command="{Binding BackupNowCommand}"/>
                            <Button Style="{DynamicResource RowActionButton}" Height="28" Content="取消" Margin="6,0,0,0"
                                    Command="{Binding CancelBackupCommand}"/>
                            <Button Style="{DynamicResource CardButton}" Content="打开目录" Margin="6,0,0,0" Command="{Binding OpenSnapshotDirCommand}"/>
                            <Button Style="{DynamicResource CardButton}" Content="校验" Margin="6,0,0,0"
                                    ToolTip="重算快照文件哈希并与清单比对，校验结果更新到「校验」列徽章"
                                    Command="{Binding VerifySnapshotCommand}"/>
                            <Button Style="{DynamicResource CardButton}" Content="刷新" Margin="6,0,0,0" Command="{Binding ReloadSnapshotsCommand}"/>
                            <Button Style="{DynamicResource CardButton}" Content="恢复…" Margin="6,0,0,0" Command="{Binding RestoreSnapshotCommand}"/>
                            <Button Style="{DynamicResource RowDangerButton}" Height="28" Content="删除" Margin="6,0,0,0"
                                    Command="{Binding DeleteSnapshotCommand}"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <ListView ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}"
                            controls:GridViewColumnSizing.AutoFillLastColumn="True"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  BorderThickness="0" Background="Transparent"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <!-- 2026-09-08 用户反馈：行高过低，加高至 44 并垂直居中 -->
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="MinHeight" Value="44"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView ColumnHeaderContainerStyle="{StaticResource SnapHeader}">
                                <GridViewColumn Header="快照时间" Width="150">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayTime}" FontSize="{DynamicResource Font_SizeBodySm}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="文件数" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FileCount}" FontSize="{DynamicResource Font_SizeMicro}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="大小" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeText}" FontSize="{DynamicResource Font_SizeMicro}"
                                                       Foreground="{DynamicResource Brush_TextSecondary}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="状态" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SnapStatusBadge}">
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource SnapStatusText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="校验" Width="76">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource SnapChecksumBadge}">
                                                <TextBlock Text="{Binding ChecksumText}" Style="{StaticResource SnapChecksumText}"/>
                                            </Border>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="路径" Width="270">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DisplayPath}" FontSize="{DynamicResource Font_SizeMicro}"
                                                       Foreground="{DynamicResource Brush_Accent}" TextTrimming="CharacterEllipsis"
                                                       HorizontalAlignment="Center"
                                                       ToolTip="{Binding BackupPath}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                        <!-- 空态覆盖层（不用 Template 替换：显式 Style 会丢主题默认 ListView 模板） -->
                        <Border Background="{DynamicResource Brush_Background}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Snapshots.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="还没有备份快照" Foreground="{DynamicResource Brush_TextMuted}"/>
                                <TextBlock Text="选择左侧规则后，点「开始备份」即产生第一份快照"
                                           FontSize="{DynamicResource Font_SizeMicro}"
                                           Foreground="{DynamicResource Brush_TextMuted}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,8,0,0"
                                Visibility="{Binding HasProgress, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{Binding ProgressValue, Mode=OneWay}" Maximum="100" Height="8"/>
                        <TextBlock Text="{Binding ProgressText}" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{DynamicResource Brush_TextSecondary}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ 底部操作日志 ============ -->
        <Border Grid.Row="2" Margin="0,14,0,0" BorderBrush="{DynamicResource Brush_Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,8,0,6">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="LogToggle" IsChecked="True" Content="▾ 操作日志" FontSize="{DynamicResource Font_SizeBodySm}"
                                      Checked="OnLogToggleChanged" Unchecked="OnLogToggleChanged"
                                      Foreground="{DynamicResource Brush_TextSecondary}" Background="Transparent" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Run Text="{Binding LogLines.Count, Mode=OneWay}"/><Run Text=" 行"/>
                        </TextBlock>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{DynamicResource CardButton}" Content="清空" Command="{Binding ClearLogCommand}"/>
                </Grid>
                <Border Grid.Row="1" x:Name="LogHost" Background="{DynamicResource Brush_DarkSurface}"
                        CornerRadius="{DynamicResource Radius_LG}" Padding="10,6" MaxHeight="160">
                    <ListBox Style="{DynamicResource ListLog}" ItemsSource="{Binding LogLines}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" FontFamily="{DynamicResource Font_Mono}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Color}" TextWrapping="NoWrap" FontSize="{DynamicResource Font_SizeMicro}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
