<UserControl x:Class="SystemToolkit.Modules.MusicManager.MusicManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.MusicManager"
             Background="{StaticResource Brush_Background}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <!-- 2026-09-08 用户拍板布局（替代三 Tab，解操作割裂）：
         顶部搜索+扫描 / 左栏曲库 / 右栏歌词 / 底部常驻播放条 / 点播放条进完整播放器覆盖层。 -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="Inverse"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyToVis"/>
        <local:StringEqualsToVisibilityConverter x:Key="StrEqToVis"/>
        <!-- 音量图标（审查 P0-1）：喇叭 + 0/1/2 道声波，静音态多一道斜杠 -->
        <Geometry x:Key="IconVolumeHigh">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,8.5 A4.5,4.5 0 0 1 16,15.5 M18.5,6 A8,8 0 0 1 18.5,18</Geometry>
        <Geometry x:Key="IconVolumeLow">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,9.5 A3,3 0 0 1 16,14.5</Geometry>
        <Geometry x:Key="IconVolumeMuted">M4,9 H8 L13,5 V19 L8,15 H4 Z M17,9.5 L21.5,14 M21.5,9.5 L17,14</Geometry>
        <!-- 列表空态提示样式（审查 P0-2）：统一文案外观，避免每处内联重复 -->
        <Style x:Key="ListEmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 区域级加载提示（审查 P0-3） -->
        <Style x:Key="InlineLoadingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 图标库（2026-09-09 全量图标化：Path 几何集中声明，按钮经 {StaticResource} 引用） -->
        <Geometry x:Key="IconBack">M14,6 L8,12 L14,18</Geometry>
        <Geometry x:Key="IconPlaySolid">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IconPauseBars">M7,5 H10 V19 H7 Z M14,5 H17 V19 H14 Z</Geometry>
        <Geometry x:Key="IconPrev">M6,6 H8 V18 H6 Z M20,6 L9,12 L20,18 Z</Geometry>
        <Geometry x:Key="IconNext">M18,6 H16 V18 H18 Z M4,6 L15,12 L4,18 Z</Geometry>
        <Geometry x:Key="IconLoop">M17,2 L21,6 L17,10 M21,6 H8 A5,5 0 0 0 3,11 M7,22 L3,18 L7,14 M3,18 H16 A5,5 0 0 0 21,13</Geometry>
        <Geometry x:Key="IconRefresh">M21,12 A9,9 0 1 1 18.36,5.64 M21,3 V9 H15</Geometry>
        <Geometry x:Key="IconNote">M9,3 V13.55 A4,4 0 1 0 11,17 V7 H17 V3 Z</Geometry>
        <Geometry x:Key="IconExpandUp">M7,14 L12,9 L17,14</Geometry>
        <Geometry x:Key="IconFolderScan">M3,7 V19 A2,2 0 0 0 5,21 H19 A2,2 0 0 0 21,19 V9 A2,2 0 0 0 19,7 H12 L10,5 H5 A2,2 0 0 0 3,7 Z</Geometry>
        <Geometry x:Key="IconEqSliders">M5,8 H19 M5,16 H19 M9,5.5 A2.5,2.5 0 1 1 9,10.5 A2.5,2.5 0 1 1 9,5.5 M15,13.5 A2.5,2.5 0 1 1 15,18.5 A2.5,2.5 0 1 1 15,13.5</Geometry>
        <!-- 2026-09-09 修复"进度条被底色吞掉"：默认 Slider 轨道为主题底色，压在播放器染色背景上隐形（只剩滑块）。
             自绘模板：剩余轨道半透明灰 + 已播段强调色 + 白色圆形滑块——浅底/彩胶/沉浸/现代四背景通用 -->
        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="14">
                            <Border Height="4" CornerRadius="{DynamicResource Radius_Track}" Background="#26808080"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="{DynamicResource Radius_Track}"
                                                            Background="{StaticResource Brush_Accent}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题+计数 | 搜索 | 扫描 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="音乐管理"
                           FontSize="{DynamicResource Font_SizeDisplay}"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{Binding LibraryCountText}" Margin="12,4,0,0"
                           FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Height="32" Content="网易云" Padding="10,0"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="NetEase">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="NetEase">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Height="32" Content="QQ 音乐" Padding="10,0" Margin="4,0,0,0"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="QQMusic">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="QQMusic">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox x:Name="OnlineSearchBox" Text="{Binding OnlineSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Width="220" Padding="8,5" VerticalContentAlignment="Center" Margin="8,0,0,0"
                         KeyDown="OnOnlineSearchKeyDown"/>
                <Button Height="32" Content="搜索" Margin="6,0,0,0" Command="{Binding SearchOnlineCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchingOnline, Mode=OneWay}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 状态行 + 曲库降级警告（🔴 不静默：缓存损坏/剔除文件必须可见） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <Border Background="{StaticResource Brush_WarningSoft}" CornerRadius="{DynamicResource Radius_MD}"
                    Padding="10,6"
                    Visibility="{Binding LibraryWarning, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding LibraryWarning}" FontSize="{DynamicResource Font_SizeCaption}"
                           Foreground="{StaticResource Brush_Warning}"/>
            </Border>
            <TextBlock Text="{Binding ScanStatusText}" FontSize="{DynamicResource Font_SizeCaption}"
                       Foreground="{StaticResource Brush_TextMuted}"
                       Visibility="{Binding ScanStatusText, Converter={StaticResource StrToVis}}"/>
        </StackPanel>

        <!-- 主区：左卡（我的歌单胶囊+内容三态） / 右卡（每日推荐+推荐歌单+Up Next）
             2026-09-09 对照 NexBox 重排（用户批准示意）：卡片化 + 图标化 + 封面缩略图 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左卡：卡头（返回+标题+全部播放） / 我的歌单胶囊+登录芯片 / 内容三态 -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_LG}"
                    Padding="14,10,10,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding ClosePlaylistCommand}" ToolTip="返回上一层"
                                Visibility="{Binding IsLocalLibraryView, Converter={StaticResource InverseToVis}}">
                            <Path Data="{StaticResource IconBack}" StrokeLineJoin="Round"
                                  Stroke="{StaticResource Brush_TextPrimary}" StrokeThickness="2"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding ViewTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeTitleLg}"
                                   Foreground="{StaticResource Brush_TextPrimary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Height="28" Padding="10,0" Content="全部播放" Margin="8,0,0,0"
                                Command="{Binding PlayPlaylistFromStartCommand}"
                                Visibility="{Binding IsPlaylistDetailView, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}"/>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 我的歌单胶囊行 + 登录芯片（原左栏列表横向化，2026-09-09 用户批准示意） -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ListBox Grid.Column="0" x:Name="PlaylistList" ItemsSource="{Binding UserPlaylists}"
                                 SelectionChanged="OnPlaylistListSelection"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Pill" Margin="0,0,6,0" Padding="10,4"
                                                        CornerRadius="{DynamicResource Radius_Pill}"
                                                        Background="{StaticResource Brush_SurfaceAlt}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Pill" Property="Background"
                                                                Value="{StaticResource Brush_AccentSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextPrimary}"/>
                                        <TextBlock Text="{Binding CountText, Mode=OneWay}" Margin="6,0,0,0"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                            <Button Width="24" Height="24" Padding="0" Margin="0,0,8,0"
                                    Background="Transparent" BorderThickness="0"
                                    Command="{Binding LoadPlaylistsCommand}" ToolTip="刷新歌单">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLoadingPlaylists, Mode=OneWay}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <Path Data="{StaticResource IconRefresh}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.8"
                                      Width="14" Height="14" Stretch="Uniform"/>
                            </Button>
                            <!-- 审查 P0-3：加载指示（与上方刷新钮联动同一标志） -->
                            <TextBlock Style="{StaticResource InlineLoadingHint}" Text="加载歌单中…" Margin="0,0,8,0"
                                       Visibility="{Binding IsLoadingPlaylists, Converter={StaticResource BoolToVis}}"/>
                            <Border Margin="0,0,6,0" Padding="8,3" CornerRadius="{DynamicResource Radius_Pill}"
                                    Background="{StaticResource Brush_SurfaceAlt}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding NetEaseLoginText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                    <Button Content="登录" Height="20" Padding="6,0" Margin="6,0,0,0"
                                            Command="{Binding RequestLoginCommand}" CommandParameter="NetEase">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}"/>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border Padding="8,3" CornerRadius="{DynamicResource Radius_Pill}" Background="{StaticResource Brush_SurfaceAlt}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding QqLoginText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                    <Button Content="登录" Height="20" Padding="6,0" Margin="6,0,0,0"
                                            Command="{Binding RequestLoginCommand}" CommandParameter="QQMusic">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}"/>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- 内容三态（视图状态机沿用，宿主由中栏改为左卡剩余区） -->
                    <Grid>
                <!-- 态① 本地曲库 -->
                <DockPanel Visibility="{Binding IsLocalLibraryView, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Padding="8,5" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Height="30" Content="扫描曲库" Margin="0,0,6,0" Command="{Binding ScanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource RowActionButton}" Height="30" Content="取消"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Grid>
                    <ListBox ItemsSource="{Binding SongsView}"
                             SelectedItem="{Binding SelectedSong, Mode=OneWayToSource}"
                             MouseDoubleClick="OnSongListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 本地曲：音符占位（内嵌封面逐行解析开销大，缩略图仅在线行装载） -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="15" Height="15" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeBody}"
                                                   Foreground="{StaticResource Brush_TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 审查 P0-2：空态提示（过滤无结果也算空；Songs 为源集合，SongsView 无 Count） -->
                    <TextBlock Style="{StaticResource ListEmptyHint}"
                               Visibility="{Binding SongsView.IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="曲库为空或没有匹配的曲目 — 点击上方「扫描曲库」导入本地音乐"/>
                    </Grid>
                </DockPanel>

                <!-- 态② 在线搜索结果 -->
                <DockPanel Visibility="{Binding IsOnlineSearchView, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OnlineStatusText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="2,0,0,6"
                               Visibility="{Binding OnlineStatusText, Converter={StaticResource StrToVis}}"/>
                    <!-- 审查 P0-3：区域级加载指示（原先只置灰按钮，用户看不出在进行） -->
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource InlineLoadingHint}"
                               Text="搜索中…" Margin="2,0,0,6"
                               Visibility="{Binding IsSearchingOnline, Converter={StaticResource BoolToVis}}"/>
                    <!-- 审查 P0-2：空态（Dock=Bottom，Collapsed 时不占布局空间） -->
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ListEmptyHint}"
                               Text="暂无搜索结果 — 换个关键词，或检查登录态"
                               Visibility="{Binding SearchResults.Count, Converter={StaticResource EmptyToVis}}"/>
                    <ListBox x:Name="SearchResultList" ItemsSource="{Binding SearchResults}"
                             MouseDoubleClick="OnSearchListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Grid>
                                            <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                                  Width="15" Height="15" Stretch="Uniform"
                                                  Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                            <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontSize="{DynamicResource Font_SizeBody}"
                                                       Foreground="{StaticResource Brush_TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource Brush_AccentSoft}"
                                                    CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                                <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeCaption}"
                                                           Foreground="{StaticResource Brush_Accent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="4" Data="{StaticResource IconPlaySolid}"
                                          Fill="{StaticResource Brush_TextMuted}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,6,0"
                                          ToolTip="双击播放"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 态③ 歌单详情（标题/全部播放/返回已上移左卡卡头） -->
                <DockPanel Visibility="{Binding IsPlaylistDetailView, Converter={StaticResource BoolToVis}}">
                    <!-- 审查 P0-2：空态 -->
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ListEmptyHint}"
                               Text="该歌单暂无曲目（或加载失败，见状态行）"
                               Visibility="{Binding PlaylistTracks.Count, Converter={StaticResource EmptyToVis}}"/>
                    <ListBox x:Name="PlaylistTrackList" ItemsSource="{Binding PlaylistTracks}"
                             MouseDoubleClick="OnPlaylistTrackDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Grid>
                                            <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                                  Width="15" Height="15" Stretch="Uniform"
                                                  Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                            <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontSize="{DynamicResource Font_SizeBody}"
                                                       Foreground="{StaticResource Brush_TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource Brush_AccentSoft}"
                                                    CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                                <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeCaption}"
                                                           Foreground="{StaticResource Brush_Accent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                    <Path Grid.Column="4" Data="{StaticResource IconPlaySolid}"
                                          Fill="{StaticResource Brush_TextMuted}" Width="13" Height="13"
                                          Stretch="Uniform" VerticalAlignment="Center" Margin="2,0,6,0"
                                          ToolTip="双击播放"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            </DockPanel>
            </Border>

            <!-- 右卡：每日推荐 + 推荐歌单 + Up Next -->
            <Border Grid.Column="1"
                    Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_LG}"
                    Padding="14,10,14,8">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="每日推荐" FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                    <!-- 审查 P0-3：区域级加载指示 -->
                    <TextBlock Grid.Column="0" Style="{StaticResource InlineLoadingHint}" Text="加载推荐中…"
                               HorizontalAlignment="Right" Margin="0,0,8,0"
                               Visibility="{Binding IsLoadingRecommendations, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="1" Width="22" Height="22" Padding="0"
                            Command="{Binding LoadRecommendationsCommand}" ToolTip="刷新推荐">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingRecommendations, Mode=OneWay}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconRefresh}" StrokeLineJoin="Round"
                              Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.8"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" Style="{StaticResource ListEmptyHint}"
                           Text="暂无每日推荐 — 登录后才会生成（仅网易云支持）"
                           Visibility="{Binding DailyRecommend.Count, Converter={StaticResource EmptyToVis}}"/>
                <ListBox Grid.Row="2" x:Name="DailyRecommendList" ItemsSource="{Binding DailyRecommend}"
                         MouseDoubleClick="OnDailyRecommendDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34"
                                        CornerRadius="{DynamicResource Radius_MD}"
                                        Background="{StaticResource Brush_AccentSoft}">
                                    <Grid>
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                        <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="推荐歌单" FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextSecondary}" Margin="0,6,0,4"/>
                <TextBlock Grid.Row="4" Style="{StaticResource ListEmptyHint}"
                           Text="暂无推荐歌单（QQ 音乐不提供该接口）"
                           Visibility="{Binding RecommendedPlaylists.Count, Converter={StaticResource EmptyToVis}}"/>
                <ListBox Grid.Row="4" x:Name="RecommendedPlaylistList" ItemsSource="{Binding RecommendedPlaylists}"
                         MouseDoubleClick="OnRecommendedPlaylistDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="40" Height="40"
                                        CornerRadius="{DynamicResource Radius_MD}"
                                        Background="{StaticResource Brush_AccentSoft}">
                                    <Grid>
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="14" Height="14" Stretch="Uniform"
                                              Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                        <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding CountText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="5" Text="Up Next" FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextSecondary}" Margin="0,6,0,4"/>
                <TextBlock Grid.Row="6" Style="{StaticResource ListEmptyHint}"
                           Text="队列为空 — 双击曲目即可加入"
                           Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVis}}"/>
                <ListBox Grid.Row="6" ItemsSource="{Binding UpNext}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,3">
                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeBodySm}"
                                           Foreground="{StaticResource Brush_TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Artist, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- 底部常驻播放条（2026-09-09 NexBox 风格重做：封面+曲名/艺人+中央圆形播放钮+右侧图标组+下缘进度；点击空白区展开完整播放器） -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="14,8,14,6"
                Background="{StaticResource Brush_Surface}"
                CornerRadius="{DynamicResource Radius_LG}"
                MouseLeftButtonDown="OnBottomBarTap">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 封面（在线曲异步加载/本地曲内嵌；无封面音符占位） -->
                    <Border Grid.Column="0" Width="46" Height="46"
                            Background="{StaticResource Brush_AccentSoft}" CornerRadius="{DynamicResource Radius_MD}">
                        <Grid>
                            <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                  Width="16" Height="16" Stretch="Uniform"
                                  Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                            <Image Source="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBody}"
                                   Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentSub, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding IsEngineReady}">
                        <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding PreviousCommand}" ToolTip="上一首">
                            <Path Data="{StaticResource IconPrev}" Fill="{StaticResource Brush_TextPrimary}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Width="36" Height="36" Padding="0" Margin="0,0,16,0"
                                Background="{StaticResource Brush_Accent}" BorderThickness="0"
                                Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                            <Grid>
                                <Path Data="{StaticResource IconPlaySolid}" Fill="{StaticResource Brush_Background}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource InverseToVis}}"/>
                                <Path Data="{StaticResource IconPauseBars}" Fill="{StaticResource Brush_Background}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding NextCommand}" ToolTip="下一首">
                            <Path Data="{StaticResource IconNext}" Fill="{StaticResource Brush_TextPrimary}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Width="32" Height="32" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeText, Mode=OneWay}">
                            <Path Data="{StaticResource IconLoop}" StrokeLineJoin="Round"
                                  Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                  Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Margin="0,0,10,0" Padding="7,2" CornerRadius="{DynamicResource Radius_MD}"
                                Background="{StaticResource Brush_SurfaceAlt}" VerticalAlignment="Center"
                                ToolTip="当前音质（完整播放器内可切换）">
                            <TextBlock Text="{Binding SelectedQualityText, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeCaption}"
                                       Foreground="{StaticResource Brush_TextSecondary}"/>
                        </Border>
                        <!-- 审查 P0-1：音量。左键弹出滑块（ContextMenu 只响应右键，故用 Popup） -->
                        <Button x:Name="VolumeButton" Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Click="OnVolumeButtonClick"
                                AutomationProperties.Name="音量"
                                ToolTip="音量（点击调节）">
                            <Grid>
                                <Path Data="{StaticResource IconVolumeHigh}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=high}"/>
                                <Path Data="{StaticResource IconVolumeLow}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=low}"/>
                                <Path Data="{StaticResource IconVolumeMuted}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_Warning}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=muted}"/>
                            </Grid>
                        </Button>
                        <Button Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding OpenFullPlayerCommand}" ToolTip="展开完整播放器">
                            <Path Data="{StaticResource IconExpandUp}" StrokeLineJoin="Round"
                                  Stroke="{StaticResource Brush_TextPrimary}" StrokeThickness="2"
                                  Width="14" Height="14" Stretch="Uniform"/>
                        </Button>
                        <TextBlock Text="播放引擎未就绪" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_Warning}"
                                   Visibility="{Binding IsEngineReady, Converter={StaticResource InverseToVis}}"/>
                    </StackPanel>
                    <!-- 音量弹出面板（审查 P0-1）：竖向滑块 + 静音切换，点外面自动收起 -->
                    <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}"
                           Placement="Top" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource Brush_Surface}"
                                BorderBrush="{StaticResource Brush_SurfaceAlt}" BorderThickness="1"
                                CornerRadius="{DynamicResource Radius_LG}" Padding="12,10"
                                Margin="0,0,0,6">
                            <StackPanel>
                                <Slider Minimum="0" Maximum="100" Orientation="Vertical"
                                        Width="{DynamicResource Slider_VerticalWidth}"
                                        Height="{DynamicResource Slider_VerticalHeight}"
                                        HorizontalAlignment="Center"
                                        Value="{Binding VolumePercent, Mode=TwoWay}"
                                        IsMoveToPointEnabled="True"
                                        AutomationProperties.Name="音量大小"/>
                                <Button Height="24" Padding="8,0" Margin="0,8,0,0"
                                        Command="{Binding ToggleMuteCommand}"
                                        AutomationProperties.Name="静音切换">
                                    <TextBlock Text="{Binding Muted, Mode=OneWay}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="静音"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Muted, Mode=OneWay}" Value="True">
                                                        <Setter Property="Text" Value="取消静音"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
                <Grid Grid.Row="1" Margin="2,4,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SeekSlider" Maximum="100" Style="{StaticResource SeekSliderStyle}"
                            Margin="8,0"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionDurationText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 完整播放器覆盖层（2026-09-08 参考网易云全屏播放器重设计；不显示队列——用户裁定） ═══ -->
        <Grid Grid.Row="0" Grid.RowSpan="4" ClipToBounds="True"
              Visibility="{Binding IsFullPlayerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 背景层（OM-6 三风格：主色派生三档——浅染/深染/中调；控制条/顶栏浮于其上） -->
            <Grid Grid.RowSpan="3">
                <Border Background="{Binding VinylBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}"/>
                <Border Background="{Binding ImmersionBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}"/>
                <Border Background="{Binding ModernBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- ① 顶栏：收起（左）+ 风格切换 / 音质菜单（右） -->
            <Grid Grid.Row="0">
                <Button HorizontalAlignment="Left" Margin="20,14,0,0"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding CloseFullPlayerCommand}" ToolTip="收起播放器">
                    <Path Data="M7,10 L13,16 L19,10" StrokeLineJoin="Round"
                          Stroke="{Binding PlayerForegroundBrush, Mode=OneWay}" StrokeThickness="2"/>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0">
                    <TextBlock Text="{Binding SelectedQualityText, Mode=OneWay}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerMutedBrush, Mode=OneWay}" Margin="0,0,10,0"/>
                    <Button Height="30" Padding="10,0" Content="彩胶" Margin="0,0,6,0"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Vinyl">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVinylStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Padding="10,0" Content="沉浸" Margin="0,0,6,0"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Immersion">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImmersionStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Padding="10,0" Content="现代"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Modern">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModernStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Width="40" Padding="0" Margin="8,0,0,0"
                            Command="{Binding ToggleEqPanelCommand}" ToolTip="均衡器">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEqPanelOpen, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconEqSliders}" StrokeLineJoin="Round"
                              Stroke="{Binding PlayerForegroundBrush, Mode=OneWay}" StrokeThickness="1.8"
                              Width="16" Height="16" Stretch="Uniform"/>
                    </Button>
                    <!-- 2026-09-09 修复：ContextMenu 只响应右键——左键经 Click 代码后置弹出（OnQualityMenuButtonClick） -->
                    <Button Height="30" Padding="10,0" Content="音质" Margin="8,0,0,0"
                            Click="OnQualityMenuButtonClick">
                        <Button.ContextMenu>
                            <!-- ContextMenu 独立可视树：命令/数据经 PlacementTarget 回主树（GameManager 同款套路） -->
                            <ContextMenu Style="{StaticResource ToolkitContextMenu}"
                                         DataContext="{Binding PlacementTarget.DataContext,
                                                         RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="母带" Command="{Binding SetQualityCommand}"
                                          CommandParameter="jymaster" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="Hi-Res" Command="{Binding SetQualityCommand}"
                                          CommandParameter="hires" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="无损" Command="{Binding SetQualityCommand}"
                                          CommandParameter="lossless" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="高品质" Command="{Binding SetQualityCommand}"
                                          CommandParameter="exhigh" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="标准" Command="{Binding SetQualityCommand}"
                                          CommandParameter="standard" Style="{StaticResource ToolkitMenuItem}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ② 内容层：三风格主视觉模板（共享 Row1，各按 Visibility 显隐） -->
            <Grid Grid.Row="1">
                <!-- 模板① 透明彩胶：左歌词流 + 右黑胶（2026-09-08 重设计布局原样保留，默认风格） -->
                <Grid Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <!-- 左：标题 / 艺术家 / 歌词流 -->
                <Grid Grid.Column="0" Margin="72,8,48,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CurrentTitle, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeTitleLg}"
                               Foreground="{StaticResource Brush_TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding CurrentSub, Mode=OneWay}"
                               Margin="0,8,0,20"
                               FontSize="{DynamicResource Font_SizeBody}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <ListBox Grid.Row="2" x:Name="FullLyricsList"
                             ItemsSource="{Binding LyricRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,12"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font_SizeBodyLg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center"
                               Text="{Binding LyricsHint, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextWrapping="Wrap"
                               Visibility="{Binding LyricsHint, Converter={StaticResource StrToVis}}"/>
                </Grid>

                <!-- 右：彩胶圆盘（右缘出血；主色环 + 封面圆心；播放时旋转——code-behind 控制） -->
                <Grid Grid.Column="1" x:Name="DiscHost" Width="540" Height="540"
                      Margin="0,-60,-170,-60" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="DiscRotation"/>
                    </Grid.RenderTransform>
                    <!-- 旋转控制经 code-behind（🔴 Style 的 DataTrigger 无法引用元素树 NameScope
                         中的 BeginStoryboardName——跨 NameScope 必抛 InvalidOperationException，
                         2026-09-08 真机实证） -->
                    <Ellipse Fill="{Binding CurrentAccentBrush, Mode=OneWay}"/>
                    <Ellipse Margin="26" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.35"/>
                    <Ellipse Margin="52" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.28"/>
                    <Ellipse Margin="78" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.4"/>
                    <Ellipse Margin="80" Fill="{StaticResource Brush_Surface}"/>
                    <Ellipse Margin="86">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Margin="86" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.5"/>
                </Grid>
                </Grid>

                <!-- 模板② 沉浸：深主色底（背景层承担）；仅中央当前句大字随曲滚动（对照截图） -->
                <Grid Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding CurrentLyricText, Mode=OneWay}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="720"
                               FontSize="{DynamicResource Font_SizeTitleLg}"
                               Foreground="{Binding PlayerForegroundBrush, Mode=OneWay}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLyricText, Mode=OneWay}" Value="">
                                        <Setter Property="Text" Value="♪"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 模板③ 现代：中调主色底（背景层承担）+ 左上歌曲信息卡 + 右侧歌词列表（对照截图） -->
                <Grid Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}">                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：歌曲信息卡（白卡：封面方图 + 歌名 + 艺术家 + 专辑） -->
                    <Border Grid.Column="0" Width="250" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Margin="56,24,0,0" CornerRadius="{DynamicResource Radius_LG}"
                            Background="{StaticResource Brush_Surface}" Padding="14">
                        <StackPanel>
                            <Border Height="220" CornerRadius="{DynamicResource Radius_MD}"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border Height="220" CornerRadius="{DynamicResource Radius_MD}"
                                    Background="{StaticResource Brush_SurfaceAlt}"
                                    Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}">
                                <TextBlock Text="无封面" FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" Margin="0,12,0,0"
                                       FontSize="{DynamicResource Font_SizeTitle}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentSub, Mode=OneWay}" Margin="0,6,0,0"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 右：歌词列表（当前行主色高亮） -->
                    <ListBox Grid.Column="1" x:Name="ModernLyricsList"
                             Margin="8,60,64,16"
                             ItemsSource="{Binding LyricRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,10"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="{DynamicResource Font_SizeBodyLg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
                <!-- OM-7 EQ 面板浮层（2026-09-09 浅色化融入主题：主题卡+预设填充胶囊高亮+dB 读数；顶栏 EQ 钮弹出/收起） -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                        Background="{StaticResource Brush_Surface}" BorderBrush="{StaticResource Brush_SurfaceAlt}"
                        BorderThickness="1" CornerRadius="{DynamicResource Radius_LG}"
                        Padding="16,10" Visibility="{Binding IsEqPanelOpen, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Height="24" Padding="10,0" Content="{Binding EqStateText, Mode=OneWay}"
                                    Command="{Binding ToggleEqCommand}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EqStateText, Mode=OneWay}" Value="均衡器 · 开">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="流行" Margin="10,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="流行">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="流行">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="摇滚" Margin="6,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="摇滚">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="摇滚">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="电子" Margin="6,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="电子">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="电子">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="古典" Margin="6,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="古典">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="古典">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="人声" Margin="6,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="人声">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="人声">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="重低音" Margin="6,0,0,0"
                                    Command="{Binding ApplyEqPresetCommand}" CommandParameter="重低音">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentPresetName, Mode=OneWay}" Value="重低音">
                                                <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                <Setter Property="Foreground" Value="{StaticResource Brush_Background}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Height="24" Padding="10,0" Content="归零" Margin="12,0,0,0"
                                    Style="{StaticResource RowActionButton}"
                                    Command="{Binding ResetEqCommand}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <!-- 前置增益 -->
                            <StackPanel Margin="4,0" Width="44">
                                <TextBlock Text="前置" FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextSecondary}"
                                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                <Slider Minimum="-12" Maximum="12" Value="{Binding PreampDb, Mode=TwoWay}"
                                        Orientation="Vertical" Height="120" HorizontalAlignment="Center"
                                        IsMoveToPointEnabled="True"/>
                                <TextBlock Text="dB" FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"
                                           HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                            <!-- 10 段 -->
                            <ItemsControl ItemsSource="{Binding EqBands}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,0" Width="44">
                                            <TextBlock Text="{Binding Label, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       Foreground="{StaticResource Brush_TextSecondary}"
                                                       HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <Slider Minimum="-12" Maximum="12" Value="{Binding Gain, Mode=TwoWay}"
                                                    Orientation="Vertical" Height="120" HorizontalAlignment="Center"
                                                    IsMoveToPointEnabled="True"/>
                                            <TextBlock Text="{Binding GainText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       Foreground="{StaticResource Brush_Accent}"
                                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding Frequency, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       Foreground="{StaticResource Brush_TextMuted}"
                                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ③ 底控制栏：模式 + 传输 + 分列进度（引擎未就绪整组禁用） -->
            <Grid Grid.Row="2" Margin="72,0,72,26" IsEnabled="{Binding IsEngineReady}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="44" Height="40" Margin="0,0,28,0" Padding="0"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding PreviousCommand}" ToolTip="上一首">
                        <Path Data="{StaticResource IconPrev}" Fill="{Binding PlayerForegroundBrush, Mode=OneWay}"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Width="56" Height="56" Padding="0"
                            Background="{StaticResource Brush_Accent}" BorderThickness="0"
                            Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                        <Grid>
                            <Path Fill="{StaticResource Brush_Background}" Data="{StaticResource IconPlaySolid}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseToVis}}"/>
                            <Path Fill="{StaticResource Brush_Background}" Data="{StaticResource IconPauseBars}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Width="44" Height="40" Margin="28,0,0,0" Padding="0"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding NextCommand}" ToolTip="下一首">
                        <Path Data="{StaticResource IconNext}" Fill="{Binding PlayerForegroundBrush, Mode=OneWay}"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                <Grid Grid.Row="1" Margin="40,16,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerMutedBrush, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="FullSeekSlider" Margin="16,0" Maximum="100"
                            Style="{StaticResource SeekSliderStyle}"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnFullSeekDragCompleted"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionDurationText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerMutedBrush, Mode=OneWay}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
