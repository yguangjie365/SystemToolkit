<UserControl x:Class="SystemToolkit.Modules.MusicManager.MusicManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.MusicManager"
             Background="{StaticResource Brush_Background}"
             Loaded="OnLoaded">
    <!-- 2026-09-08 用户拍板布局（替代三 Tab，解操作割裂）：
         顶部搜索+扫描 / 左栏曲库 / 右栏歌词 / 底部常驻播放条 / 点播放条进完整播放器覆盖层。 -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="Inverse"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题+计数 | 搜索 | 扫描 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="音乐管理"
                           FontSize="{DynamicResource Font_SizeDisplay}"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{Binding LibraryCountText}" Margin="12,4,0,0"
                           FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=OneWayToSource}"
                         Width="220" Padding="8,5" VerticalContentAlignment="Center"/>
                <Button Height="32" Content="扫描曲库" Margin="8,0,0,0" Command="{Binding ScanCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Style="{StaticResource RowActionButton}" Height="32" Content="取消" Margin="6,0,0,0"
                        Command="{Binding CancelScanCommand}"
                        Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Grid>

        <!-- 状态行：扫描状态 / 曲库降级警告 -->
        <StackPanel Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,180,2">
            <TextBlock Text="{Binding ScanStatusText}" FontSize="{DynamicResource Font_SizeCaption}"
                       Foreground="{StaticResource Brush_TextMuted}"
                       Visibility="{Binding ScanStatusText, Converter={StaticResource StrToVis}}"/>
        </StackPanel>

        <!-- 主区：左曲库 / 右歌词 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ListBox Grid.Column="0" ItemsSource="{Binding SongsView}"
                     SelectedItem="{Binding SelectedSong, Mode=OneWayToSource}"
                     MouseDoubleClick="OnSongListDoubleClick"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBody}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding Artist, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextMuted}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextMuted}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <ListBox x:Name="LyricsList" Grid.Column="2" ItemsSource="{Binding LyricRows}"
                     Background="Transparent" BorderThickness="0"
                     HorizontalContentAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Text, Mode=OneWay}" Padding="8,6"
                                   TextWrapping="Wrap" TextAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodyLg}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                            <Setter Property="FontSize" Value="{DynamicResource Font_SizeDisplay}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasLyrics, Converter={StaticResource InverseToVis}}">
                <TextBlock Text="未找到歌词" FontSize="{DynamicResource Font_SizeTitle}"
                           Foreground="{StaticResource Brush_TextMuted}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LyricsHint}" Margin="0,8,0,0"
                           FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 底部常驻播放条（点击空白区展开完整播放器） -->
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="12,8"
                Background="{StaticResource Brush_SurfaceAlt}"
                CornerRadius="{DynamicResource Radius_LG}"
                MouseLeftButtonDown="OnBottomBarTap">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="52" Height="52"
                        Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_MD}"/>
                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="{DynamicResource Font_SizeBody}"
                               Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentSub}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <Slider x:Name="SeekSlider" Maximum="100"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Height="18" Margin="0,4,0,0"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"/>
                    <TextBlock Text="{Binding PositionText}" FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="上一首" Margin="0,0,6,0"
                            Command="{Binding PreviousCommand}"/>
                    <Button Height="30" Margin="0,0,6,0" MinWidth="56"
                            Command="{Binding PlayPauseCommand}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="播放"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="暂停"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="下一首" Margin="0,0,6,0"
                            Command="{Binding NextCommand}"/>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Margin="0,0,6,0"
                            Command="{Binding ToggleModeCommand}">
                        <TextBlock Text="{Binding ModeText, Mode=OneWay}"/>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="展开"
                            Command="{Binding OpenFullPlayerCommand}"/>
                    <TextBlock Text="播放引擎未就绪" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_Warning}"
                               Visibility="{Binding IsEngineReady, Converter={StaticResource InverseToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 完整播放器覆盖层（点底部条展开；大封面 + 控制 + 队列） -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              Background="{StaticResource Brush_Background}"
              Visibility="{Binding IsFullPlayerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="0" Style="{StaticResource RowActionButton}" Height="30" Content="收起" Margin="16,12,16,0"
                    HorizontalAlignment="Left" Command="{Binding CloseFullPlayerCommand}"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="180" Height="180" Background="{StaticResource Brush_SurfaceAlt}"
                        CornerRadius="{DynamicResource Radius_LG}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding CurrentTitle}" Margin="0,16,0,0" TextAlignment="Center"
                           FontSize="{DynamicResource Font_SizeTitleLg}"
                           Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding CurrentSub}" Margin="0,6,0,0" TextAlignment="Center"
                           FontSize="{DynamicResource Font_SizeBody}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
                <Slider x:Name="FullSeekSlider" Maximum="100" Width="420" Margin="0,14,0,0"
                        Value="{Binding ProgressValue, Mode=OneWay}"
                        IsMoveToPointEnabled="True"
                        Thumb.DragStarted="OnSeekDragStarted"
                        Thumb.DragCompleted="OnFullSeekDragCompleted"/>
                <TextBlock Text="{Binding PositionText}" Margin="0,4,0,0" TextAlignment="Center"
                           FontSize="{DynamicResource Font_SizeCaption}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                    <Button Style="{StaticResource RowActionButton}" Height="32" Content="上一首" Margin="0,0,8,0"
                            Command="{Binding PreviousCommand}"/>
                    <Button Height="32" MinWidth="64" Margin="0,0,8,0" Command="{Binding PlayPauseCommand}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="播放"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="暂停"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Height="32" Content="下一首" Margin="0,0,8,0"
                            Command="{Binding NextCommand}"/>
                    <Button Style="{StaticResource RowActionButton}" Height="32" Command="{Binding ToggleModeCommand}">
                        <TextBlock Text="{Binding ModeText, Mode=OneWay}"/>
                    </Button>
                </StackPanel>
            </StackPanel>
            <ListBox Grid.Row="2" ItemsSource="{Binding UpNext}" MaxHeight="180" Margin="24,8,24,12"
                     Background="Transparent" BorderThickness="0"
                     VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding Name, Mode=OneWay}"/>
                                <Run Text=" — "/>
                                <Run Text="{Binding Artist, Mode=OneWay}"/>
                            </TextBlock>
                            <Button Grid.Column="1" Style="{StaticResource RowActionButton}" Content="移除" Height="24"
                                    Command="{Binding DataContext.RemoveFromQueueCommand,
                                        RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding Id}"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Grid>
</UserControl>
