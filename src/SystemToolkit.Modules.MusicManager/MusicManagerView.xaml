<UserControl x:Class="SystemToolkit.Modules.MusicManager.MusicManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.MusicManager"
             Background="{StaticResource Brush_Background}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <!-- 2026-09-08 用户拍板布局（替代三 Tab，解操作割裂）：
         顶部搜索+扫描 / 左栏曲库 / 右栏歌词 / 底部常驻播放条 / 点播放条进完整播放器覆盖层。 -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="Inverse"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
        <local:EmptyCollectionToVisibilityConverter x:Key="EmptyToVis"/>
        <local:StringEqualsToVisibilityConverter x:Key="StrEqToVis"/>
        <local:EmptyStringToVisibilityConverter x:Key="EmptyStrToVis"/>
        <local:RatioConverter x:Key="Ratio"/>
        <!-- 音量图标（审查 P0-1）：喇叭 + 0/1/2 道声波，静音态多一道斜杠 -->
        <Geometry x:Key="IconVolumeHigh">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,8.5 A4.5,4.5 0 0 1 16,15.5 M18.5,6 A8,8 0 0 1 18.5,18</Geometry>
        <Geometry x:Key="IconVolumeLow">M4,9 H8 L13,5 V19 L8,15 H4 Z M16,9.5 A3,3 0 0 1 16,14.5</Geometry>
        <Geometry x:Key="IconVolumeMuted">M4,9 H8 L13,5 V19 L8,15 H4 Z M17,9.5 L21.5,14 M21.5,9.5 L17,14</Geometry>
        <!-- 播放队列（图3 对齐）。⚠️ 必须页内定义：ViewLoadSmoke 测试宿主不合并 App 级资源，
             StaticResource 指向 Icons.xaml 会在解析期抛"找不到资源"（实测教训 2026-09-09） -->
        <Geometry x:Key="IconQueue">M8.1 16.6A1.7 1.7 0 1 1 4.7 16.6A1.7 1.7 0 1 1 8.1 16.6 M8.1 16.6V7.4 M8.1 7.4C11.2 7.3 12.2 9.4 11 10.8 M12.4 8.6H19.4M12.4 12.8H19.4M12.4 17H19.4</Geometry>
        <!-- 列表空态提示样式（审查 P0-2）：统一文案外观，避免每处内联重复 -->
        <Style x:Key="ListEmptyHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,16"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- 区域级加载提示（审查 P0-3） -->
        <Style x:Key="InlineLoadingHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 图标库（2026-09-09 全量图标化：Path 几何集中声明，按钮经 {StaticResource} 引用） -->
        <Geometry x:Key="IconBack">M14,6 L8,12 L14,18</Geometry>
        <Geometry x:Key="IconPlaySolid">M8,5 L19,12 L8,19 Z</Geometry>
        <Geometry x:Key="IconPauseBars">M7,5 H10 V19 H7 Z M14,5 H17 V19 H14 Z</Geometry>
        <Geometry x:Key="IconPrev">M6,6 H8 V18 H6 Z M20,6 L9,12 L20,18 Z</Geometry>
        <Geometry x:Key="IconNext">M18,6 H16 V18 H18 Z M4,6 L15,12 L4,18 Z</Geometry>
        <Geometry x:Key="IconLoop">M17,2 L21,6 L17,10 M21,6 H8 A5,5 0 0 0 3,11 M7,22 L3,18 L7,14 M3,18 H16 A5,5 0 0 0 21,13</Geometry>
        <!-- 播放模式三态图标（图3 反馈：模式切换要看得见）：shuffle 交叉箭头 / one 循环+中置1 -->
        <Geometry x:Key="IconModeShuffle">M16,3 H21 V8 M21,3 L3,21 M21,16 V21 H16 M14,14 L21,21 M3,3 L9,9</Geometry>
        <Geometry x:Key="IconModeOne">M17,2 L21,6 L17,10 M21,6 H8 A5,5 0 0 0 3,11 M7,22 L3,18 L7,14 M3,18 H16 A5,5 0 0 0 21,13 M11,10 L13,9 V15</Geometry>
        <Geometry x:Key="IconRefresh">M21,12 A9,9 0 1 1 18.36,5.64 M21,3 V9 H15</Geometry>
        <Geometry x:Key="IconNote">M9,3 V13.55 A4,4 0 1 0 11,17 V7 H17 V3 Z</Geometry>
        <Geometry x:Key="IconExpandUp">M7,14 L12,9 L17,14</Geometry>
        <Geometry x:Key="IconFolderScan">M3,7 V19 A2,2 0 0 0 5,21 H19 A2,2 0 0 0 21,19 V9 A2,2 0 0 0 19,7 H12 L10,5 H5 A2,2 0 0 0 3,7 Z</Geometry>
        <Geometry x:Key="IconEqSliders">M5,8 H19 M5,16 H19 M9,5.5 A2.5,2.5 0 1 1 9,10.5 A2.5,2.5 0 1 1 9,5.5 M15,13.5 A2.5,2.5 0 1 1 15,18.5 A2.5,2.5 0 1 1 15,13.5</Geometry>
        <!-- 2026-09-09 修复"进度条被底色吞掉"：默认 Slider 轨道为主题底色，压在播放器染色背景上隐形（只剩滑块）。
             自绘模板：剩余轨道半透明灰 + 已播段强调色 + 白色圆形滑块——浅底/彩胶/沉浸/现代四背景通用 -->
                <!-- 顶栏平台切换芯片公共样式（差异只在选中 DataTrigger，留在各按钮上） -->
        <Style x:Key="PlatformChipStyle" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="SeekSliderStyle" TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" VerticalAlignment="Center" Height="14">
                            <Border Height="4" CornerRadius="{DynamicResource Radius_Track}" Background="#26808080"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent">
                                                    <Border Height="4" CornerRadius="{DynamicResource Radius_Track}"
                                                            Background="{StaticResource Brush_Accent}"
                                                            VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="#FFFFFF" Stroke="#40000000" StrokeThickness="1"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题+计数 | 搜索 | 扫描 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="音乐管理"
                           FontSize="{DynamicResource Font_SizeDisplay}"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{Binding LibraryCountText}" Margin="12,4,0,0"
                           FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="网易云"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="NetEase">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlatformChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="NetEase">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="QQ 音乐" Margin="4,0,0,0"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="QQMusic">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PlatformChipStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="QQMusic">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox x:Name="OnlineSearchBox" Text="{Binding OnlineSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Width="220" Padding="8,5" VerticalContentAlignment="Center" Margin="8,0,0,0"
                         KeyDown="OnOnlineSearchKeyDown"/>
                <Button Height="32" Content="搜索" Margin="6,0,0,0" Command="{Binding SearchOnlineCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchingOnline, Mode=OneWay}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 状态行 + 曲库降级警告（🔴 不静默：缓存损坏/剔除文件必须可见） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <Border Background="{StaticResource Brush_WarningSoft}" CornerRadius="{DynamicResource Radius_MD}"
                    Padding="10,6" Margin="0,0,0,4"
                    Visibility="{Binding LibraryWarning, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding LibraryWarning}" FontSize="{DynamicResource Font_SizeCaption}"
                           Foreground="{StaticResource Brush_Warning}"/>
            </Border>
            <TextBlock Text="{Binding ScanStatusText}" FontSize="{DynamicResource Font_SizeCaption}"
                       Foreground="{StaticResource Brush_TextMuted}"
                       Visibility="{Binding ScanStatusText, Converter={StaticResource StrToVis}}"/>
        </StackPanel>

        <!-- 主区：左卡（我的歌单胶囊+内容三态） / 右卡（每日推荐+推荐歌单+Up Next）
             2026-09-09 对照 NexBox 重排（用户批准示意）：卡片化 + 图标化 + 封面缩略图 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.55*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左卡：卡头（返回+标题+全部播放） / 我的歌单胶囊+登录芯片 / 内容三态 -->
            <Border Grid.Column="0" Margin="0,0,8,0"
                    Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_LG}"
                    Padding="14,10,10,8">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Width="28" Height="28" Padding="0" Margin="0,0,8,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding ClosePlaylistCommand}" AutomationProperties.Name="返回上一层" ToolTip="返回上一层"
                                Visibility="{Binding IsLocalLibraryView, Converter={StaticResource InverseToVis}}">
                            <Path Data="{StaticResource IconBack}" StrokeLineJoin="Round"
                                  Stroke="{StaticResource Brush_TextPrimary}" StrokeThickness="2"/>
                        </Button>
                        <TextBlock Grid.Column="1" Text="{Binding ViewTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeTitleLg}"
                                   Foreground="{StaticResource Brush_TextPrimary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="2" Height="28" Padding="10,0" Content="全部播放" Margin="8,0,0,0"
                                Command="{Binding PlayPlaylistFromStartCommand}"
                                Visibility="{Binding IsPlaylistDetailView, Converter={StaticResource BoolToVis}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}"/>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- 图1 对齐重构（2026-09-09 实机反馈）：主页 = 本地卡头 + 本地条目 + 垂直歌单列表，
                         取代横向胶囊行（实机观感差：登录芯片呈椭圆、歌单胶囊截断拥挤）。
                     ⚠️ 页内 StaticResource 只能指向页内资源（ViewLoadSmoke 测试宿主不合并 App 资源） -->
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,8"
                          Visibility="{Binding IsLocalLibraryView, Converter={StaticResource BoolToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 本地音乐卡头：标题+计数 | 导入文件夹 -->
                        <Grid Grid.Row="0" Margin="2,0,2,10">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="本地音乐" FontSize="{DynamicResource Font_SizeTitleLg}"
                                           Foreground="{StaticResource Brush_TextPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding LibraryCountText, Mode=OneWay}" Margin="8,0,0,0"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Height="30" Padding="10,0" Content="导入文件夹" HorizontalAlignment="Right"
                                    Command="{Binding ScanCommand}"
                                    ToolTip="选择文件夹并扫描入库（可多次添加不同目录，多根合并）"
                                    AutomationProperties.Name="导入文件夹">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}"/>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <!-- 本地导入的歌单（列表第一项；点击进入本地曲目列表） -->
                        <Button Grid.Row="1" Height="56" Padding="6" Margin="0,0,0,10"
                                HorizontalContentAlignment="Stretch" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Command="{Binding ShowLocalTracksCommand}"
                                AutomationProperties.Name="本地导入的歌单">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="48" Height="48" CornerRadius="{DynamicResource Radius_MD}"
                                        Background="{StaticResource Brush_AccentSoft}">
                                    <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                          Width="20" Height="20" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="本地导入的歌单" FontSize="{DynamicResource Font_SizeBody}"
                                               Foreground="{StaticResource Brush_TextPrimary}"/>
                                    <TextBlock Text="{Binding LibraryCountText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                </StackPanel>
                            </Grid>
                        </Button>

                        <!-- 我的歌单：标题行 + 刷新 + 登录（紧凑文字钮，不再胶囊） -->
                        <Grid Grid.Row="2" Margin="2,0,2,6">
                            <TextBlock Text="我的歌单" FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Width="24" Height="24" Padding="0" Margin="0,0,6,0"
                                        Background="Transparent" BorderThickness="0"
                                        Command="{Binding LoadPlaylistsCommand}" AutomationProperties.Name="刷新歌单" ToolTip="刷新歌单">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadingPlaylists, Mode=OneWay}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Path Data="{StaticResource IconRefresh}" StrokeLineJoin="Round"
                                          Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.8"
                                          Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                                <TextBlock Text="{Binding IsLoadingPlaylists, Mode=OneWay}" Visibility="Collapsed"/>
                                <TextBlock Style="{StaticResource InlineLoadingHint}" Text="加载中…" Margin="0,0,6,0"
                                           Visibility="{Binding IsLoadingPlaylists, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding NetEaseLoginText, Mode=OneWay}" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"/>
                                <Button Height="22" Padding="6,0" Margin="4,0,10,0" Content="登录"
                                        Command="{Binding RequestLoginCommand}" CommandParameter="NetEase"
                                        AutomationProperties.Name="网易云登录">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}"/>
                                    </Button.Style>
                                </Button>
                                <TextBlock Text="{Binding QqLoginText, Mode=OneWay}" VerticalAlignment="Center"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"/>
                                <Button Height="22" Padding="6,0" Margin="4,0,0,0" Content="登录"
                                        Command="{Binding RequestLoginCommand}" CommandParameter="QQMusic"
                                        AutomationProperties.Name="QQ音乐登录">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}"/>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- 我的歌单垂直列表（在线歌单，封面+标题+N首） -->
                        <ListBox Grid.Row="3" x:Name="PlaylistList" ItemsSource="{Binding UserPlaylists}"
                                 SelectionChanged="OnPlaylistListSelection"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="52" Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="48"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="48" Height="48" CornerRadius="{DynamicResource Radius_MD}"
                                                Background="{StaticResource Brush_SurfaceAlt}">
                                            <Grid>
                                                <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnCoverImageFailed"
                                                       Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                                <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_TextMuted}"
                                                      Width="18" Height="18" Stretch="Uniform"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBody}"
                                                       Foreground="{StaticResource Brush_TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding CountText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                                       Foreground="{StaticResource Brush_TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <!-- 内容三态（视图状态机沿用，宿主由中栏改为左卡剩余区） -->
                    <Grid>
                <!-- 态① 本地曲目列表（主页点「本地导入的歌单」进入） -->
                <DockPanel Visibility="{Binding IsLocalTracksView, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Padding="8,5" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Height="30" Content="扫描曲库" Margin="0,0,6,0" Command="{Binding ScanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource RowActionButton}" Height="30" Content="取消"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <Grid>
                    <ListBox ItemsSource="{Binding SongsView}"
                             SelectedItem="{Binding SelectedSong, Mode=OneWayToSource}"
                             MouseDoubleClick="OnSongListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- 本地曲：音符占位（内嵌封面逐行解析开销大，缩略图仅在线行装载） -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="15" Height="15" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeBody}"
                                                   Foreground="{StaticResource Brush_TextPrimary}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Artist, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- 审查 P0-2：空态提示（过滤无结果也算空；Songs 为源集合，SongsView 无 Count） -->
                    <TextBlock Style="{StaticResource ListEmptyHint}"
                               Visibility="{Binding SongsView.IsEmpty, Converter={StaticResource BoolToVis}}"
                               Text="曲库为空或没有匹配的曲目 — 回主页点「导入文件夹」导入本地音乐"/>
                    </Grid>
                </DockPanel>

                <!-- 态② 在线搜索结果 -->
                <DockPanel Visibility="{Binding IsOnlineSearchView, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OnlineStatusText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="2,0,0,6"
                               Visibility="{Binding OnlineStatusText, Converter={StaticResource StrToVis}}"/>
                    <!-- 审查 P0-3：区域级加载指示（原先只置灰按钮，用户看不出在进行） -->
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource InlineLoadingHint}"
                               Text="搜索中…" Margin="2,0,0,6"
                               Visibility="{Binding IsSearchingOnline, Converter={StaticResource BoolToVis}}"/>
                    <!-- 审查 P0-2：空态（Dock=Bottom，Collapsed 时不占布局空间） -->
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ListEmptyHint}"
                               Text="暂无搜索结果 — 换个关键词，或检查登录态"
                               Visibility="{Binding SearchResults.Count, Converter={StaticResource EmptyToVis}}"/>
                    <ListBox x:Name="SearchResultList" ItemsSource="{Binding SearchResults}"
                             MouseDoubleClick="OnSearchListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Grid>
                                            <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                                  Width="15" Height="15" Stretch="Uniform"
                                                  Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                            <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnCoverImageFailed"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontSize="{DynamicResource Font_SizeBody}"
                                                       Foreground="{StaticResource Brush_TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource Brush_AccentSoft}"
                                                    CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                                <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeCaption}"
                                                           Foreground="{StaticResource Brush_Accent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Width="20" Height="20" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Click="OnSearchRowPlayClick" AutomationProperties.Name="播放"
                                            ToolTip="播放">
                                        <Path Data="{StaticResource IconPlaySolid}"
                                              Fill="{StaticResource Brush_TextMuted}" Width="13" Height="13"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 态③ 歌单详情（标题/全部播放/返回已上移左卡卡头） -->
                <DockPanel Visibility="{Binding IsPlaylistDetailView, Converter={StaticResource BoolToVis}}">
                    <!-- 图2 对齐：搜索本歌单（只过滤当前歌单显示） -->
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,6">
                        <TextBox Height="30" Padding="8,5,8,5" VerticalContentAlignment="Center"
                                 Text="{Binding PlaylistFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="搜索本歌单"/>
                        <TextBlock Text="搜索本歌单" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"
                                   Margin="10,0,0,0" IsHitTestVisible="False"
                                   Visibility="{Binding PlaylistFilterText, Converter={StaticResource EmptyStrToVis}}"/>
                    </Grid>
                    <!-- 审查 P0-2：空态 -->
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ListEmptyHint}"
                               Text="该歌单暂无曲目（或加载失败，见状态行）"
                               Visibility="{Binding PlaylistTracks.Count, Converter={StaticResource EmptyToVis}}"/>
                    <!-- 搜索字把列表过滤光时的提示（与"歌单为空"区分） -->
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource ListEmptyHint}"
                               Text="没有匹配的曲目 — 换个关键字试试"
                               Visibility="{Binding PlaylistFilterNoMatch, Converter={StaticResource BoolToVis}}"/>
                    <ListBox x:Name="PlaylistTrackList" ItemsSource="{Binding PlaylistTracksView}"
                             MouseDoubleClick="OnPlaylistTrackDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="20"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="{DynamicResource Radius_MD}"
                                            Background="{StaticResource Brush_AccentSoft}">
                                        <Grid>
                                            <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                                  Width="15" Height="15" Stretch="Uniform"
                                                  Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                            <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnCoverImageFailed"
                                                   Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Title, Mode=OneWay}"
                                                       FontSize="{DynamicResource Font_SizeBody}"
                                                       Foreground="{StaticResource Brush_TextPrimary}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{StaticResource Brush_AccentSoft}"
                                                    CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                                <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeCaption}"
                                                           Foreground="{StaticResource Brush_Accent}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_TextMuted}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Grid.Column="3" Width="20" Height="20" Padding="0"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Click="OnSearchRowPlayClick" AutomationProperties.Name="播放"
                                            ToolTip="播放">
                                        <Path Data="{StaticResource IconPlaySolid}"
                                              Fill="{StaticResource Brush_TextMuted}" Width="13" Height="13"
                                              Stretch="Uniform"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            </DockPanel>
            </Border>

            <!-- 右卡：每日推荐 + 推荐歌单 + Up Next -->
            <Border Grid.Column="1"
                    Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_LG}"
                    Padding="14,10,14,8">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="每日推荐" FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                    <!-- 审查 P0-3：区域级加载指示 -->
                    <TextBlock Grid.Column="0" Style="{StaticResource InlineLoadingHint}" Text="加载推荐中…"
                               HorizontalAlignment="Right" Margin="0,0,8,0"
                               Visibility="{Binding IsLoadingRecommendations, Converter={StaticResource BoolToVis}}"/>
                    <Button Grid.Column="1" Width="22" Height="22" Padding="0"
                            Command="{Binding LoadRecommendationsCommand}" AutomationProperties.Name="刷新推荐" ToolTip="刷新推荐">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingRecommendations, Mode=OneWay}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="{StaticResource IconRefresh}" StrokeLineJoin="Round"
                              Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.8"
                              Width="12" Height="12" Stretch="Uniform"/>
                    </Button>
                </Grid>
                <TextBlock Grid.Row="2" Style="{StaticResource ListEmptyHint}"
                           Text="暂无每日推荐 — 登录后才会生成（仅网易云支持）"
                           Visibility="{Binding DailyRecommend.Count, Converter={StaticResource EmptyToVis}}"/>
                <ListBox Grid.Row="2" x:Name="DailyRecommendList" ItemsSource="{Binding DailyRecommend}"
                         MouseDoubleClick="OnDailyRecommendDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="34" Height="34"
                                        CornerRadius="{DynamicResource Radius_MD}"
                                        Background="{StaticResource Brush_AccentSoft}">
                                    <Grid>
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="13" Height="13" Stretch="Uniform"
                                              Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                        <Image Source="{Binding CoverImage, Mode=OneWay}" Stretch="UniformToFill" ImageFailed="OnCoverImageFailed"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="8,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 2026-09-09 实机反馈：推荐歌单与 Up Next 两分区移除，右栏只留每日推荐；
                     Up Next 改由播放条队列按钮弹出（见底部 QueuePopup） -->
                </Grid>
            </Border>
        </Grid>

        <!-- 底部常驻播放条（2026-09-09 NexBox 风格重做：封面+曲名/艺人+中央圆形播放钮+右侧图标组+下缘进度；点击空白区展开完整播放器） -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="14,8,14,6"
                Background="{StaticResource Brush_Surface}"
                CornerRadius="{DynamicResource Radius_LG}">
                <!-- 反馈：整条热区误触展开已移除——仅右上专用展开钮进入完整播放器 -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <!-- 审查 P1-6：原固定 160px，窄窗口挤压文本；改为自适应 + 最小宽保证可读 -->
                        <ColumnDefinition Width="*" MinWidth="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 封面（在线曲异步加载/本地曲内嵌；无封面音符占位）。
                         图3 反馈：点封面进入播放器（替代原右下 ^ 展开钮） -->
                    <Button Grid.Column="0" Width="46" Height="46"
                            Command="{Binding OpenFullPlayerCommand}"
                            Cursor="Hand" Focusable="False"
                            AutomationProperties.Name="打开播放器" ToolTip="打开播放器">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{StaticResource Brush_AccentSoft}" CornerRadius="{DynamicResource Radius_MD}">
                                    <Grid>
                                        <Path Data="{StaticResource IconNote}" Fill="{StaticResource Brush_Accent}"
                                              Width="16" Height="16" Stretch="Uniform"
                                              Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}"/>
                                        <Image Source="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"
                                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" FontSize="{DynamicResource Font_SizeBody}"
                                   Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentSub, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                IsEnabled="{Binding IsEngineReady}">
                        <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首" ToolTip="上一首">
                            <Path Data="{StaticResource IconPrev}" Fill="{StaticResource Brush_TextPrimary}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <Button Width="36" Height="36" Padding="0" Margin="0,0,16,0"
                                Background="{StaticResource Brush_Accent}" BorderThickness="0"
                                Command="{Binding PlayPauseCommand}" AutomationProperties.Name="播放或暂停" ToolTip="播放 / 暂停">
                            <Grid>
                                <Path Data="{StaticResource IconPlaySolid}" Fill="{StaticResource Brush_Background}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource InverseToVis}}"/>
                                <Path Data="{StaticResource IconPauseBars}" Fill="{StaticResource Brush_Background}"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Button>
                        <Button Width="32" Height="32" Padding="0" Margin="0,0,16,0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding NextCommand}" AutomationProperties.Name="下一首" ToolTip="下一首">
                            <Path Data="{StaticResource IconNext}" Fill="{StaticResource Brush_TextPrimary}"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <!-- 图3 反馈：黄方块静音钮去掉——音量喇叭（右侧）点击即静音切换 -->
                        <Button Width="32" Height="32" Padding="0"
                                Command="{Binding ToggleModeCommand}" ToolTip="{Binding ModeText, Mode=OneWay}"
                                AutomationProperties.Name="播放模式" Cursor="Hand">
                            <!-- 图3 反馈：模式切换必须可见——三态图标 + 非列表循环时强调色 -->
                            <Grid>
                                <Path Data="{StaticResource IconLoop}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding ModeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=list}"/>
                                <Path Data="{StaticResource IconModeShuffle}" StrokeLineJoin="Round" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding ModeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=shuffle}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource Brush_TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModeIconKind, Mode=OneWay}" Value="shuffle">
                                                    <Setter Property="Stroke" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Path Data="{StaticResource IconModeOne}" StrokeLineJoin="Round" StrokeThickness="1.6"
                                      Width="15" Height="15" Stretch="Uniform"
                                      Visibility="{Binding ModeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=one}">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{StaticResource Brush_TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ModeIconKind, Mode=OneWay}" Value="one">
                                                    <Setter Property="Stroke" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Grid>
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="MainQualityButton" Margin="0,0,10,0" Padding="7,2" Height="24"
                                Background="{StaticResource Brush_SurfaceAlt}" BorderThickness="0" Cursor="Hand"
                                VerticalAlignment="Center" Click="OnQualityButtonClick"
                                MouseRightButtonUp="OnQualityButtonRightClick"
                                AutomationProperties.Name="音质" ToolTip="音质（左键/右键弹出菜单）">
                            <TextBlock Text="{Binding SelectedQualityText, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeCaption}"
                                       Foreground="{StaticResource Brush_TextSecondary}"/>
                        </Button>
                        <!-- 音量（图3 对齐改为常驻横向滑块）：喇叭点击=静音切换，滑块直接调节 -->
                        <Button x:Name="VolumeButton" Width="28" Height="28" Padding="0"
                                Background="Transparent" BorderThickness="0"
                                Command="{Binding ToggleMuteCommand}"
                                AutomationProperties.Name="静音切换"
                                ToolTip="静音 / 取消静音">
                            <Grid>
                                <Path Data="{StaticResource IconVolumeHigh}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=high}"/>
                                <Path Data="{StaticResource IconVolumeLow}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=low}"/>
                                <Path Data="{StaticResource IconVolumeMuted}" StrokeLineJoin="Round"
                                      Stroke="{StaticResource Brush_Warning}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform"
                                      Visibility="{Binding VolumeIconKind, Converter={StaticResource StrEqToVis}, ConverterParameter=muted}"/>
                            </Grid>
                        </Button>
                        <Slider Minimum="0" Maximum="100"
                                Width="{DynamicResource Slider_HorizontalWidth}"
                                Value="{Binding VolumePercent, Mode=TwoWay}"
                                IsMoveToPointEnabled="True" VerticalAlignment="Center" Margin="2,0,10,0"
                                AutomationProperties.Name="音量大小"/>
                        <!-- 队列（图3 对齐）：弹出 Up Next 面板，点选即播（Up Next 已从右卡移除） -->
                        <Button x:Name="QueueButton" Width="28" Height="28" Padding="0" Margin="0,0,10,0"
                                Background="Transparent" BorderThickness="0"
                                PreviewMouseLeftButtonDown="OnQueueButtonPreviewMouseDown"
                                Click="OnQueueButtonClick" AutomationProperties.Name="播放队列"
                                ToolTip="播放队列">
                            <Path Data="{StaticResource IconQueue}" StrokeLineJoin="Round"
                                  Stroke="{StaticResource Brush_TextSecondary}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                        <!-- 播放队列弹出面板：列出 Up Next，单击曲目立即播放（StaysOpen=False 点外收起） -->
                        <Popup x:Name="QueuePopup" PlacementTarget="{Binding ElementName=QueueButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush_Surface}"
                                    BorderBrush="{StaticResource Brush_SurfaceAlt}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius_LG}" Padding="6"
                                    Margin="0,0,0,6" Width="260" MaxHeight="280">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource ListEmptyHint}"
                                               Text="播放队列为空 — 双击曲目即可加入"
                                               Visibility="{Binding UpNext.Count, Converter={StaticResource EmptyToVis}}"/>
                                    <ListBox x:Name="QueuePopupList" ItemsSource="{Binding UpNext}"
                                         SelectionChanged="OnQueuePopupSelection"
                                         Background="Transparent" BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True"
                                         VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3">
                                                <TextBlock Text="{Binding Name, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeBodySm}"
                                                           Foreground="{StaticResource Brush_TextPrimary}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Artist, Mode=OneWay}"
                                                           FontSize="{DynamicResource Font_SizeCaption}"
                                                           Foreground="{StaticResource Brush_TextMuted}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                </DockPanel>
                            </Border>
                        </Popup>

                        <!-- 音质菜单（反馈2/3：ContextMenu 右键失效案例 → 改 Popup，左/右键均可开） -->
                        <Popup x:Name="QualityPopup" PlacementTarget="{Binding ElementName=MainQualityButton}"
                               Placement="Top" StaysOpen="False" AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <Border Background="{StaticResource Brush_Surface}"
                                    BorderBrush="{StaticResource Brush_SurfaceAlt}" BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius_LG}" Padding="6"
                                    Margin="0,0,0,6" Width="140">
                                <StackPanel>
                                    <TextBlock Text="音质" FontSize="{DynamicResource Font_SizeCaption}"
                                               Foreground="{StaticResource Brush_TextMuted}" Margin="8,4,0,4"/>
                                    <Button Content="母带" Tag="jymaster" HorizontalContentAlignment="Left"
                                            Click="OnQualityOptionClick" Cursor="Hand"
                                            Style="{StaticResource RowActionButton}"/>
                                    <Button Content="Hi-Res" Tag="hires" HorizontalContentAlignment="Left"
                                            Click="OnQualityOptionClick" Cursor="Hand"
                                            Style="{StaticResource RowActionButton}"/>
                                    <Button Content="无损" Tag="lossless" HorizontalContentAlignment="Left"
                                            Click="OnQualityOptionClick" Cursor="Hand"
                                            Style="{StaticResource RowActionButton}"/>
                                    <Button Content="高品质" Tag="exhigh" HorizontalContentAlignment="Left"
                                            Click="OnQualityOptionClick" Cursor="Hand"
                                            Style="{StaticResource RowActionButton}"/>
                                    <Button Content="标准" Tag="standard" HorizontalContentAlignment="Left"
                                            Click="OnQualityOptionClick" Cursor="Hand"
                                            Style="{StaticResource RowActionButton}"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                        <!-- 图3 反馈：^ 展开钮去掉——点左侧封面进入播放器 -->
                        <TextBlock Text="播放引擎未就绪" Margin="8,0,0,0" VerticalAlignment="Center"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_Warning}"
                                   Visibility="{Binding IsEngineReady, Converter={StaticResource InverseToVis}}"/>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="2,4,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="SeekSlider" Maximum="100" Style="{StaticResource SeekSliderStyle}"
                            Margin="8,0"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionDurationText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <!-- ═══ 完整播放器覆盖层（2026-09-08 参考网易云全屏播放器重设计；不显示队列——用户裁定） ═══ -->
        <Grid Grid.Row="0" Grid.RowSpan="4" ClipToBounds="True"
              Visibility="{Binding IsFullPlayerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 背景层（OM-6 三风格：主色派生三档——浅染/深染/中调；控制条/顶栏浮于其上） -->
            <Grid Grid.RowSpan="3">
                <Border Background="{Binding VinylBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}"/>
                <Border Background="{Binding ImmersionBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}"/>
                <Border x:Name="ModernBgHost" Background="{Binding ModernBackgroundBrush, Mode=OneWay}"
                        Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- ① 顶栏：收起钮（左）；现代态显示"歌词"pill（右，对照 NexBox，不做评论） -->
            <Grid Grid.Row="0">
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0"
                        Padding="10,4" CornerRadius="{DynamicResource Radius_Pill}"
                        Background="{Binding PlayerAccentBrush, Mode=OneWay}"
                        Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="♪ 歌词" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerForegroundBrush, Mode=OneWay}"/>
                </Border>
                <Button HorizontalAlignment="Left" Margin="20,14,0,0"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding CloseFullPlayerCommand}" ToolTip="收起播放器">
                    <Path Data="M7,10 L13,16 L19,10" StrokeLineJoin="Round"
                          Stroke="{Binding PlayerForegroundBrush, Mode=OneWay}" StrokeThickness="2"/>
                </Button>
            </Grid>

            <!-- ② 内容层：三风格主视觉模板（共享 Row1，各按 Visibility 显隐） -->
            <Grid Grid.Row="1">
                <!-- 模板① 透明彩胶：左歌词流 + 右黑胶（2026-09-08 重设计布局原样保留，默认风格） -->
                <Grid Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <!-- 左：标题 / 艺术家 / 歌词流 -->
                <Grid Grid.Column="0" Margin="72,8,48,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CurrentTitle, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeTitleLg}"
                               Foreground="{StaticResource Brush_TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding CurrentSub, Mode=OneWay}"
                               Margin="0,8,0,20"
                               FontSize="{DynamicResource Font_SizeBody}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <ListBox Grid.Row="2" x:Name="FullLyricsList"
                             ItemsSource="{Binding LyricRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             VirtualizingPanel.VirtualizationMode="Standard">
                        <!-- 上下边缘渐隐遮罩（对照 NexBox maskImage 12%/88%） -->
                        <ListBox.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.12"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.88"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </ListBox.OpacityMask>
                        <!-- 🔴 虚拟化已关闭（2026-09-09 实测）：可变行高（换行+字号可调）+像素虚拟化+回收
                             会让偏移估算漂移 → 列表中部出现空白块且不回填。歌词量级（≤200 行）全量渲染零压力 -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,9"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontSize="{Binding DataContext.LyricFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                            <!-- 非当前行淡显（对照 NexBox opacity 0.55） -->
                                            <Setter Property="Opacity" Value="0.55"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.PlayerAccentBrush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center"
                               Text="{Binding LyricsHint, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextWrapping="Wrap"
                               Visibility="{Binding LyricsHint, Converter={StaticResource StrToVis}}"/>
                </Grid>

                <!-- 右：彩胶圆盘（NexBox VinylDisc 100% 复刻，2026-09-09）：
                     盘径 min(80vh,48vw)→按 Row1 高 80%（钳制 240–640），右上伸出（X+0.36/Y-0.30）；
                     层序：光晕(1.7×,呼吸) → 旋转层[accent 0.56 半透明盘 + 湍流胶纹纹理 + 封面圆 70%] → conic 高光(不转) -->
                <Grid Grid.Column="1" x:Name="DiscHost"
                      IsHitTestVisible="False"
                      Width="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource Ratio}, ConverterParameter=0.92|240|720}"
                      Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource Ratio}, ConverterParameter=0.92|240|720}"
                      HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Grid.RenderTransform>
                        <TranslateTransform
                            X="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=0.36}"
                            Y="{Binding ActualHeight, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=-0.30}"/>
                    </Grid.RenderTransform>

                    <!-- 光晕层：与盘同心 1.7×，accent 染色（Fill 由 code-behind 随 accent 重建），播放时呼吸 -->
                    <Ellipse x:Name="DiscGlow" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Width="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=1.7}"
                             Height="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=1.7}"
                             RenderTransformOrigin="0.5,0.5"/>

                    <!-- 旋转层（24s，播放转/暂停停） -->
                    <Grid x:Name="DiscSpinHost" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <RotateTransform x:Name="DiscRotation"/>
                        </Grid.RenderTransform>
                        <!-- 半透明盘体：accent 0.56，透出浅灰渐变底 -->
                        <Ellipse Fill="{Binding VinylAccentBrush, Mode=OneWay}" Opacity="0.56"/>
                        <!-- 湍流胶纹 + 同心细纹 + 明暗斑驳（运行时预渲染，随盘转） -->
                        <Ellipse>
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{x:Static local:VinylTextureFactory.GrooveSource}" Stretch="Uniform"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <!-- 封面圆：盘径 70%，随盘转 -->
                        <Ellipse Width="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=0.7}"
                                 Height="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=0.7}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Stroke="#40FFFFFF" StrokeThickness="1">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=0.7}"
                                 Height="{Binding ActualWidth, ElementName=DiscHost, Converter={StaticResource Ratio}, ConverterParameter=0.7}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Fill="{Binding VinylAccentBrush, Mode=OneWay}" Opacity="0.85"
                                 Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}">
                            <Ellipse.OpacityMask>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF000000" Offset="0"/>
                                    <GradientStop Color="#80000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.OpacityMask>
                        </Ellipse>
                    </Grid>

                    <!-- conic 反光高光：固定不随盘转（环境光） -->
                    <Image Source="{x:Static local:VinylTextureFactory.HighlightSource}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Width="{Binding ActualWidth, ElementName=DiscHost}"
                           Height="{Binding ActualWidth, ElementName=DiscHost}"/>
                </Grid>
                </Grid>

                <!-- 模板② 沉浸：深主色三段渐变底 + 全屏水波场 + 中央当前句（重影双层 + 双行拆分） -->
                <Grid x:Name="ImmersionRoot" ClipToBounds="True"
                      Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}">
                    <!-- 水波场：左右两个发射点的同心波环（背景色自身深/浅），铺满模板区（审查 F-02 报告对照 NexBox ImmersiveRippleField） -->
                    <Canvas x:Name="RippleHost" IsHitTestVisible="False"/>
                    <!-- 背景重影层（对照 NexBox ImmersiveLyricsView）：只取句首 2-4 字，
                         前景字号 ×2.6、白 0.16、居中 nowrap（字号/文本均由 code-behind 管理） -->
                    <TextBlock x:Name="ImmersionGhostText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center"
                               Foreground="#29FFFFFF"/>
                    <!-- 前景主歌词：完整当前句，亮色居中（字体/字号 code-behind 对照 NexBox：思源宋体 Black，字号=视口高 11% 钳 30-84） -->
                    <TextBlock x:Name="ImmersionLyricText" HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" MaxWidth="760"
                               RenderTransformOrigin="0.5,0.5"
                               FontWeight="Black"
                               Foreground="{Binding PlayerForegroundBrush, Mode=OneWay}">
                        <TextBlock.RenderTransform>
                            <RotateTransform Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentLyricText, Mode=OneWay}" Value="">
                                        <Setter Property="Text" Value="♪"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- 模板③ 现代：中调主色底（背景层承担）+ 左上歌曲信息卡 + 右侧歌词列表（对照截图） -->
                <Grid Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左：歌曲信息卡（白卡：封面方图 + 歌名 + 艺术家 + 专辑） -->
                    <!-- 审查 P1-8：原固定 250 宽 / 220 封面；改为按窗口宽度 26%（钳制 200–300），封面按高度 30% -->
                    <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource Ratio}, ConverterParameter=0.26|200|300}"
                            Margin="56,24,0,0" CornerRadius="{DynamicResource Radius_LG}"
                            Background="{StaticResource Brush_Surface}" Padding="14">
                        <StackPanel>
                            <Border CornerRadius="{DynamicResource Radius_MD}"
                                    Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Grid}, Converter={StaticResource Ratio}, ConverterParameter=0.3|160|260}"
                                    Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Border Height="220" CornerRadius="{DynamicResource Radius_MD}"
                                    Background="{StaticResource Brush_SurfaceAlt}"
                                    Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}">
                                <TextBlock Text="无封面" FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding CurrentTitle, Mode=OneWay}" Margin="0,12,0,0"
                                       FontSize="{DynamicResource Font_SizeTitle}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentArtistText, Mode=OneWay}" Margin="0,6,0,0"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{Binding PlayerForegroundBrush, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding CurrentAlbumText, Mode=OneWay}" Margin="0,2,0,0"
                                       FontSize="{DynamicResource Font_SizeCaption}"
                                       Foreground="{Binding PlayerMutedBrush, Mode=OneWay}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Border>

                    <!-- 右：歌词列表（当前行主色高亮） -->
                    <ListBox Grid.Column="1" x:Name="ModernLyricsList"
                             Margin="8,60,64,16"
                             ItemsSource="{Binding LyricRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="False"
                             VirtualizingPanel.VirtualizationMode="Standard">
                        <!-- 🔴 同 FullLyricsList：虚拟化对可变行高产生空白块，关闭（2026-09-09） -->
                        <!-- 上下边缘渐隐遮罩（对照 NexBox maskImage） -->
                        <ListBox.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00FFFFFF" Offset="0"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.12"/>
                                <GradientStop Color="#FFFFFFFF" Offset="0.88"/>
                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                            </LinearGradientBrush>
                        </ListBox.OpacityMask>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,8"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           FontSize="{Binding DataContext.LyricFontSize, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=OneWay}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                            <!-- 非当前行淡显（对照 NexBox opacity 0.55） -->
                                            <Setter Property="Opacity" Value="0.55"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{Binding DataContext.PlayerAccentBrush, RelativeSource={RelativeSource AncestorType=ListBox}}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

            </Grid>

            <!-- ③ 底控制栏：模式 + 传输 + 分列进度（引擎未就绪整组禁用） -->
            <Grid Grid.Row="2" Margin="72,0,72,26" IsEnabled="{Binding IsEngineReady}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 左：风格切换（反馈5：参考 NexBox 移到下方）+ 音质（反馈2/3：左/右键均可开） -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="StyleVinylButton" Height="26" Padding="9,0" Content="彩胶" Margin="0,0,6,0"
                                Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Vinyl"
                                FontSize="{DynamicResource Font_SizeCaption}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsVinylStyle, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="26" Padding="9,0" Content="沉浸" Margin="0,0,6,0"
                                Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Immersion"
                                FontSize="{DynamicResource Font_SizeCaption}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsImmersionStyle, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="26" Padding="9,0" Content="现代"
                                Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Modern"
                                FontSize="{DynamicResource Font_SizeCaption}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModernStyle, Mode=OneWay}" Value="True">
                                            <Setter Property="Foreground" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <ToggleButton Height="26" Padding="8,0" Margin="8,0,0,0"
                                      IsChecked="{Binding IsDynamicBackground, Mode=OneWay}" Command="{Binding ToggleDynamicBackgroundCommand}"
                                      AutomationProperties.Name="动态背景" ToolTip="动态流动背景">
                            <ToggleButton.Style>
                                <Style TargetType="ToggleButton">
                                    <!-- 🔴 不能 BasedOn RowActionButton（其 TargetType=Button，跨基类即抛） -->
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                    <Setter Property="Visibility" Value="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="{Binding PlayerAccentBrush, Mode=OneWay}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ToggleButton.Style>
                            <TextBlock Text="动态" FontSize="{DynamicResource Font_SizeCaption}"/>
                        </ToggleButton>
                        <Button x:Name="PlayerQualityButton" Height="26" Padding="9,0" Margin="12,0,0,0"
                                Click="OnQualityButtonClick" MouseRightButtonUp="OnQualityButtonRightClick"
                                AutomationProperties.Name="音质" Cursor="Hand"
                                ToolTip="音质（左键/右键弹出菜单）">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="{Binding SelectedQualityText, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeCaption}"/>
                        </Button>
                    </StackPanel>
                    <!-- 中：运输控制（原样保留） -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="44" Height="40" Margin="0,0,28,0" Padding="0"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding PreviousCommand}" AutomationProperties.Name="上一首" ToolTip="上一首">
                        <Path Data="{StaticResource IconPrev}" Fill="{Binding PlayerForegroundBrush, Mode=OneWay}"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                    <Button Width="56" Height="56" Padding="0"
                            Background="{StaticResource Brush_Accent}" BorderThickness="0"
                            Command="{Binding PlayPauseCommand}" AutomationProperties.Name="播放或暂停" ToolTip="播放 / 暂停">
                        <Grid>
                            <Path Fill="{StaticResource Brush_Background}" Data="{StaticResource IconPlaySolid}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseToVis}}"/>
                            <Path Fill="{StaticResource Brush_Background}" Data="{StaticResource IconPauseBars}"
                                  Width="20" Height="20" Stretch="Uniform"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Button>
                    <Button Width="44" Height="40" Margin="28,0,0,0" Padding="0"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding NextCommand}" AutomationProperties.Name="下一首" ToolTip="下一首">
                        <Path Data="{StaticResource IconNext}" Fill="{Binding PlayerForegroundBrush, Mode=OneWay}"
                              Width="18" Height="18" Stretch="Uniform"/>
                    </Button>
                </StackPanel>
                    <!-- 右：歌词字号（反馈4）+ 播放队列（反馈6） -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Height="26" Padding="7,0" Content="A−" Command="{Binding DecreaseLyricFontCommand}"
                                AutomationProperties.Name="减小歌词字号" ToolTip="减小歌词字号"
                                FontSize="{DynamicResource Font_SizeCaption}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Height="26" Padding="7,0" Content="A+" Command="{Binding IncreaseLyricFontCommand}"
                                AutomationProperties.Name="增大歌词字号" ToolTip="增大歌词字号"
                                FontSize="{DynamicResource Font_SizeCaption}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                    <Setter Property="Foreground" Value="{Binding PlayerMutedBrush, Mode=OneWay}"/>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button x:Name="PlayerQueueButton" Height="26" Width="30" Padding="0" Margin="10,0,0,0"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                PreviewMouseLeftButtonDown="OnQueueButtonPreviewMouseDown"
                                Click="OnQueueButtonClick" AutomationProperties.Name="播放队列"
                                ToolTip="播放队列">
                            <Path Data="{StaticResource IconQueue}" StrokeLineJoin="Round"
                                  Stroke="{Binding PlayerForegroundBrush, Mode=OneWay}" StrokeThickness="1.6"
                                  Width="16" Height="16" Stretch="Uniform"/>
                        </Button>
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" Margin="40,16,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerMutedBrush, Mode=OneWay}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="FullSeekSlider" Margin="16,0" Maximum="100"
                            Style="{StaticResource SeekSliderStyle}"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnFullSeekDragCompleted"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionDurationText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{Binding PlayerMutedBrush, Mode=OneWay}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
