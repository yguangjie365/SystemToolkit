<UserControl x:Class="SystemToolkit.Modules.MusicManager.MusicManagerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SystemToolkit.Modules.MusicManager"
             Background="{StaticResource Brush_Background}"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <!-- 2026-09-08 用户拍板布局（替代三 Tab，解操作割裂）：
         顶部搜索+扫描 / 左栏曲库 / 右栏歌词 / 底部常驻播放条 / 点播放条进完整播放器覆盖层。 -->
    <UserControl.Resources>
        <local:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter x:Key="Inverse"/>
        <local:InverseBoolToVisibilityConverter x:Key="InverseToVis"/>
        <local:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
    </UserControl.Resources>

    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：标题+计数 | 搜索 | 扫描 -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="音乐管理"
                           FontSize="{DynamicResource Font_SizeDisplay}"
                           Foreground="{StaticResource Brush_TextPrimary}"/>
                <TextBlock Text="{Binding LibraryCountText}" Margin="12,4,0,0"
                           FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextMuted}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Height="32" Content="网易云" Padding="10,0"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="NetEase">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="NetEase">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Height="32" Content="QQ 音乐" Padding="10,0" Margin="4,0,0,0"
                        Command="{Binding SelectPlatformCommand}" CommandParameter="QQMusic">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedPlatform, Mode=OneWay}" Value="QQMusic">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBox x:Name="OnlineSearchBox" Text="{Binding OnlineSearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                         Width="220" Padding="8,5" VerticalContentAlignment="Center" Margin="8,0,0,0"
                         KeyDown="OnOnlineSearchKeyDown"/>
                <Button Height="32" Content="搜索" Margin="6,0,0,0" Command="{Binding SearchOnlineCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSearchingOnline, Mode=OneWay}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 状态行 + 曲库降级警告（🔴 不静默：缓存损坏/剔除文件必须可见） -->
        <StackPanel Grid.Row="1" Margin="0,0,0,6">
            <Border Background="{StaticResource Brush_WarningSoft}" CornerRadius="{DynamicResource Radius_MD}"
                    Padding="10,6"
                    Visibility="{Binding LibraryWarning, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding LibraryWarning}" FontSize="{DynamicResource Font_SizeCaption}"
                           Foreground="{StaticResource Brush_Warning}"/>
            </Border>
            <TextBlock Text="{Binding ScanStatusText}" FontSize="{DynamicResource Font_SizeCaption}"
                       Foreground="{StaticResource Brush_TextMuted}"
                       Visibility="{Binding ScanStatusText, Converter={StaticResource StrToVis}}"/>
        </StackPanel>

        <!-- 主区：左歌单面板 / 中内容区三态（OM-5，2026-09-08 用户批准示意） / 右推荐+队列 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <!-- 左：歌单面板（歌单列表 + 底部登录态芯片） -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Text="歌单" FontSize="{DynamicResource Font_SizeBody}"
                           Foreground="{StaticResource Brush_TextSecondary}" Margin="2,0,0,6"/>
                <Button DockPanel.Dock="Top" Style="{StaticResource RowActionButton}" Height="28" Margin="0,0,0,6"
                        Content="本地曲库" HorizontalAlignment="Stretch"
                        Command="{Binding ClosePlaylistCommand}"/>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding SelectedPlatformText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Height="24" Padding="8,0" Content="刷新"
                            Command="{Binding LoadPlaylistsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingPlaylists, Mode=OneWay}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <StackPanel DockPanel.Dock="Bottom">
                    <Grid Margin="2,4,2,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding NetEaseLoginText, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Style="{StaticResource RowActionButton}" Height="20" Padding="6,0"
                                Content="登录" Command="{Binding RequestLoginCommand}" CommandParameter="NetEase"/>
                    </Grid>
                    <Grid Margin="2,2,2,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding QqLoginText, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Style="{StaticResource RowActionButton}" Height="20" Padding="6,0"
                                Content="登录" Command="{Binding RequestLoginCommand}" CommandParameter="QQMusic"/>
                    </Grid>
                </StackPanel>
                <ListBox x:Name="PlaylistList" ItemsSource="{Binding UserPlaylists}"
                         MouseDoubleClick="OnPlaylistListDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeBodySm}"
                                           Foreground="{StaticResource Brush_TextPrimary}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Column="1" Text="{Binding CountText, Mode=OneWay}"
                                           FontSize="{DynamicResource Font_SizeCaption}"
                                           Foreground="{StaticResource Brush_TextMuted}"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 中：内容区三态（视图状态机） -->
            <Grid Grid.Column="2">
                <!-- 态① 本地曲库 -->
                <DockPanel Visibility="{Binding IsLocalLibraryView, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                 Padding="8,5" VerticalContentAlignment="Center" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Height="30" Content="扫描曲库" Margin="0,0,6,0" Command="{Binding ScanCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning, Mode=OneWay}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource RowActionButton}" Height="30" Content="取消"
                                Command="{Binding CancelScanCommand}"
                                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                    <ListBox ItemsSource="{Binding SongsView}"
                             SelectedItem="{Binding SelectedSong, Mode=OneWayToSource}"
                             MouseDoubleClick="OnSongListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBody}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Artist, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 态② 在线搜索结果 -->
                <DockPanel Visibility="{Binding IsOnlineSearchView, Converter={StaticResource BoolToVis}}">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding OnlineStatusText, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="2,0,0,6"
                               Visibility="{Binding OnlineStatusText, Converter={StaticResource StrToVis}}"/>
                    <ListBox x:Name="SearchResultList" ItemsSource="{Binding SearchResults}"
                             MouseDoubleClick="OnSearchListDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBody}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtitle, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="{StaticResource Brush_AccentSoft}"
                                            CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="0,0,8,0"
                                            Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                        <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_Accent}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <!-- 态③ 歌单详情 -->
                <DockPanel Visibility="{Binding IsPlaylistDetailView, Converter={StaticResource BoolToVis}}">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding ViewTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeTitle}"
                                   Foreground="{StaticResource Brush_TextPrimary}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                        <Button Grid.Column="1" Height="30" Content="全部播放" Margin="0,0,6,0"
                                Command="{Binding PlayPlaylistFromStartCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource RowPrimaryButton}"/>
                            </Button.Style>
                        </Button>
                        <Button Grid.Column="2" Style="{StaticResource RowActionButton}" Height="30" Content="返回"
                                Command="{Binding ClosePlaylistCommand}"/>
                    </Grid>
                    <ListBox x:Name="PlaylistTrackList" ItemsSource="{Binding PlaylistTracks}"
                             MouseDoubleClick="OnPlaylistTrackDoubleClick"
                             Background="Transparent" BorderThickness="0"
                             HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Title, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBody}"
                                               Foreground="{StaticResource Brush_TextPrimary}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Subtitle, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Border Grid.Column="2" Background="{StaticResource Brush_AccentSoft}"
                                            CornerRadius="{DynamicResource Radius_MD}" Padding="6,1" Margin="0,0,8,0"
                                            Visibility="{Binding Badge, Converter={StaticResource StrToVis}}">
                                        <TextBlock Text="{Binding Badge, Mode=OneWay}"
                                                   FontSize="{DynamicResource Font_SizeCaption}"
                                                   Foreground="{StaticResource Brush_Accent}"/>
                                    </Border>
                                    <TextBlock Grid.Column="3" Text="{Binding DurationText, Mode=OneWay}"
                                               FontSize="{DynamicResource Font_SizeBodySm}"
                                               Foreground="{StaticResource Brush_TextMuted}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- 右：推荐 + 播放队列 -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="每日推荐" FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextSecondary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Height="22" Padding="8,0"
                            Content="刷新" Command="{Binding LoadRecommendationsCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLoadingRecommendations, Mode=OneWay}" Value="True">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                <ListBox Grid.Row="2" x:Name="DailyRecommendList" ItemsSource="{Binding DailyRecommend}"
                         MouseDoubleClick="OnDailyRecommendDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="2" Text="{Binding Title, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="推荐歌单" FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextSecondary}" Margin="0,6,0,4"/>
                <ListBox Grid.Row="4" x:Name="RecommendedPlaylistList" ItemsSource="{Binding RecommendedPlaylists}"
                         MouseDoubleClick="OnRecommendedPlaylistDoubleClick"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="2" Text="{Binding Title, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="5" Text="Up Next" FontSize="{DynamicResource Font_SizeBodySm}"
                           Foreground="{StaticResource Brush_TextSecondary}" Margin="0,6,0,4"/>
                <ListBox Grid.Row="6" ItemsSource="{Binding UpNext}"
                         Background="Transparent" BorderThickness="0"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Margin="2" Text="{Binding Name, Mode=OneWay}"
                                       FontSize="{DynamicResource Font_SizeBodySm}"
                                       Foreground="{StaticResource Brush_TextPrimary}"
                                       TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>

        <!-- 底部常驻播放条（点击空白区展开完整播放器） -->
        <Border Grid.Row="3" Margin="0,8,0,0" Padding="12,8"
                Background="{StaticResource Brush_SurfaceAlt}"
                CornerRadius="{DynamicResource Radius_LG}"
                MouseLeftButtonDown="OnBottomBarTap">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="52" Height="52"
                        Background="{StaticResource Brush_Surface}" CornerRadius="{DynamicResource Radius_MD}"/>
                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                    <TextBlock Text="{Binding CurrentTitle}" FontSize="{DynamicResource Font_SizeBody}"
                               Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding CurrentSub}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" TextTrimming="CharacterEllipsis"/>
                    <Slider x:Name="SeekSlider" Maximum="100"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            Height="18" Margin="0,4,0,0"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnSeekDragCompleted"/>
                    <Grid>
                        <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeMicro}"
                                   Foreground="{StaticResource Brush_TextMuted}"/>
                        <TextBlock Grid.Column="0" Text="{Binding PositionDurationText, Mode=OneWay}"
                                   HorizontalAlignment="Right"
                                   FontSize="{DynamicResource Font_SizeMicro}"
                                   Foreground="{StaticResource Brush_TextMuted}"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                            IsEnabled="{Binding IsEngineReady}">
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="上一首" Margin="0,0,6,0"
                            Command="{Binding PreviousCommand}"/>
                    <Button Height="30" Margin="0,0,6,0" MinWidth="56"
                            Command="{Binding PlayPauseCommand}">
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="播放"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter Property="Text" Value="暂停"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="下一首" Margin="0,0,6,0"
                            Command="{Binding NextCommand}"/>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Margin="0,0,6,0"
                            Command="{Binding ToggleModeCommand}">
                        <TextBlock Text="{Binding ModeText, Mode=OneWay}"/>
                    </Button>
                    <Button Style="{StaticResource RowActionButton}" Height="30" Content="展开"
                            Command="{Binding OpenFullPlayerCommand}"/>
                    <TextBlock Text="播放引擎未就绪" Margin="10,0,0,0" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_Warning}"
                               Visibility="{Binding IsEngineReady, Converter={StaticResource InverseToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 完整播放器覆盖层（2026-09-08 参考网易云全屏播放器重设计；不显示队列——用户裁定） ═══ -->
        <Grid Grid.Row="0" Grid.RowSpan="4" ClipToBounds="True"
              Visibility="{Binding IsFullPlayerOpen, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 背景层（OM-6 三风格，Visibility 显隐；控制条/顶栏浮于其上） -->
            <Grid Grid.RowSpan="3">
                <Border Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.85">
                            <GradientStop Color="{DynamicResource Color_PlayerBgFrom}" Offset="0"/>
                            <GradientStop Color="{DynamicResource Color_PlayerBgTo}" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Grid Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}">
                    <Border>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.85">
                                <GradientStop Color="{DynamicResource Color_PlayerBgFrom}" Offset="0"/>
                                <GradientStop Color="{DynamicResource Color_PlayerBgTo}" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                    <Border Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Background="{StaticResource Brush_CoverOverlay}"/>
                </Grid>
                <Border Background="{StaticResource Brush_Background}"
                        Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <!-- ① 顶栏：收起（左）+ 风格切换 / 音质菜单（右） -->
            <Grid Grid.Row="0">
                <Button HorizontalAlignment="Left" Margin="20,14,0,0"
                        Width="40" Height="40" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        Command="{Binding CloseFullPlayerCommand}" ToolTip="收起播放器">
                    <Path Data="M7,10 L13,16 L19,10" StrokeLineJoin="Round"
                          Stroke="{StaticResource Brush_TextPrimary}" StrokeThickness="2"/>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,20,0">
                    <TextBlock Text="{Binding SelectedQualityText, Mode=OneWay}" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}" Margin="0,0,10,0"/>
                    <Button Height="30" Padding="10,0" Content="彩胶" Margin="0,0,6,0"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Vinyl">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsVinylStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Padding="10,0" Content="沉浸" Margin="0,0,6,0"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Immersion">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsImmersionStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Padding="10,0" Content="现代"
                            Command="{Binding SwitchPlayerStyleCommand}" CommandParameter="Modern">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowActionButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModernStyle, Mode=OneWay}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Height="30" Padding="10,0" Content="音质" Margin="8,0,0,0">
                        <Button.ContextMenu>
                            <!-- ContextMenu 独立可视树：命令/数据经 PlacementTarget 回主树（GameManager 同款套路） -->
                            <ContextMenu Style="{StaticResource ToolkitContextMenu}"
                                         DataContext="{Binding PlacementTarget.DataContext,
                                                         RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="母带" Command="{Binding SetQualityCommand}"
                                          CommandParameter="jymaster" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="Hi-Res" Command="{Binding SetQualityCommand}"
                                          CommandParameter="hires" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="无损" Command="{Binding SetQualityCommand}"
                                          CommandParameter="lossless" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="高品质" Command="{Binding SetQualityCommand}"
                                          CommandParameter="exhigh" Style="{StaticResource ToolkitMenuItem}"/>
                                <MenuItem Header="标准" Command="{Binding SetQualityCommand}"
                                          CommandParameter="standard" Style="{StaticResource ToolkitMenuItem}"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ② 内容层：三风格主视觉模板（共享 Row1，各按 Visibility 显隐） -->
            <Grid Grid.Row="1">
                <!-- 模板① 透明彩胶：左歌词流 + 右黑胶（2026-09-08 重设计布局原样保留，默认风格） -->
                <Grid Visibility="{Binding IsVinylStyle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                <!-- 左：标题 / 艺术家 / 歌词流 -->
                <Grid Grid.Column="0" Margin="72,8,48,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="{Binding CurrentTitle, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeTitleLg}"
                               Foreground="{StaticResource Brush_TextPrimary}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{Binding CurrentSub, Mode=OneWay}"
                               Margin="0,8,0,20"
                               FontSize="{DynamicResource Font_SizeBody}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextTrimming="CharacterEllipsis"/>
                    <ListBox Grid.Row="2" x:Name="FullLyricsList"
                             ItemsSource="{Binding LyricRows}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="0,12"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font_SizeBodyLg}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center"
                               Text="{Binding LyricsHint, Mode=OneWay}"
                               FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               TextWrapping="Wrap"
                               Visibility="{Binding LyricsHint, Converter={StaticResource StrToVis}}"/>
                </Grid>

                <!-- 右：黑胶唱片（右缘出血；播放时旋转，暂停保持角度——纯 XAML Storyboard） -->
                <Grid Grid.Column="1" x:Name="DiscHost" Width="540" Height="540"
                      Margin="0,-100,-170,-100" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <RotateTransform x:Name="DiscRotation"/>
                    </Grid.RenderTransform>
                    <!-- 旋转控制经 code-behind（🔴 Style 的 DataTrigger 无法引用元素树 NameScope
                         中的 BeginStoryboardName——跨 NameScope 必抛 InvalidOperationException，
                         2026-09-08 真机实证） -->
                    <Ellipse Fill="{StaticResource Brush_PlayerVinyl}"/>
                    <Ellipse Margin="26" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.35"/>
                    <Ellipse Margin="52" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.28"/>
                    <Ellipse Margin="78" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.22"/>
                    <Ellipse Margin="104" Stroke="{StaticResource Brush_DiscGroove}" StrokeThickness="1" Opacity="0.16"/>
                    <Ellipse Margin="168" Fill="{StaticResource Brush_PlayerLabel}"/>
                    <Path Data="M12,4 L24,2 L24,16 A3.2,2.8 0 1,1 20.8,13 L20.8,6 L15.2,7 L15.2,18 A3.2,2.8 0 1,1 12,15 Z"
                          Fill="{StaticResource Brush_Background}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                </Grid>

                <!-- 模板② 沉浸：封面出血背景已由背景层承担；内容 = 居左大歌词流（随曲滚动） -->
                <Grid Visibility="{Binding IsImmersionStyle, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="120,24,200,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding CurrentTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeTitleLg}"
                                   Foreground="{StaticResource Brush_TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding CurrentSub, Mode=OneWay}"
                                   Margin="0,8,0,18"
                                   FontSize="{DynamicResource Font_SizeBody}"
                                   Foreground="{StaticResource Brush_TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ListBox Grid.Row="2" x:Name="ImmersionLyricsList"
                                 ItemsSource="{Binding LyricRows}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="0,14"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource Font_SizeBodyLg}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>

                <!-- 模板③ 现代：白净表面（背景层承担）+ 左侧封面卡 + 右侧标题/歌词列 -->
                <Grid Visibility="{Binding IsModernStyle, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="240" Height="240"
                            Margin="0,0,0,0" CornerRadius="{DynamicResource Radius_LG}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Visibility="{Binding HasCover, Converter={StaticResource BoolToVis}}">
                        <Border.Background>
                            <ImageBrush ImageSource="{Binding CurrentCoverImage, Mode=OneWay}" Stretch="UniformToFill"/>
                        </Border.Background>
                    </Border>
                    <Border Grid.Column="0" Width="240" Height="240"
                            CornerRadius="{DynamicResource Radius_LG}"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Background="{StaticResource Brush_Surface}"
                            Visibility="{Binding HasCover, Converter={StaticResource InverseToVis}}">
                        <TextBlock Text="无封面" FontSize="{DynamicResource Font_SizeCaption}"
                                   Foreground="{StaticResource Brush_TextMuted}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Grid Grid.Column="1" Margin="8,40,120,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="{Binding CurrentTitle, Mode=OneWay}"
                                   FontSize="{DynamicResource Font_SizeTitleLg}"
                                   Foreground="{StaticResource Brush_TextPrimary}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="1" Text="{Binding CurrentSub, Mode=OneWay}"
                                   Margin="0,8,0,18"
                                   FontSize="{DynamicResource Font_SizeBody}"
                                   Foreground="{StaticResource Brush_TextMuted}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ListBox Grid.Row="2" x:Name="ModernLyricsList"
                                 ItemsSource="{Binding LyricRows}"
                                 Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 VirtualizingPanel.VirtualizationMode="Recycling">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="0,10"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text, Mode=OneWay}"
                                               TextWrapping="Wrap"
                                               FontSize="{DynamicResource Font_SizeBody}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </Grid>

            <!-- ③ 底控制栏：模式 + 传输 + 分列进度（引擎未就绪整组禁用） -->
            <Grid Grid.Row="2" Margin="72,0,72,26" IsEnabled="{Binding IsEngineReady}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Width="44" Height="40" Margin="0,0,28,0" Content="上一首"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding PreviousCommand}"/>
                    <Button Width="56" Height="56" Padding="0"
                            Background="{StaticResource Brush_Accent}" BorderThickness="0"
                            Command="{Binding PlayPauseCommand}" ToolTip="播放 / 暂停">
                        <Grid>
                            <Path Fill="{StaticResource Brush_Background}" Data="M9,6 L21,13 L9,20 Z"
                                  Visibility="{Binding IsPlaying, Converter={StaticResource InverseToVis}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVis}}">
                                <Rectangle Width="5" Height="20" Fill="{StaticResource Brush_Background}" RadiusX="1.5" RadiusY="1.5"/>
                                <Rectangle Width="5" Height="20" Fill="{StaticResource Brush_Background}" RadiusX="1.5" RadiusY="1.5" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Width="44" Height="40" Margin="28,0,0,0" Content="下一首"
                            Style="{StaticResource RowActionButton}"
                            Command="{Binding NextCommand}"/>
                </StackPanel>
                <Grid Grid.Row="1" Margin="40,16,40,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="48"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PositionCurrentText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" x:Name="FullSeekSlider" Margin="16,0" Maximum="100" Height="6"
                            Value="{Binding ProgressValue, Mode=OneWay}"
                            IsMoveToPointEnabled="True"
                            Thumb.DragStarted="OnSeekDragStarted"
                            Thumb.DragCompleted="OnFullSeekDragCompleted"
                            VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding PositionDurationText, Mode=OneWay}" FontSize="{DynamicResource Font_SizeCaption}"
                               Foreground="{StaticResource Brush_TextMuted}"
                               HorizontalAlignment="Left" VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
