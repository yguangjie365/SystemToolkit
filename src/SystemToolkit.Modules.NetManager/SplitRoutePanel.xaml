<UserControl x:Class="SystemToolkit.Modules.NetManager.SplitRoutePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700" d:DesignWidth="1300">
    <!-- 网络管理第 6 Tab「分流路由」（NET-7，示意图 2026-09-12 批准）。
         DataContext = SplitRouteTabViewModel（父视图 {Binding Split} 注入）。
         示意图的「彻底模式（注册表根治）」降级 V1.1——此处以「守护巡检」开关承载同等效果。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NicListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>
        <Style x:Key="CidrTag" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource Radius_MD}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Brush_Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════ 警示条（示意图 ① banner：常显，非错误态）════════ -->
        <Border Grid.Row="0" CornerRadius="{DynamicResource Radius_LG}" Background="{DynamicResource Brush_WarningSoft}"
                BorderBrush="{DynamicResource Brush_Border}" BorderThickness="1" Padding="12,8">
            <TextBlock TextWrapping="Wrap" FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_Warning}">
                ⚠ 应用瞬间默认路由切换，网络可能短暂中断（数秒）；远程机器请先确认带外恢复路径，并暂时退出 VPN / 代理类软件。
            </TextBlock>
        </Border>

        <!-- ════════ 重启自检黄条（持久路由缺失时出现）════════ -->
        <Border Grid.Row="1" Margin="0,10,0,0" CornerRadius="{DynamicResource Radius_LG}"
                Background="{DynamicResource Brush_WarningSoft}" BorderBrush="{DynamicResource Brush_Border}"
                BorderThickness="1" Padding="12,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelfCheckWarning}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding SelfCheckWarning}" TextWrapping="Wrap" FontSize="{DynamicResource Font_SizeBodySm}"
                       Foreground="{DynamicResource Brush_Warning}"/>
        </Border>

        <!-- ════════ 配置卡 + 验证卡 ════════ -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource ToolCard}">
                <StackPanel>
                    <TextBlock Text="分流配置" Style="{DynamicResource CardTitle}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="外网出口（唯一默认路由）" Style="{DynamicResource KvLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ThemedComboBox}" FontSize="{DynamicResource Font_SizeBodySm}"
                                      ItemsSource="{Binding NicOptions}" SelectedItem="{Binding SelectedWan}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="内网出口（按网段指路）" Style="{DynamicResource KvLabel}" Margin="0,0,0,4"/>
                            <ComboBox Style="{DynamicResource ThemedComboBox}" FontSize="{DynamicResource Font_SizeBodySm}"
                                      ItemsSource="{Binding NicOptions}" SelectedItem="{Binding SelectedLan}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="内网网段（CIDR，最长前缀优先走内网口）" Style="{DynamicResource KvLabel}" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <ItemsControl ItemsSource="{Binding Cidrs}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CidrTag}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding}" FontFamily="{DynamicResource Font_Mono}"
                                                       FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                            <Button Content="×" Margin="6,0,0,0" Padding="2,0" MinWidth="0" MinHeight="0"
                                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="{DynamicResource Brush_DangerText}"
                                                    Command="{Binding DataContext.RemoveCidrCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBox Width="200" Style="{DynamicResource FieldInput}"
                                 Text="{Binding CidrInput, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Style="{DynamicResource CardButton}" Content="添加网段" Margin="8,0,0,0"
                                Command="{Binding AddCidrCommand}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ToggleButton Style="{DynamicResource ThemedToggleButton}" IsChecked="{Binding IsGuardOn}"
                                      Command="{Binding ToggleGuardCommand}" VerticalAlignment="Center"
                                      ToolTip="每 60 秒巡检一次：DHCP 续租把默认路由加回内网卡时立即清退（分流失效头号原因）"/>
                        <TextBlock VerticalAlignment="Center" Margin="6,0,0,0"
                                   FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}">
                            守护巡检（60s）· 已清退回潮 <Run Text="{Binding SweepCount, Mode=OneWay}"/> 条
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{DynamicResource RowPrimaryButton}" Content="应用分流" Command="{Binding ApplyCommand}"/>
                        <Button Style="{DynamicResource CardButton}" Content="重新验证" Margin="8,0,0,0" Command="{Binding ReverifyCommand}"/>
                        <Button Style="{DynamicResource SecondaryButton}" Content="恢复原路由" Margin="8,0,0,0" Command="{Binding RestoreCommand}"/>
                        <Border Style="{StaticResource CidrTag}" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppliedText}" FontSize="{DynamicResource Font_SizeMicro}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush_TextSecondary}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding SelectionError}" Style="{DynamicResource FieldError}" Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource ToolCard}">
                <StackPanel>
                    <TextBlock Text="生效验证" Style="{DynamicResource CardTitle}"/>
                    <TextBlock Text="{Binding VerifySummary}" TextWrapping="Wrap" Style="{DynamicResource KvValue}" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{DynamicResource Brush_TextMuted}"
                               Text="三判据：默认路由唯一走外网口 · 外网连通（223.5.5.5）· 内网网关可达。应用后自动验证，失败自动回滚；也可随时手动重验。"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ════════ 台账卡（只删自建四要素——参考项目纪律）════════ -->
        <Border Grid.Row="3" Style="{DynamicResource ToolCard}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBlock Text="本工具创建的路由（恢复时按台账精确删除，系统原有路由不触碰）" Style="{DynamicResource CardTitle}"/>
                    <TextBlock HorizontalAlignment="Right" FontSize="{DynamicResource Font_SizeMicro}"
                               Foreground="{DynamicResource Brush_TextMuted}"><Run Text="{Binding LedgerRows.Count, Mode=OneWay}"/><Run Text=" 条"/></TextBlock>
                </Grid>
                <ListView Grid.Row="1" ItemsSource="{Binding LedgerRows}" BorderThickness="0" Margin="0,8,0,0"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource NicListHeader}">
                            <GridViewColumn Header="类别" Width="150">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding KindText}" FontSize="{DynamicResource Font_SizeBodySm}"
                                                   Foreground="{DynamicResource Brush_TextSecondary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="目标" Width="140">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Prefix}" FontFamily="{DynamicResource Font_Mono}"
                                                   FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="网关" Width="130">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Nexthop}" FontFamily="{DynamicResource Font_Mono}"
                                                   FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="接口">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding InterfaceName}" FontSize="{DynamicResource Font_SizeBodySm}"
                                                   Foreground="{DynamicResource Brush_TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Grid.Row="1" Text="尚未应用分流——应用后本表列出台账条目" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="{DynamicResource Font_SizeBodySm}" Foreground="{DynamicResource Brush_TextMuted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding LedgerRows.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
