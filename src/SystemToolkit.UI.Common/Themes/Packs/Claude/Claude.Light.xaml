<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--
      ============================================================
      Claude 主题 · Light 包（初始风格，唯一交付主题）
      依据：Docs/04-UI设计规范.md 五维令牌 / ADR-003
      规则：页面禁止裸写颜色，一律引用本字典的 Brush_* 键
      ============================================================
    -->

    <!-- ===== 颜色（M-UI-1 落地 2026-09-05：暖米→冷灰白 + 暖棕主色→深青；
         暖系成功/警告/危险→Tailwind 标准 emerald/amber/red；
         改值不改 key，TokenKeys 契约不变，4 个模块 200+ 引用同步刷新） ===== -->
    <Color x:Key="Color_Bg">#F7F8FA</Color>
    <Color x:Key="Color_SurfaceAlt">#F1F3F5</Color>
    <Color x:Key="Color_Surface">#ffffff</Color>
    <Color x:Key="Color_Border">#E5E7EB</Color>
    <Color x:Key="Color_Track">#E5E7EB</Color>
    <Color x:Key="Color_TextPrimary">#111827</Color>
    <Color x:Key="Color_TextSecondary">#4B5563</Color>
    <!-- M-UI-2（2026-09-06）：#6B7280→#616D7C——SurfaceAlt(#F1F3F5) 底 4.35→4.74 达 WCAG AA；
         白底 5.27 / Bg 底 4.96，与 TextSecondary(7.56) 仍保持档位距离 -->
    <Color x:Key="Color_TextMuted">#616D7C</Color>
    <Color x:Key="Color_Accent">#0F766E</Color>
    <!-- M-UI-2：交互状态色（hover 取 GameManager.html 参考稿同款 #0D6D66） -->
    <Color x:Key="Color_AccentHover">#0D6D66</Color>
    <Color x:Key="Color_AccentPressed">#0B5F59</Color>
    <Color x:Key="Color_Success">#047857</Color>
    <Color x:Key="Color_Warning">#B45309</Color>
    <!-- M-UI-2：#DC2626→#B91C1C（red-600→700）——DangerSoft(#FDE8E8) 底 4.11→5.51 达 WCAG AA；
         延续 M-UI-1b「语义色文字走 700 档」决策 -->
    <Color x:Key="Color_Danger">#B91C1C</Color>
    <!-- M-UI-2：分段条警戒段亮橙纳入 Color_ 契约（原 Brush 硬编码，审查指认契约缺口） -->
    <Color x:Key="Color_SegWarn">#FB923C</Color>
    <Color x:Key="Color_DarkSurface">#1F2937</Color>
    <Color x:Key="Color_OnDark">#F9FAFB</Color>
    <!-- 状态语义（2026-09-08 阶段 2）：延续 M-UI-2「语义色 700 档」决策；
         Info=blue-700 / Disabled=gray-400（WCAG 对 disabled 元素豁免对比度）/
         Focus 同 Accent-teal-700（语义独立便于调整）/ Selection=teal-100 选中底 -->
    <Color x:Key="Color_Info">#1D4ED8</Color>
    <Color x:Key="Color_Disabled">#9CA3AF</Color>
    <Color x:Key="Color_Focus">#0F766E</Color>
    <Color x:Key="Color_Selection">#CCFBF1</Color>

    <!-- ===== 画刷 ===== -->
    <SolidColorBrush x:Key="Brush_Bg" Color="{StaticResource Color_Bg}"/>
    <SolidColorBrush x:Key="Brush_SurfaceAlt" Color="{StaticResource Color_SurfaceAlt}"/>
    <SolidColorBrush x:Key="Brush_Surface" Color="{StaticResource Color_Surface}"/>
    <SolidColorBrush x:Key="Brush_Border" Color="{StaticResource Color_Border}"/>
    <!-- 卡片边框（UI 审计采纳：极浅于 Brush_Border，弱化"白盒拼装"感） -->
    <SolidColorBrush x:Key="Brush_Track" Color="{StaticResource Color_Track}"/>
    <SolidColorBrush x:Key="Brush_TextPrimary" Color="{StaticResource Color_TextPrimary}"/>
    <SolidColorBrush x:Key="Brush_TextSecondary" Color="{StaticResource Color_TextSecondary}"/>
    <SolidColorBrush x:Key="Brush_TextMuted" Color="{StaticResource Color_TextMuted}"/>
    <SolidColorBrush x:Key="Brush_Accent" Color="{StaticResource Color_Accent}"/>
    <SolidColorBrush x:Key="Brush_AccentHover" Color="{StaticResource Color_AccentHover}"/>
    <SolidColorBrush x:Key="Brush_AccentPressed" Color="{StaticResource Color_AccentPressed}"/>
    <SolidColorBrush x:Key="Brush_Success" Color="{StaticResource Color_Success}"/>
    <SolidColorBrush x:Key="Brush_Warning" Color="{StaticResource Color_Warning}"/>
    <!-- 分段条 60-85% 警戒段专用亮橙（与 Warning #F59E0B 保持视觉区分；M-UI-1 同步换系；
         M-UI-2 纳入 Color_ 契约） -->
    <SolidColorBrush x:Key="Brush_SegWarn" Color="{StaticResource Color_SegWarn}"/>
    <SolidColorBrush x:Key="Brush_Danger" Color="{StaticResource Color_Danger}"/>
    <!-- 软色（低透明度底，用于徽章/图标底块；M-UI-1 改值同步新主色） -->
    <SolidColorBrush x:Key="Brush_DangerSoft" Color="#1FEF4444"/>
    <SolidColorBrush x:Key="Brush_DangerBorder" Color="#66EF4444"/>
    <SolidColorBrush x:Key="Brush_DarkSurface" Color="{StaticResource Color_DarkSurface}"/>
    <SolidColorBrush x:Key="Brush_OnDark" Color="{StaticResource Color_OnDark}"/>
    <SolidColorBrush x:Key="Brush_AccentSoft" Color="#1F0F766E"/>
    <SolidColorBrush x:Key="Brush_SuccessSoft" Color="#1F10B981"/>
    <SolidColorBrush x:Key="Brush_WarningSoft" Color="#1FF59E0B"/>
    <SolidColorBrush x:Key="Brush_NavySoft" Color="#1F111827"/>
    <SolidColorBrush x:Key="Brush_SuccessBorder" Color="#6610B981"/>
    <SolidColorBrush x:Key="Brush_OnDarkMuted" Color="#9CA3AF"/>
    <!-- 卡片封面遮罩（M-UI-2 游戏页审查处置：原在 GameManagerView 页面资源裸写 ARGB，
         违反「页面禁止裸写颜色」契约——收编进主题；游戏卡片封面模式可跨模块复用） -->
    <LinearGradientBrush x:Key="Brush_CoverFade" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#14000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Brush_CoverOverlay" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#00000000" Offset="0"/>
        <GradientStop Color="#80000000" Offset="1"/>
    </LinearGradientBrush>
    <!-- 深色容器语义色（M-UI-2 游戏页审查处置：反馈条按成功/失败着色。
         语义色 700 档在 DarkSurface 上对比不足，用 400 档：Success 7.64 / Danger 5.31，均达 AA） -->
    <SolidColorBrush x:Key="Brush_SuccessOnDark" Color="#34D399"/>
    <SolidColorBrush x:Key="Brush_DangerOnDark" Color="#F87171"/>
    <SolidColorBrush x:Key="Brush_Info" Color="{StaticResource Color_Info}"/>
    <SolidColorBrush x:Key="Brush_Disabled" Color="{StaticResource Color_Disabled}"/>
    <SolidColorBrush x:Key="Brush_Focus" Color="{StaticResource Color_Focus}"/>
    <SolidColorBrush x:Key="Brush_Selection" Color="{StaticResource Color_Selection}"/>

    <!-- ===== 字体族（五款打包字体按 NOTICE.md §五加载；西文在前中文在后按字符回退） ===== -->
    <!-- 正文：Inter（西文）→ HarmonyOS Sans SC（中文）→ 系统兜底 -->
    <FontFamily x:Key="Font_Body">pack://application:,,,/Resources/Fonts/Inter/#Inter, pack://application:,,,/Resources/Fonts/HarmonyOS/#HarmonyOS Sans SC, Microsoft YaHei UI</FontFamily>
    <!-- 等宽：JetBrains Mono → Cascadia/Consolas（西文）→ HarmonyOS Sans SC（中文，修复同串汉字粗细不一致） -->
    <FontFamily x:Key="Font_Mono">pack://application:,,,/Resources/Fonts/JetBrainsMono/#JetBrains Mono, Cascadia Mono, Consolas, pack://application:,,,/Resources/Fonts/HarmonyOS/#HarmonyOS Sans SC, Microsoft YaHei UI</FontFamily>
    <!-- 中文品牌字（霞鹜文楷）：仅限关于页/空态标语等"说话"场合，禁止界面正文 -->
    <FontFamily x:Key="Font_TitleZh">pack://application:,,,/Resources/Fonts/LXGWWenKai/#LXGW WenKai, pack://application:,,,/Resources/Fonts/HarmonyOS/#HarmonyOS Sans SC, Microsoft YaHei UI</FontFamily>
    <!-- 西文字标（Cormorant Garamond）：仅限大字号品牌场合（≥20px，小字号笔画发虚） -->
    <FontFamily x:Key="Font_TitleEn">pack://application:,,,/Resources/Fonts/CormorantGaramond/#Cormorant Garamond, pack://application:,,,/Resources/Fonts/Inter/#Inter</FontFamily>

    <!-- ===== 字号（07 分册定档；展示名即令牌，禁字面量；棘轮只减不增。
         M-UI-2（2026-09-06）：12.5/12/11.5 三档 0.5px 间距肉眼不可辨（审查核验属实）——
         BodySm 12.5→12 并入 Caption 档、Mono 11.5→11 并入 Tiny 档，梯度收敛为整数步进；
         改值不改 key，全站引用同步刷新） ===== -->
    <sys:Double x:Key="Font_SizeDisplay">22</sys:Double>
    <sys:Double x:Key="Font_SizeMetric">18.5</sys:Double>
    <sys:Double x:Key="Font_SizeTitleLg">17</sys:Double>
    <sys:Double x:Key="Font_SizeTitle">14.5</sys:Double>
    <sys:Double x:Key="Font_SizeBodyLg">14</sys:Double>
    <sys:Double x:Key="Font_SizeBody">13</sys:Double>
    <sys:Double x:Key="Font_SizeBodySm">12</sys:Double>
    <sys:Double x:Key="Font_SizeCaption">12</sys:Double>
    <sys:Double x:Key="Font_SizeMono">11</sys:Double>
    <sys:Double x:Key="Font_SizeTiny">11</sys:Double>
    <sys:Double x:Key="Font_SizeMicro">10</sys:Double>
    <sys:Double x:Key="Font_SizeNano">8.5</sys:Double>

    <!-- ===== 字重 / 行高（M-UI-2 新增：供逐步采用，不强制替换现有 FontWeight="Bold" 用法；
         行高为像素值，按 Body 13px 基准的 1.25/1.4/1.65 倍取整） ===== -->
    <FontWeight x:Key="Font_WeightRegular">Normal</FontWeight>
    <FontWeight x:Key="Font_WeightMedium">SemiBold</FontWeight>
    <FontWeight x:Key="Font_WeightBold">Bold</FontWeight>
    <sys:Double x:Key="Font_LineHeightCompact">16</sys:Double>
    <sys:Double x:Key="Font_LineHeightNormal">18</sys:Double>
    <sys:Double x:Key="Font_LineHeightRelaxed">22</sys:Double>

    <!-- ===== 圆角（M-UI-1b 微调 2026-09-06：整体上调一档
          原 3/4/5/6/7/10 在高分屏上偏「系统原生味」，上调后更接近现代桌面工具观感；
          只改值不改 key——TokenKeys 契约零变更，全站引用同步刷新） ===== -->
    <CornerRadius x:Key="Radius_Chip">4</CornerRadius>
    <CornerRadius x:Key="Radius_Control">6</CornerRadius>
    <CornerRadius x:Key="Radius_Badge">6</CornerRadius>
    <CornerRadius x:Key="Radius_CardSm">8</CornerRadius>
    <CornerRadius x:Key="Radius_Card">10</CornerRadius>
    <CornerRadius x:Key="Radius_CardLg">12</CornerRadius>

    <!-- ===== 间距（04 规范 4px 栅格） ===== -->
    <Thickness x:Key="Space_Xxs">4</Thickness>
    <Thickness x:Key="Space_Xs">8</Thickness>
    <Thickness x:Key="Space_Sm">12</Thickness>
    <Thickness x:Key="Space_Md">16</Thickness>
    <Thickness x:Key="Space_Lg">24</Thickness>

    <!-- ===== 通用轻样式 ===== -->
    <!-- 卡片（04 规范 Elevation_Card：靠色阶区分层次，不靠阴影——去掉阴影后结构不散才算合格）。
         圆角/内边距走令牌；边框取 Brush_Border（比 CardBorder 深半档，弱描边仍保持克制） -->
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource Radius_Card}"/>
        <Setter Property="Padding" Value="{DynamicResource Space_Md}"/>
    </Style>

    <!-- 卡片（可交互）：M-UI-2 落地（2026-09-05）
         基于 CardBorder，hover 时边框转深青 + 加粗至 1.5；不破坏"克制描边"基调；
         适用：Overview 4 卡片、AppManager 列表卡片等"鼠标进入有反馈"的容器 -->
    <Style x:Key="CardBorderInteractive" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                <Setter Property="BorderThickness" Value="1.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="MonoText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font_Mono}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
    </Style>

    <Style x:Key="SectionLabel" TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>

    <!-- ===== 细滚动条（P3 氛围层：默认粗滚动条带箭头按钮，是"系统味"主要来源之一。
         轨道透明、拇指圆角、hover 加深；纵/横双形态由模板触发器切换。全应用隐式生效） ===== -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width" Value="8"/>
        <Setter Property="MinWidth" Value="8"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border x:Name="ThumbBg" Background="{StaticResource Brush_Border}"
                                                    CornerRadius="{DynamicResource Radius_Control}"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background"
                                                            Value="{StaticResource Brush_TextMuted}"/>
                                                </Trigger>
                                                <!-- M-UI-2：补 pressed 态（审查核验属实：此前只有 hover） -->
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBg" Property="Background"
                                                            Value="{StaticResource Brush_TextSecondary}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter Property="Width" Value="Auto"/>
                            <Setter Property="MinWidth" Value="0"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="MinHeight" Value="8"/>
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 主按钮（深青；M-UI-1b 微调 2026-09-06：Padding 12,5 → 14,7，
         原垂直内边距 5 使按钮偏扁，加大后更稳重；FontSize 沿用字面量 12 保持既有观感）。
         M-UI-2：补交互触发器——hover/pressed 走 Accent 状态色阶，disabled 走透明度 0.4
         （与 GameManager.html 参考稿 button:disabled 语义一致；对 Secondary 同样生效） -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_OnDark}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_AccentHover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_AccentPressed}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- 次按钮：BasedOn 主按钮但**覆写 hover/pressed**（Background 回 Surface 压掉基类 Accent 触发，
         改走参考稿 .btn-secondary:hover 语义：边框+文字转 Accent，pressed 加 AccentSoft 底） -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- LIVE / PAUSED 徽章：直角（用户 2026-09-04 明确，与按钮一致） -->
    <Style x:Key="LiveBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush_SuccessSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_SuccessBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="Padding" Value="8,3"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- ===== NetManagerView 提升样式（2026-09-06 系统性审查 P0-3：消灭页面内重复定义） ===== -->
    
    <!-- 筛选药丸基样式（原 AppManager/DriverManager/NetManager 同款局部定义；SectionTab 基于它） -->
    <Style x:Key="FilterChip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="ChipBg" Background="{StaticResource Brush_Surface}"
                            BorderBrush="{StaticResource Brush_Border}" BorderThickness="1"
                            CornerRadius="{DynamicResource Radius_CardLg}" Padding="12,3">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ChipBg" Property="Background" Value="{StaticResource Brush_Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_OnDark}"/>
                            <Setter TargetName="ChipBg" Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 标签段 Tab（底部 2px 深青指示线 + 文字加粗） -->
    <Style x:Key="SectionTab" TargetType="RadioButton" BasedOn="{StaticResource FilterChip}">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBody}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <StackPanel>
                            <ContentPresenter x:Name="Text" Margin="0,0,0,6"/>
                            <Border Height="2" CornerRadius="{DynamicResource Radius_Chip}" Background="Transparent"/>
                        </StackPanel>
                        <Border x:Name="Indicator" VerticalAlignment="Bottom" Height="2"
                                CornerRadius="{DynamicResource Radius_Chip}" Background="Transparent"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Indicator" Property="Background" Value="{StaticResource Brush_Accent}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 行内按钮三件套（AppManager/NetManager 同款局部定义） -->
    <Style x:Key="RowActionButton" TargetType="Button">
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="64"/>
        <Setter Property="Padding" Value="12,0"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="RowDangerButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
        <Setter Property="Background" Value="{StaticResource Brush_DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_Danger}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_OnDark}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    
    <Style x:Key="RowPrimaryButton" TargetType="Button" BasedOn="{StaticResource RowActionButton}">
        <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_OnDark}"/>
    </Style>

    <!-- KV 对标签/值（NetManager 网卡详情/优化参数表单用） -->
    <Style x:Key="KvLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="KvValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 表单输入框（NetManager/AppManager 同款局部定义） -->
    <Style x:Key="FieldInput" TargetType="TextBox">
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="CaretBrush" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- 表单错误提示 -->
    <Style x:Key="FieldError" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- 卡片按钮（小号 SecondaryButton，用于卡片内紧凑操作） -->
    <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
        <Setter Property="Padding" Value="10,4"/>
    </Style>

    <!-- 工具卡片容器（NetManager 诊断/修复页卡片；属性与 CardBorder 几乎相同，仅 Padding 差异） -->
    <!-- 注：推荐直接复用 CardBorder + 额外设置 Padding，此处保留仅为向后兼容 -->
    <Style x:Key="ToolCard" TargetType="Border" BasedOn="{StaticResource CardBorder}">
        <Setter Property="Padding" Value="14"/>
    </Style>

    <!-- 卡片标题（NetManager/AppManager 各卡片顶部标题） -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBody}"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- 列表日志/纯文本列表（FileTransfer/AppManager 同款；无边框透明背景） -->
    <Style x:Key="ListLog" TargetType="ListBox">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    </Style>

    <!-- ===== 原生控件皮肤化（2026-09-06 系统性审查 P0-1：消除 ComboBox/CheckBox/RadioButton 割裂感） ===== -->
    
    <!-- ComboBox 定制（深青边框+选中态 Accent 色；简单 Style 覆盖方案，非完整 ControlTemplate） -->
    <Style x:Key="ThemedComboBox" TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- CheckBox 定制（方框勾选+Accent 色；完整 ControlTemplate） -->
    <Style x:Key="ThemedCheckBox" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- 自定义方框 -->
                        <Border x:Name="CheckBoxBox" 
                                Width="16" Height="16" 
                                BorderBrush="{StaticResource Brush_Border}" 
                                BorderThickness="1.5"
                                CornerRadius="{DynamicResource Radius_Control}"
                                Background="{StaticResource Brush_Surface}">
                            <Path x:Name="CheckMark" 
                                  Data="M 1,4 L 4,8 L 8,1" 
                                  Stroke="{StaticResource Brush_Accent}" 
                                  StrokeThickness="2" 
                                  Visibility="Collapsed"
                                  HorizontalAlignment="Center" 
                                  VerticalAlignment="Center"/>
                        </Border>
                        
                        <ContentPresenter Grid.Column="1" 
                                          Margin="6,0,0,0" 
                                          VerticalAlignment="Center"/>
                    </Grid>
                    
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBoxBox" Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- RadioButton 定制（圆形选中点+Accent 色，用于 IP 模式切换等场景） -->
    <Style x:Key="ThemedRadioButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <!-- ToggleButton 定制（日志折叠按钮等透明背景场景） -->
    <Style x:Key="ThemedToggleButton" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== DriverManager 抽屉专用紧凑按钮（RailButton / RailDangerButton） =====
         与 RowActionButton 系列区分：更矮（26 vs 32）、最小宽度更大（112 vs 64）、左对齐文本、固定下边距8px -->
    <Style x:Key="CompactActionButton" TargetType="Button">
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="112"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="CompactDangerButton" TargetType="Button" BasedOn="{StaticResource CompactActionButton}">
        <Setter Property="Background" Value="{StaticResource Brush_DangerSoft}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Brush_Danger}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush_OnDark}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 列表头样式（DriverManager/NetManager/AppManager 共用；内容靠左对齐，深青边框+浅色背景） -->
    <Style x:Key="ListHeaderStyle" TargetType="GridViewColumnHeader">
        <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>

    <!-- 状态徽章基样式（DriverManager DriverStateBorder / AppManager StatusTagBorder 统一形态）
         StateKey 映射：0=当前/已安装(中性) 1=旧版本/有更新(琥珀) 2=系统关键/未安装(灰) 3=无关联/未知(Accent蓝) -->
    <Style x:Key="StateBadgeBorder" TargetType="Border">
        <Setter Property="CornerRadius" Value="{DynamicResource Radius_Chip}"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKey}" Value="1">
                <Setter Property="Background" Value="{StaticResource Brush_WarningSoft}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKey}" Value="2">
                <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKey}" Value="3">
                <Setter Property="Background" Value="{StaticResource Brush_AccentSoft}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="StateBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeMicro}"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding StateKey}" Value="1">
                <Setter Property="Foreground" Value="{StaticResource Brush_Warning}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKey}" Value="2">
                <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding StateKey}" Value="3">
                <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Expander 定制（三角形箭头+深青边框，用于驱动分组展开器） -->
    <Style x:Key="ThemedExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBody}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <!-- 头部：三角形箭头 + 标题 -->
                        <ToggleButton DockPanel.Dock="Top"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                      Background="Transparent" BorderThickness="0"
                                      Cursor="Hand" Padding="8,6" HorizontalContentAlignment="Stretch">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <StackPanel Orientation="Horizontal">
                                        <Path x:Name="Arrow" Data="M 0,0 L 4,4 L 0,8"
                                              Fill="{StaticResource Brush_TextSecondary}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 8,0 L 4,4"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Arrow" Property="Fill" Value="{StaticResource Brush_Accent}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <!-- 内容区 -->
                        <ContentPresenter Margin="8,4,8,8"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 数据行容器（审查 L5：三视图逐字拷贝收敛；密度差异经变体样式表达，观感不变） ===== -->
    <Style x:Key="ListItemRowBaseStyle" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListViewItem">
                    <Border x:Name="RowBg" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource Brush_Track}" BorderThickness="0,0,0,1">
                        <GridViewRowPresenter Content="{TemplateBinding Content}"
                                              Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBg" Property="Background" Value="{StaticResource Brush_AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- 紧凑密度（DriverManager） -->
    <Style x:Key="ListItemRowStyle" TargetType="ListViewItem" BasedOn="{StaticResource ListItemRowBaseStyle}">
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>
    <!-- 舒展密度（AppManager 三个列表；M-UI-2 落地 2026-09-05：44→52、6→10 撑开行高匹配按钮 32） -->
    <Style x:Key="ListItemRowTallStyle" TargetType="ListViewItem" BasedOn="{StaticResource ListItemRowBaseStyle}">
        <Setter Property="MinHeight" Value="52"/>
        <Setter Property="Padding" Value="10,10"/>
    </Style>

    <!-- ===== 分段选择项（M-UI-2 游戏页审查处置：替代系统 RadioButton 圆点样式。
         语义沿用 HTML 参考稿 .sort-group：选中=AccentSoft 底 + Accent 文字加粗；未选=Muted、hover=SurfaceAlt。
         用法：RadioButton 配此样式，GroupName 照旧，命令绑定不变。
         键盘焦点：IsKeyboardFocused → Accent 边框（FocusVisual 替代） ===== -->
    <Style x:Key="SegmentedRadioItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Pill" Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius_Chip}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{StaticResource Brush_AccentSoft}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                            <Setter Property="FontWeight" Value="{StaticResource Font_WeightBold}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                            <Setter TargetName="Pill" Property="BorderThickness" Value="1"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== 主题化 ContextMenu 三件套（M-UI-2 游戏页审查处置：菜单告别系统原生观感。
         显式样式（非隐式）——避免影响全应用其它 ContextMenu；游戏页 ⋯ 菜单显式引用。
         MenuItem 模板只覆盖本工具场景（文本项 + hover 高亮 + 语义危险色），不支持图标/子菜单 ===== -->
    <Style x:Key="ToolkitMenuSeparator" TargetType="Separator">
        <Setter Property="Background" Value="{StaticResource Brush_Track}"/>
        <Setter Property="Margin" Value="8,0"/>
        <Setter Property="Height" Value="1"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>
    <Style x:Key="ToolkitMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource Brush_TextSecondary}"/>
        <Setter Property="FontSize" Value="{DynamicResource Font_SizeBodySm}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="ItemBg" Background="Transparent" Padding="8,4">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="ItemBg" Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ToolkitMenuItemDanger" TargetType="MenuItem" BasedOn="{StaticResource ToolkitMenuItem}">
        <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToolkitContextMenu" TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Brush_Surface}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius_Card}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ItemsPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
