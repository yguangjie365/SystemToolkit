<UserControl x:Class="SystemToolkit.Modules.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SystemToolkit.UI.Common.Controls;assembly=SystemToolkit.UI.Common"
             xmlns:local="clr-namespace:SystemToolkit.Modules.Overview"
             Background="{StaticResource Brush_Background}">

    <UserControl.Resources>
        <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,22,0,14"/>
        </Style>
        <Style x:Key="AppListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- M-UI-2（2026-09-05）：LIVE 圆点脉动；作用于下方 x:Name="LiveDot" Ellipse；1.5s 慢节奏避视觉躁动 -->
        <Storyboard x:Key="OverviewLivePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity" From="0.55" To="1.0" Duration="0:0:0.75"/>
        </Storyboard>
        <!-- M-UI-2（2026-09-05）：详细信息行 hover 浅底（覆盖行内 Grid 的 IsMouseOver） -->
        <Style x:Key="DetailRow" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{DynamicResource Radius_XL}" Background="{StaticResource Brush_DarkSurface}">
                    <TextBlock Text="St" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="本机概览" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{StaticResource MonoText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource LiveBadge}" Height="30" Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- LIVE 脉动圆点（IsLive=True 时显示；M-UI-2 加 Storyboard 启动） -->
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource Brush_Success}" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource OverviewLivePulse}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- PAUSED 静态圆点（IsLive=False 时显示） -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{StaticResource Brush_TextMuted}" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{StaticResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                    <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                    <Setter Property="Text" Value="已暂停"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush_Success}"/>
                                            <Setter Property="Text" Value="LIVE · 每 2 秒"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Height="30" Content="导出报告"
                        Margin="0,0,8,0" Command="{Binding ExportReportCommand}"/>
                <!-- UI 审计采纳：刷新为辅助操作，降为图标按钮（高度与按钮组对齐）；M2 补接线 -->
                <Button Grid.Column="4" Style="{StaticResource SecondaryButton}" Height="30" Width="32"
                        Padding="0" ToolTip="立即刷新" Command="{Binding RefreshFullCommand}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeCaption}"/>
                </Button>
            </Grid>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="实时概览" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="OVERVIEW" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{StaticResource MonoText}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding StatCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorderInteractive}" Margin="0,0,12,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius_LG}" Background="{StaticResource Brush_AccentSoft}">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeBodyLg}" Foreground="{StaticResource Brush_Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="{DynamicResource Radius_SM}" Padding="8,3" VerticalAlignment="Top" Height="22"
                                            Visibility="{Binding BadgeText, Converter={x:Static local:NullToCollapsedConverter.Instance}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="0">
                                                        <Setter Property="Background" Value="{StaticResource Brush_SuccessSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush_SuccessBorder}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="1">
                                                        <Setter Property="Background" Value="{StaticResource Brush_WarningSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush_Warning}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                        <Setter Property="Background" Value="{StaticResource Brush_DangerSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="3">
                                                        <Setter Property="ToolTipService.ToolTip"
                                                                Value="温度传感器未检测：0.9.6 起 CPU 温度经 PawnIO 内核驱动读取——请安装 PawnIO（github.com/namazso/PawnIO）并以管理员身份运行；或接受未检测（不影响其它功能）。"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{StaticResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding BadgeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush_TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="0">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush_Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="1">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush_Warning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush_Danger}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NameZh}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                                        <TextBlock Text="{Binding NameEn}" FontSize="{DynamicResource Font_SizeNano}" Style="{StaticResource MonoText}" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Model}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding UsageLabel}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_TextMuted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding UsageText}" FontSize="{DynamicResource Font_SizeMetric}" FontWeight="Bold" FontFamily="{StaticResource Font_Mono}" Foreground="{StaticResource Brush_TextPrimary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <controls:SegBar Grid.Row="3" Height="9" Margin="0,10,0,0" Segments="14"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 TrackBrush="{StaticResource Brush_Track}"
                                                 ActiveBrush="{StaticResource Brush_Success}"
                                                 x:Name="Seg"/>
                            </Grid>
                        </Border>

<DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SegLevel}" Value="1">
                                        <Setter TargetName="Seg" Property="controls:SegBar.ActiveBrush" Value="{StaticResource Brush_SegmentWarn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SegLevel}" Value="2">
                                        <Setter TargetName="Seg" Property="controls:SegBar.ActiveBrush" Value="{StaticResource Brush_Danger}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="详细信息" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="DETAILS" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{StaticResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding DetailCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="{DynamicResource Radius_SM}" Background="{StaticResource Brush_NavySoft}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{StaticResource Brush_TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                                        <!-- Sub 为空时收起：否则空行高度把图标垂直居中位置挤偏（用户两轮反馈） -->
                                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" TextTrimming="CharacterEllipsis" Text="{Binding Sub}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sub}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Sub}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" Style="{StaticResource DetailRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="SemiBold" Foreground="{StaticResource Brush_TextMuted}"/>
                                                <!-- SemiBold 而非 Medium：CJK 回退字体（雅黑）无 Medium 权重，500 会被就近降为 Regular 显细（用户两轮反馈） -->
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Font_SizeBodyLg}" Style="{StaticResource MonoText}" FontWeight="SemiBold" Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="系统信息" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="SYSTEM INFORMATION" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{StaticResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SystemPanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Brush_Track}" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontSize="{DynamicResource Font_SizeBody}" Foreground="{StaticResource Brush_TextMuted}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Font_SizeBody}" Style="{StaticResource MonoText}" Foreground="{StaticResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Value}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{StaticResource Brush_Success}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="已安装软件" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{StaticResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="INSTALLED APPLICATIONS" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{StaticResource MonoText}"/>
            </StackPanel>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font_SizeTiny}"/>
                <TextBlock Grid.Column="1" Text="{Binding AppCountText}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{StaticResource MonoText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{StaticResource CardBorder}" Padding="0">
                <!-- 审查 S-4：ListView 置于页面级 ScrollViewer 内会得到无限测量高度，导致虚拟化失效（数百条即卡顿）。
     给 ListView 一个有界视口让其内部 VirtualizingStackPanel 生效；顶部卡片仍在页面 ScrollViewer 中滚动。 -->
                <ListView x:Name="InstalledAppsList" ItemsSource="{Binding InstalledAppsView}" BorderThickness="0" Background="Transparent" MaxHeight="600" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  SizeChanged="OnAppsListSizeChanged">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="10,9"/>
                            <Setter Property="MinHeight" Value="52"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_TextPrimary}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Row" Background="{TemplateBinding Background}" BorderBrush="{StaticResource Brush_Track}" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}" Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush_SurfaceAlt}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource AppListHeader}">
                            <GridViewColumn Header="名称" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="版本" Width="150" DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="发布商" Width="240" DisplayMemberBinding="{Binding Publisher}"/>
                            <GridViewColumn Header="安装日期" Width="120" DisplayMemberBinding="{Binding InstalledOn}"/>
                            <!-- 末列宽度由 code-behind OnAppsListSizeChanged 动态填充：
                                 GridView 在固定列宽不足视口时会自动补一个空白表头列（实测"标题 6 列内容 5 列"），
                                 让末列吃掉剩余宽度即可消除；MinWidth 防窗口过窄时被压没 -->
                            <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding Size}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
