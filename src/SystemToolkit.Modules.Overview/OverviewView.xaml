<UserControl x:Class="SystemToolkit.Modules.Overview.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:SystemToolkit.UI.Common.Controls;assembly=SystemToolkit.UI.Common"
             xmlns:local="clr-namespace:SystemToolkit.Modules.Overview"
             Background="{DynamicResource Brush_Background}">

    <UserControl.Resources>
        <!-- 🟡 v19 O-3（2026-09-16）：补 `Segoe Fluent Icons` 备选链 —— 此前只有 MDL2，
             而本文件第 119 行的内联写法已带备选（`Segoe Fluent Icons, Segoe MDL2 Assets`），
             说明规范已知、仅资源行漏了；`AppManagerView.xaml:11` 同款写法亦带备选。
             Win11 起 Fluent 字形更全（新增图标只在 Fluent 里有），MDL2 留作降级。 -->
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="SectionHeader" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,22,0,14"/>
        </Style>
        <Style x:Key="AppListHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
            <Setter Property="FontSize" Value="{DynamicResource Font_SizeCaption}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <!-- M-UI-2（2026-09-05）：LIVE 圆点脉动；作用于下方 x:Name="LiveDot" Ellipse；1.5s 慢节奏避视觉躁动 -->
        <Storyboard x:Key="OverviewLivePulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LiveDot" Storyboard.TargetProperty="Opacity" From="0.55" To="1.0" Duration="0:0:0.75"/>
        </Storyboard>
        <!-- M-UI-2（2026-09-05）：详细信息行 hover 浅底（覆盖行内 Grid 的 IsMouseOver） -->
        <Style x:Key="DetailRow" TargetType="Grid">
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24,20,24,28">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="36" Height="36" CornerRadius="{DynamicResource Radius_XL}" Background="{DynamicResource Brush_DarkSurface}">
                    <TextBlock Text="St" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_OnDark}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="本机概览" FontSize="{DynamicResource Font_SizeDisplay}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Margin="0,2,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Style="{DynamicResource LiveBadge}" Height="30" Margin="16,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- LIVE 脉动圆点（IsLive=True 时显示；M-UI-2 加 Storyboard 启动） -->
                        <Ellipse x:Name="LiveDot" Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource Brush_Success}" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource OverviewLivePulse}"/>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <!-- PAUSED 静态圆点（IsLive=False 时显示） -->
                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{DynamicResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
                                    <Setter Property="Text" Value="已暂停"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLive}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                                            <Setter Property="Text" Value="LIVE · 每 2 秒"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Button Grid.Column="3" Style="{DynamicResource PrimaryButton}" Height="30" Content="导出报告"
                        Margin="0,0,8,0" Command="{Binding ExportReportCommand}"/>
                <!-- UI 审计采纳：刷新为辅助操作，降为图标按钮（高度与按钮组对齐）；M2 补接线 -->
                <!-- 🟡 审查 2026-09-10（🟡-18）：ToolTip 随采集态变化——采集中禁用时给出原因，
                     而不是始终显示「立即刷新」让用户以为按钮失灵。（BasedOn 必须 StaticResource） -->
                <Button Grid.Column="4" Height="30" Width="32"
                        Padding="0" Command="{Binding RefreshFullCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                            <Setter Property="ToolTip" Value="立即刷新"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Busy}" Value="True">
                                    <Setter Property="ToolTip" Value="采集中，请稍候…"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="{DynamicResource Font_SizeCaption}"/>
                </Button>
            </Grid>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="实时概览" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="OVERVIEW" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>

            <ItemsControl ItemsSource="{Binding StatCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorderInteractive}" Margin="0,0,12,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="30" Height="30" CornerRadius="{DynamicResource Radius_LG}" Background="{DynamicResource Brush_AccentSoft}">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeBodyLg}" Foreground="{DynamicResource Brush_Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border Grid.Column="2" CornerRadius="{DynamicResource Radius_SM}" Padding="8,3" VerticalAlignment="Top" Height="22"
                                            Visibility="{Binding BadgeText, Converter={x:Static local:NullToCollapsedConverter.Instance}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource Brush_SurfaceAlt}"/>
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="0">
                                                        <Setter Property="Background" Value="{DynamicResource Brush_SuccessSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_SuccessBorder}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="1">
                                                        <Setter Property="Background" Value="{DynamicResource Brush_WarningSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Warning}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                        <Setter Property="Background" Value="{DynamicResource Brush_DangerSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush_Danger}"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BadgeLevel}" Value="3">
                                                        <Setter Property="ToolTipService.ToolTip"
                                                                Value="温度传感器未检测：0.9.6 起 CPU 温度经 PawnIO 内核驱动读取——请安装 PawnIO（github.com/namazso/PawnIO）并以管理员身份运行；或接受未检测（不影响其它功能）。"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" FontFamily="{DynamicResource Font_Mono}" FontWeight="Bold" VerticalAlignment="Center" Text="{Binding BadgeText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush_TextMuted}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="0">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush_Success}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="1">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush_Warning}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BadgeLevel}" Value="2">
                                                            <!-- 2026-09-15 深色主题加固：小号危险文字走语义键（基色深包压卡片底 3.78 < 4.5） -->
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush_DangerText}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding NameZh}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                        <TextBlock Text="{Binding NameEn}" FontSize="{DynamicResource Font_SizeNano}" Style="{DynamicResource MonoText}" Margin="6,0,0,0" VerticalAlignment="Bottom"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Model}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Model}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding UsageLabel}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Bottom"/>
                                    <TextBlock Text="{Binding UsageText}" FontSize="{DynamicResource Font_SizeMetric}" FontWeight="Bold" FontFamily="{DynamicResource Font_Mono}" Foreground="{DynamicResource Brush_TextPrimary}" HorizontalAlignment="Right"/>
                                </Grid>
                                <controls:SegBar Grid.Row="3" Height="9" Margin="0,10,0,0" Segments="14"
                                                 Value="{Binding Percent, Mode=OneWay}"
                                                 TrackBrush="{DynamicResource Brush_Track}"
                                                 ActiveBrush="{DynamicResource Brush_Success}"
                                                 x:Name="Seg"/>
                            </Grid>
                        </Border>

<DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding SegLevel}" Value="1">
                                        <Setter TargetName="Seg" Property="controls:SegBar.ActiveBrush" Value="{DynamicResource Brush_SegmentWarn}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding SegLevel}" Value="2">
                                        <Setter TargetName="Seg" Property="controls:SegBar.ActiveBrush" Value="{DynamicResource Brush_Danger}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="详细信息" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="DETAILS" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding DetailCards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="22" Height="22" CornerRadius="{DynamicResource Radius_SM}" Background="{DynamicResource Brush_NavySoft}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                                        <!-- Sub 为空时收起：否则空行高度把图标垂直居中位置挤偏（用户两轮反馈） -->
                                        <TextBlock FontSize="{DynamicResource Font_SizeMicro}" TextTrimming="CharacterEllipsis" Text="{Binding Sub}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MonoText}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Sub}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Sub}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4" Style="{StaticResource DetailRow}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Key}" FontSize="{DynamicResource Font_SizeBodyLg}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                <!-- SemiBold 而非 Medium：CJK 回退字体（雅黑）无 Medium 权重，500 会被就近降为 Regular 显细（用户两轮反馈） -->
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Font_SizeBodyLg}" Style="{DynamicResource MonoText}" FontWeight="SemiBold" Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Value}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE770;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="系统信息" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="SYSTEM INFORMATION" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding SystemPanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}" Margin="6,0,0,0"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush_Track}" BorderThickness="0,0,0,1" Padding="0,5">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="110"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Key}" FontSize="{DynamicResource Font_SizeBody}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="{DynamicResource Font_SizeBody}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" TextAlignment="Right" ToolTip="{Binding Value}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="实时占用进程" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="TOP PROCESSES" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding TopProcessPanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="18"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="70"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Text="进程" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}"/>
                                    <TextBlock Grid.Column="2" Text="PID" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" TextAlignment="Right"/>
                                    <TextBlock Grid.Column="3" Text="{Binding ValueHeader}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" TextAlignment="Right"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush_Track}" BorderThickness="0,0,0,1" Padding="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="72"/>
                                                        <ColumnDefinition Width="70"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" FontSize="{DynamicResource Font_SizeMicro}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Pid}" FontSize="{DynamicResource Font_SizeMicro}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextMuted}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Value}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextPrimary}" TextAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE968;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="网络与存储健康" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="NETWORK &amp; STORAGE HEALTH" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>
            <ItemsControl ItemsSource="{Binding HealthPanels}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{DynamicResource CardBorder}" Padding="16" Margin="0,0,12,14">
                            <StackPanel>
                                <Grid Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_Accent}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Label}" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}" Margin="6,0,0,0"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Note}" FontSize="{DynamicResource Font_SizeMicro}" Foreground="{DynamicResource Brush_TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource Brush_Track}" BorderThickness="0,0,0,1" Padding="0,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="18"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="150"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Rank}" FontSize="{DynamicResource Font_SizeMicro}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextMuted}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{DynamicResource Font_SizeBody}" Foreground="{DynamicResource Brush_TextPrimary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" Foreground="{DynamicResource Brush_TextMuted}" TextAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Style="{StaticResource SectionHeader}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE71D;" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource Font_SizeTiny}" Foreground="{DynamicResource Brush_SuccessText}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="已安装软件" FontSize="{DynamicResource Font_SizeTitle}" FontWeight="Bold" Foreground="{DynamicResource Brush_TextPrimary}"/>
                </StackPanel>
                <TextBlock Text="INSTALLED APPLICATIONS" FontSize="{DynamicResource Font_SizeMicro}" Margin="17,1,0,0" Style="{DynamicResource MonoText}"/>
            </StackPanel>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBox Height="30" VerticalContentAlignment="Center" Padding="6,0" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" FontSize="{DynamicResource Font_SizeTiny}"
                         Foreground="{DynamicResource Brush_TextPrimary}"/>
                <TextBlock Grid.Column="1" Text="{Binding AppCountText}" FontSize="{DynamicResource Font_SizeBodySm}" Style="{DynamicResource MonoText}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </Grid>

            <Border Style="{DynamicResource CardBorder}" Padding="0">
                <!-- 审查 S-4：ListView 置于页面级 ScrollViewer 内会得到无限测量高度，导致虚拟化失效（数百条即卡顿）。
     给 ListView 一个有界视口让其内部 VirtualizingStackPanel 生效；顶部卡片仍在页面 ScrollViewer 中滚动。 -->
                <Grid>
                    <!-- 🟡 审查 2026-09-10（🟡-17）：搜索过滤无结果时的空态——原先列表变空即一片空白，
                         用户无法区分「机器上没装软件」与「过滤词没匹配到」。
                         用 DataTrigger 判 Count：不需要转换器，也不需要 VM 新增属性。 -->
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="{DynamicResource Font_SizeBodySm}"
                               Foreground="{DynamicResource Brush_TextMuted}">
                        <TextBlock.Style>
                            <!-- 🟠-7④（UI-v2）：原固定文案「没有匹配的软件」在**真·零安装**时同样出现且无下一步。
                                 按 FilterText 分二态。 -->
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="没有匹配的软件 · 清空搜索框可看全部"/>
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilterText}" Value="">
                                        <Setter Property="Text" Value="暂无应用数据"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding InstalledAppsView.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ListView x:Name="InstalledAppsList" ItemsSource="{Binding InstalledAppsView}" BorderThickness="0" Background="Transparent" MaxHeight="600" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  controls:GridViewColumnSizing.AutoFillLastColumn="True">
                    <ListView.ItemContainerStyle>
                        <!-- 🟠 v19 O-1（2026-09-16）：改为 BasedOn 共享样式 —— 此前是**手写拷贝**，
                             与 `AppManagerView` / `LanScanPanel` 的口径不一致，且丢了两个语义：
                               ① **选中态完全丢失**：共享模板有 `IsSelected` 触发器
                                  （`Brush_Selection` 底 + 左缘 3px `SelBar` 指示条，见
                                  `Claude.Light.xaml:834-838`，含 🟠-4 审查的对比度修复），
                                  手写版只复刻了 `IsMouseOver`；因是全量 `ControlTemplate` 替换
                                  （非 `BasedOn`），WPF 默认主题的选中高亮也被一并丢弃
                                  ⇒ **点行无任何视觉反馈**。
                               ② **双内边距**：手写版给 `Border.Padding` 与 `GridViewRowPresenter.Margin`
                                  都绑了 `TemplateBinding Padding`（`10,9` 被加两次 ⇒ 有效 `20,18`）；
                                  共享模板只在后者用一次。
                             ⚠️ 共享样式的 `Padding` 是 `10,10`（原手写版 `10,9`）⇒ 行高 +1px，
                             这是恢复一致性的必要代价（字号/圆角零容忍，行高不在此列）。
                             该样式来自主题包（`Claude.Light.xaml` / `Nvidia.Dark.xaml` 各一份），
                             主题切换时随 `MergedDictionaries[0]` 整体重建 ⇒ `{StaticResource}` 会刷新，无静态失效问题。 -->
                        <Style TargetType="ListViewItem" BasedOn="{StaticResource ListItemRowTallStyle}"/>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView ColumnHeaderContainerStyle="{StaticResource AppListHeader}">
                            <GridViewColumn Header="名称" Width="300" DisplayMemberBinding="{Binding Name}"/>
                            <GridViewColumn Header="版本" Width="150" DisplayMemberBinding="{Binding Version}"/>
                            <GridViewColumn Header="发布商" Width="240" DisplayMemberBinding="{Binding Publisher}"/>
                            <GridViewColumn Header="安装日期" Width="120" DisplayMemberBinding="{Binding InstalledOn}"/>
                            <!-- 末列宽度由本 ListView 上的 controls:GridViewColumnSizing.AutoFillLastColumn 填充
                                 （附加属性挂 SizeChanged，实现见 UI.Common/Controls/GridViewColumnSizing.cs）：
                                 GridView 在固定列宽不足视口时会自动补一个空白表头列（实测"标题 6 列内容 5 列"），
                                 让末列吃掉剩余宽度即可消除；该控件内置最小末列宽，防窗口过窄时被压没。
                                 ⚠️ 2026-09-14（V14-O8）：原注释称"由 code-behind OnAppsListSizeChanged 动态填充"，
                                 那是上一版实现，方法早已不存在（全仓 grep 零命中）。 -->
                            <GridViewColumn Header="大小" Width="100" DisplayMemberBinding="{Binding Size}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
